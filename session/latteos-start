#!/bin/sh
# Spustí grafické prostredie LatteOS z konzoly: opak voľby "Ukončiť do konzoly"
# v prihlasovaní. Zapne graphical.target, teda prihlasovaciu obrazovku.
# Bez greetd (napr. vývoj bez inštalácie) spustí reláciu priamo.
if [ -n "$WAYLAND_DISPLAY" ] || [ -n "$DISPLAY" ]; then
    echo "Grafická relácia už beží." >&2
    exit 1
fi
if systemctl cat greetd.service >/dev/null 2>&1; then
    if systemctl is-active --quiet greetd; then
        echo "Prihlasovacia obrazovka už beží. Vráť sa na ňu príkazom: exit" >&2
        exit 1
    fi
    exec systemctl isolate graphical.target
fi
exec latteos-session "$@"
