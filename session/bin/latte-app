#!/usr/bin/env bash
# latte-app <meno> — spustí aplikáciu LatteOS (Quickshell QML v /usr/share/latteos/apps/<meno>.qml).
#   latte-app subory [priečinok]
# Vo VM (stupeň Softvér/SAFE) kreslí Qt softvérovo bez GL — lacnejšie a bez pádov llvmpipe.
app="${1:?použitie: latte-app <subory|nastavenia>}"; shift
qml="/usr/share/latteos/apps/$app.qml"
[ -f "$qml" ] || { echo "neznáma aplikácia: $app"; exit 1; }
case "${LATTE_TIER:-softver}" in softver|safe|minimalny) export QT_QUICK_BACKEND=software ;; esac
export LATTE_APP_ARGS="$*"
exec qs -n -p "$qml"
