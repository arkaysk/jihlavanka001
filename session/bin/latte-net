#!/usr/bin/python3
"""latte-net — tlačidlo NET (F6): zakázať aplikácii internet, bez práv správcu.

  latte-net status APP_ID          on | off
  latte-net off APP_ID             aplikácia nesmie na internet
  latte-net on APP_ID              aplikácia smie na internet (predvolené)
  latte-net list                   aplikácie s vypnutým NET
  latte-net exec -- PRÍKAZ…        spustí príkaz bez siete (bubblewrap --unshare-net; zostane iba lo)

APP_ID je názov .desktop súboru bez prípony (napr. org.mozilla.firefox, foot).
- Flatpak aplikácia: flatpak override --user --unshare=network (izolácia Flatpaku).
- Natívna aplikácia: v ~/.local/share/applications vznikne prekrytie .desktop súboru, ktorého Exec
  beží cez `latte-net exec --`; každý spúšťač (lišta, Text Bar, App Manager) ho rešpektuje.
  Zapnutie NET prekrytie odstráni. Poznámka: aplikácia spustená inak (z terminálu) sieť má.
"""
import glob, os, re, shutil, subprocess, sys

HOME = os.path.expanduser("~")
USER_APPS = HOME + "/.local/share/applications"
MARK = "X-LatteOS-NET=off"
DIRS = [HOME + "/.local/share/flatpak/exports/share/applications", "/var/lib/flatpak/exports/share/applications", "/usr/share/applications"]


def find_desktop(app):
    for d in DIRS:
        p = os.path.join(d, app + ".desktop")
        if os.path.exists(p):
            return p
    return None


def is_flatpak(app):
    p = find_desktop(app)
    return bool(p and "/flatpak/" in p)


def override_path(app):
    return os.path.join(USER_APPS, app + ".desktop")


def status(app):
    if is_flatpak(app):
        r = subprocess.run(["flatpak", "override", "--user", "--show", app], capture_output=True, text=True)
        return "off" if re.search(r"^shared=.*!network", r.stdout, re.M) else "on"
    p = override_path(app)
    try:
        return "off" if MARK in open(p, encoding="utf-8").read() else "on"
    except OSError:
        return "on"


def set_off(app):
    if is_flatpak(app):
        return subprocess.call(["flatpak", "override", "--user", "--unshare=network", app])
    src = find_desktop(app)
    if not src:
        print("aplikácia sa nenašla: " + app, file=sys.stderr)
        return 1
    out = []
    for line in open(src, encoding="utf-8", errors="replace"):
        m = re.match(r"^(TryExec|Exec)=(.*)$", line.rstrip("\n"))
        if m and m.group(1) == "Exec" and "latte-net exec" not in m.group(2):
            line = "Exec=latte-net exec -- " + m.group(2) + "\n"
        elif m and m.group(1) == "TryExec":
            continue
        out.append(line)
        if line.strip() == "[Desktop Entry]":
            out.append(MARK + "\n")
    os.makedirs(USER_APPS, exist_ok=True)
    with open(override_path(app), "w", encoding="utf-8") as f:
        f.writelines(out)
    subprocess.call(["update-desktop-database", USER_APPS], stderr=subprocess.DEVNULL)
    return 0


def set_on(app):
    if is_flatpak(app):
        return subprocess.call(["flatpak", "override", "--user", "--share=network", app])
    p = override_path(app)
    try:
        if MARK in open(p, encoding="utf-8").read():   # zmazať iba naše prekrytie, nie vlastné súbory používateľa
            os.remove(p)
            subprocess.call(["update-desktop-database", USER_APPS], stderr=subprocess.DEVNULL)
    except OSError:
        pass
    return 0


def main(a):
    if len(a) >= 2 and a[0] == "exec":
        cmd = a[2:] if a[1] == "--" else a[1:]
        if not cmd:
            return 2
        if not shutil.which("bwrap"):
            print("latte-net: chýba bubblewrap, spúšťam so sieťou", file=sys.stderr)
            os.execvp(cmd[0], cmd)
        os.execvp("bwrap", ["bwrap", "--dev-bind", "/", "/", "--unshare-net", "--die-with-parent", "--"] + cmd)
    if len(a) == 2 and a[0] in ("status", "on", "off"):
        if a[0] == "status":
            print(status(a[1]))
            return 0
        return set_off(a[1]) if a[0] == "off" else set_on(a[1])
    if a[:1] == ["list"]:
        for p in sorted(glob.glob(USER_APPS + "/*.desktop")):
            try:
                if MARK in open(p, encoding="utf-8").read():
                    print(os.path.basename(p)[:-8])
            except OSError:
                pass
        return 0
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
