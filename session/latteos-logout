#!/bin/sh
# Ukončí reláciu LatteOS z lišty (systémový manažér, bod 2.5):
#   latteos-logout            odhlásiť: späť na prihlasovaciu obrazovku
#   latteos-logout --console  vypnúť: relácia aj grafika skončia, ostane textová konzola (dev)
#
# Lišta ho spúšťa oddelene (systemd-run --user), lebo skončí spolu s reláciou.
# Poradie je dôležité:
#  1. labwc skončí čisto (labwc --exit) a latteos-session upratá komponenty a premenné.
#     Zabiť reláciu naraz (isolate, terminate-session) by to preskočilo a po labwc
#     by ostal osirelý proces.
#  2. Počká sa na koniec upratovania.
#  3. Ak sa LatteOS spustil v prihlásení, ktoré vlastní greetd (aj ručne z konzoly, ktorú
#     greetd otvoril), skončí sa toto prihlásenie a greetd ukáže prihlasovaciu obrazovku.
#     Konzola z getty alebo ssh sa nechá.
# Premenné LABWC_PID a XDG_SESSION_ID odovzdáva lišta.
console=
[ "$1" = "--console" ] && console=1

[ -n "$LABWC_PID" ] || { echo "latteos-logout: LABWC_PID nie je nastavený" >&2; exit 1; }
labwc --exit || exit 1

alive() { kill -0 "$LABWC_PID" 2>/dev/null; }
tries=0
while [ "$tries" -lt 50 ]; do        # najviac 10 s
    if alive || systemctl --user is-active --quiet latte-session.target; then
        sleep 0.2
        tries=$((tries + 1))
    else
        break
    fi
done

if [ -n "$console" ] && systemctl is-active --quiet greetd; then
    # Bez oprávnenia (pravidlo data/polkit/51-latteos-dev.rules) sa nepýta na heslo,
    # lebo agent relácie už skončil; vtedy nasleduje odhlásenie do prihlasovania.
    if systemctl isolate --no-ask-password multi-user.target; then
        exit 0
    fi
    logger -t latteos-logout -p user.warning \
        "prepnutie do multi-user.target zlyhalo, odhlasujem do prihlasovania"
fi

session=$XDG_SESSION_ID
if [ -n "$session" ] \
    && [ "$(loginctl show-session "$session" -p Service --value 2>/dev/null)" = greetd ] \
    && [ "$(loginctl show-session "$session" -p Name --value 2>/dev/null)" = "$(id -un)" ]; then
    exec loginctl terminate-session "$session"
fi
exit 0
