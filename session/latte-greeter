#!/bin/sh
# Spúšťa prihlasovaciu obrazovku pod greetd (labwc -S latte-greeter). Ak latte-greeter
# spadne, nastúpi gtkgreet, aby sa dalo prihlásiť a chybu opraviť.
# Nainštaluje ho tools/install-greeter.sh do /usr/local/bin.
LIB=${LATTEOS_LIB:-/usr/local/lib/latteos}
python3 "$LIB/latte_greeter/app.py" "$@"
status=$?
[ "$status" -eq 0 ] && exit 0
logger -t latte-greeter -p user.err "latte-greeter skončil s kódom $status, spúšťam gtkgreet"
exec gtkgreet -l
