#!/bin/sh
# Odovzdá prostredie systemd a spustí reláciu. Komponenty (latte-shell, ...)
# bežia ako user služby pod latte-session.target; ak spadnú, systemd ich
# reštartuje. Zoznam premenných musí sedieť s session/latteos-session.
VARS="WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE XDG_SESSION_ID LABWC_PID GSK_RENDERER XCURSOR_THEME XCURSOR_SIZE"
systemctl --user import-environment $VARS
dbus-update-activation-environment --systemd $VARS
systemctl --user start --no-block latte-session.target

# Polkit agent (dialóg pre heslo správcu) NErobí user služba: polkit vyžaduje, aby agent
# bežal v tej istej relácii, pre ktorú sa registruje, a služba pod user@ v nej nie je
# ("Passed session and the session the caller is in differs"). Preto ho spúšťa labwc
# ako svoje dieťa; tools/run-polkit.sh ho po páde reštartuje.
if command -v latte-polkit >/dev/null 2>&1; then
    if command -v systemd-cat >/dev/null 2>&1; then
        systemd-cat -t latte-polkit latte-polkit &
    else
        latte-polkit &
    fi
fi

# Uložené nastavenie monitorov (Nastavenia › Obrazovky): labwc si rozlíšenie, mierku a otočenie sám
# nepamätá, preto ich pri každom prihlásení použijeme znova. Bez uloženého súboru sa nestane nič.
if command -v latte-devices >/dev/null 2>&1; then
    latte-devices display apply &
fi
