#!/bin/sh
# Odovzdá prostredie systemd a spustí reláciu. Komponenty (latte-shell, ...)
# bežia ako user služby pod latte-session.target; ak spadnú, systemd ich
# reštartuje. Zoznam premenných musí sedieť s session/latteos-session.
VARS="WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE XDG_SESSION_ID LABWC_PID GSK_RENDERER XCURSOR_THEME XCURSOR_SIZE"
systemctl --user import-environment $VARS
dbus-update-activation-environment --systemd $VARS
systemctl --user start --no-block latte-session.target
