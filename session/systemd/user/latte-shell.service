[Unit]
Description=LatteOS shell (lišta a popupy)
PartOf=latte-session.target
After=latte-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/latte-shell
Restart=on-failure
RestartSec=1
Slice=session.slice
# Lišta spúšťa aplikácie ako svoje deti. Bez tohto by ich systemd pri
# reštarte lišty zabil spolu s ňou.
KillMode=process
