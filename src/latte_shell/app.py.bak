#!/usr/bin/env python3
"""latte-shell: lišta LatteOS. Minimálna verzia."""
import os
import subprocess
import sys
from datetime import datetime

sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
from gi.repository import Gtk, Gio, GLib  # noqa: E402
from gi.repository import Gtk4LayerShell as LayerShell  # noqa: E402

BAR_HEIGHT = 104
CORNER = 104

CSS = """
window.latte-bar { background: transparent; }
.segment {
    background: rgba(20,16,13,0.78);
    border: 1px solid rgba(242,234,224,0.14);
    border-radius: 12px;
    color: #F2EAE0;
}
.corner {
    background: #0B120C;
    border: 1px solid rgba(242,234,224,0.18);
    border-radius: 14px;
    color: #E9F5EC;
}
.corner.right { background: #1B1612; color: #F2EAE0; }
.corner-label { font-family: monospace; font-size: 10px; }
.clock { font-size: 26px; }
.dim { color: #CDBFAF; font-size: 12px; }
button.tile { padding: 0; }
"""

FILES_APP = os.path.join(os.path.dirname(__file__), "..", "latte_files", "app.py")


class Bar(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app)
        self.set_decorated(False)
        self.add_css_class("latte-bar")

        LayerShell.init_for_window(self)
        LayerShell.set_layer(self, LayerShell.Layer.TOP)
        LayerShell.set_anchor(self, LayerShell.Edge.BOTTOM, True)
        LayerShell.set_anchor(self, LayerShell.Edge.LEFT, True)
        LayerShell.set_anchor(self, LayerShell.Edge.RIGHT, True)
        LayerShell.set_exclusive_zone(self, BAR_HEIGHT)
        LayerShell.set_namespace(self, "latte-shell")

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        row.set_margin_start(12)
        row.set_margin_end(12)
        row.set_margin_bottom(10)
        row.set_margin_top(8)
        self.set_child(row)

        row.append(self.corner_tile("APP MANAGER", self.on_apps, right=False))
        row.append(self.time_segment())
        row.append(self.system_segment())

        self.tasks = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        self.tasks.add_css_class("segment")
        self.tasks.set_hexpand(True)
        self.tasks.set_size_request(-1, 64)
        self.tasks.set_valign(Gtk.Align.CENTER)
        row.append(self.tasks)

        row.append(self.files_segment())
        row.append(self.corner_tile("ZDROJE", self.on_resources, right=True))

        GLib.timeout_add_seconds(10, self.tick)

    # ---------- segmenty ----------
    def corner_tile(self, label, action, right):
        btn = Gtk.Button()
        btn.add_css_class("corner")
        btn.add_css_class("tile")
        if right:
            btn.add_css_class("right")
        btn.set_size_request(CORNER, 96)
        btn.set_valign(Gtk.Align.END)

        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        inner.set_valign(Gtk.Align.CENTER)
        icon = Gtk.Image.new_from_icon_name(
            "view-grid-symbolic" if not right else "drive-harddisk-symbolic"
        )
        icon.set_pixel_size(32)
        text = Gtk.Label(label=label)
        text.add_css_class("corner-label")
        inner.append(icon)
        inner.append(text)
        btn.set_child(inner)
        btn.connect("clicked", action)
        return btn

    def time_segment(self):
        btn = Gtk.Button()
        btn.add_css_class("segment")
        btn.set_size_request(200, 64)
        btn.set_valign(Gtk.Align.CENTER)

        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        box.set_halign(Gtk.Align.CENTER)
        self.clock = Gtk.Label()
        self.clock.add_css_class("clock")
        self.date = Gtk.Label()
        self.date.add_css_class("dim")
        box.append(self.clock)
        box.append(self.date)
        btn.set_child(box)
        btn.connect("clicked", lambda _b: None)
        self.tick()
        return btn

    def system_segment(self):
        btn = Gtk.Button()
        btn.add_css_class("segment")
        btn.set_size_request(64, 64)
        btn.set_valign(Gtk.Align.CENTER)
        icon = Gtk.Image.new_from_icon_name("system-shutdown-symbolic")
        icon.set_pixel_size(24)
        btn.set_child(icon)
        btn.connect("clicked", self.on_system)
        return btn

    def files_segment(self):
        btn = Gtk.Button()
        btn.add_css_class("segment")
        btn.set_size_request(64, 64)
        btn.set_valign(Gtk.Align.CENTER)
        icon = Gtk.Image.new_from_icon_name("folder-symbolic")
        icon.set_pixel_size(24)
        btn.set_child(icon)
        btn.connect("clicked", lambda _b: self.launch_files())
        return btn

    # ---------- akcie ----------
    def tick(self, *_a):
        now = datetime.now()
        self.clock.set_text(now.strftime("%H:%M"))
        self.date.set_text(now.strftime("%-d. %-m. %Y"))
        return True

    def launch_files(self):
        subprocess.Popen([sys.executable, os.path.abspath(FILES_APP)])

    def on_resources(self, _btn):
        self.launch_files()

    def on_apps(self, _btn):
        self.popup_apps()

    def on_system(self, _btn):
        self.popup_system()

    # ---------- popupy ----------
    def popup_window(self, title, width, height):
        win = Gtk.Window(transient_for=self, title=title)
        win.set_default_size(width, height)
        return win

    def popup_apps(self):
        win = self.popup_window("Mapa aplikácií", 560, 520)
        scroll = Gtk.ScrolledWindow()
        flow = Gtk.FlowBox(max_children_per_line=4, selection_mode=Gtk.SelectionMode.NONE)
        flow.set_margin_top(12)
        flow.set_margin_bottom(12)
        flow.set_margin_start(12)
        flow.set_margin_end(12)

        for info in sorted(
            Gio.AppInfo.get_all(), key=lambda a: (a.get_display_name() or "").lower()
        ):
            if not info.should_show():
                continue
            btn = Gtk.Button()
            btn.add_css_class("flat")
            inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            inner.set_size_request(120, 96)
            icon = Gtk.Image.new_from_gicon(info.get_icon()) if info.get_icon() else Gtk.Image()
            icon.set_pixel_size(40)
            label = Gtk.Label(label=info.get_display_name() or "")
            label.set_wrap(True)
            label.set_max_width_chars(14)
            inner.append(icon)
            inner.append(label)
            btn.set_child(inner)
            btn.connect("clicked", self.launch_app, info, win)
            flow.append(btn)

        scroll.set_child(flow)
        win.set_child(scroll)
        win.present()

    def launch_app(self, _btn, info, win):
        try:
            info.launch([], None)
        except GLib.Error:
            pass
        win.destroy()

    def popup_system(self):
        win = self.popup_window("Systémový manažér", 300, -1)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.set_margin_top(14)
        box.set_margin_bottom(14)
        box.set_margin_start(14)
        box.set_margin_end(14)

        for label, cmd in [
            ("Terminál", ["foot"]),
            ("Súbory", None),
            ("Odhlásiť", ["labwc", "--exit"]),
        ]:
            btn = Gtk.Button(label=label)
            btn.set_size_request(-1, 44)
            btn.connect("clicked", self.run_item, cmd, win)
            box.append(btn)

        win.set_child(box)
        win.present()

    def run_item(self, _btn, cmd, win):
        if cmd is None:
            self.launch_files()
        else:
            try:
                subprocess.Popen(cmd)
            except OSError:
                pass
        win.destroy()


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.latteos.Shell")

    def do_activate(self):
        provider = Gtk.CssProvider()
        provider.load_from_string(CSS)
        bar = Bar(self)
        Gtk.StyleContext.add_provider_for_display(
            bar.get_display(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )
        bar.present()


if __name__ == "__main__":
    App().run(sys.argv)