#!/usr/bin/python3 -sE
"""latte-files-admin: súborové operácie ako správca (bod 1.10).

Spúšťa ho správca súborov cez `pkexec` po overení totožnosti v polkite. Beží ako
root, preto sa NESMIE spúšťať z repozitára: tools/install-admin.sh ho nainštaluje
(spolu s fileops.py) do /usr/libexec/latteos/, kam bežný používateľ nezapisuje.

Použitie (cesty musia byť absolútne):
    list PATH
    mkdir PARENT NAME
    rename SRC NEWNAME
    delete PATH...
    transfer copy|move DEST SRC... [--policy keep_both|replace|skip]

Výstup: riadky JSON na stdout. {"progress": [...]} počas prenosu a na konci vždy
{"result": {...}}. Prenos sa dá zrušiť riadkom "cancel" na stdin.
"""
import json
import os
import sys
import threading

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
try:
    import fileops
except ImportError:                     # vývoj bez inštalácie (len ako bežný používateľ)
    sys.path.insert(0, os.path.join(HERE, "..", "latte_common"))
    import fileops


def emit(obj):
    sys.stdout.write(json.dumps(obj, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def fail(err, path=""):
    emit({"result": {
        "state": "error",
        "error": [getattr(err, "filename", None) or path, err.errno or 5, err.strerror or str(err)],
    }})


def check_path(path):
    normalized = path == "/" or os.path.normpath(path) == path.rstrip("/")
    if not os.path.isabs(path) or "\0" in path or not normalized:
        sys.exit("cesta musí byť absolútna a normalizovaná: %r" % path)
    return path


def check_name(name):
    if not name or "/" in name or name in (".", "..") or "\0" in name:
        sys.exit("neplatné meno: %r" % name)
    return name


def owner_of(directory):
    st = os.stat(directory)
    return st.st_uid, st.st_gid


def cmd_list(path):
    entries = []
    try:
        with os.scandir(path) as it:
            for entry in it:
                try:
                    is_dir = entry.is_dir()
                    st = entry.stat()
                    entries.append({
                        "name": entry.name,
                        "is_dir": is_dir,
                        "size": 0 if is_dir else st.st_size,
                        "mtime": int(st.st_mtime),
                    })
                except OSError:
                    entries.append({"name": entry.name, "is_dir": False, "size": 0, "mtime": 0})
    except OSError as err:
        return fail(err, path)
    emit({"result": {"state": "done", "entries": entries}})


def cmd_mkdir(parent, name):
    target = os.path.join(parent, check_name(name))
    try:
        os.mkdir(target)
        uid, gid = owner_of(parent)
        os.chown(target, uid, gid)
    except OSError as err:
        return fail(err, target)
    emit({"result": {"state": "done"}})


def cmd_rename(src, newname):
    dst = os.path.join(os.path.dirname(src), check_name(newname))
    try:
        if os.path.lexists(dst):
            raise FileExistsError(17, "Položka s týmto menom už existuje", dst)
        os.rename(src, dst)
    except OSError as err:
        return fail(err, src)
    emit({"result": {"state": "done"}})


def cmd_delete(paths):
    done = []
    for path in paths:
        if os.path.realpath(path) == "/":
            sys.exit("koreň sa nemaže")
        try:
            fileops.remove_tree(path)
        except OSError as err:
            emit({"result": {
                "state": "error", "done": done,
                "error": [err.filename or path, err.errno or 5, err.strerror or str(err)],
            }})
            return
        done.append(path)
    emit({"result": {"state": "done", "done": done}})


def cmd_transfer(kind, dest, sources, policy):
    job = fileops.Transfer(kind, sources, dest, policy=policy, owner=None)
    try:
        job.owner = owner_of(dest)
    except OSError as err:
        return fail(err, dest)

    def watch_stdin():
        for line in sys.stdin:
            if line.strip() == "cancel":
                break
        job.cancel()                    # aj EOF: rodič zanikol, nepokračovať

    threading.Thread(target=watch_stdin, daemon=True).start()
    result = job.run(lambda p: emit({"progress": list(p)}))
    emit({"result": {
        "state": result.state,
        "done": result.done,
        "error": list(result.error) if result.error else None,
    }})


def main(argv):
    if len(argv) < 2:
        sys.exit(__doc__)
    op, args = argv[1], argv[2:]
    if op == "list" and len(args) == 1:
        cmd_list(check_path(args[0]))
    elif op == "mkdir" and len(args) == 2:
        cmd_mkdir(check_path(args[0]), args[1])
    elif op == "rename" and len(args) == 2:
        cmd_rename(check_path(args[0]), args[1])
    elif op == "delete" and args:
        cmd_delete([check_path(p) for p in args])
    elif op == "transfer" and len(args) >= 3 and args[0] in ("copy", "move"):
        policy = fileops.KEEP_BOTH
        rest = args[1:]
        if "--policy" in rest:
            i = rest.index("--policy")
            policy = rest[i + 1] if i + 1 < len(rest) else ""
            rest = rest[:i] + rest[i + 2:]
            if policy not in (fileops.KEEP_BOTH, fileops.REPLACE, fileops.SKIP):
                sys.exit("neznáma politika: %r" % policy)
        if len(rest) < 2:
            sys.exit(__doc__)
        cmd_transfer(args[0], check_path(rest[0]), [check_path(p) for p in rest[1:]], policy)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv)
