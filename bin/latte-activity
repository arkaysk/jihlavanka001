#!/usr/bin/env python3
"""latte-activity: how LatteOS has been developed, from the repository's own history, for the Settings' "About this
computer": a square graph of the days (as GitHub draws a profile's) and the latest commits, each readable in full.

  latte-activity write FILE   the history of the repository this is run in, as JSON, into FILE (./install does it,
                              into build/activity.json, which is installed as /usr/share/latteos/activity.json)
  latte-activity fetch        the same from GitHub, fresh (the repository is public: REPO), into the user's cache
                              (~/.cache/latteos/activity.json); asked at most every few hours; without the network
                              the installed file stays what is shown
  latte-activity files HASH   the files of one commit, from GitHub: [{"path", "added", "removed"}]
  latte-activity show [FILE]  what a file says, else the fresher of the cache and the installed one: {"written", "days": {"YYYY-MM-DD": n}, "total",
                              "commits": [{"hash", "at", "author", "subject", "body", "files": [{"path", "added",
                              "removed"}], "more"}]}

The days are the last 53 weeks; the commits the latest 30, with up to 40 files each. A message is what its author wrote:
publishing a release publishes these lines, so it is the release script's to decide whether it ships the file.
"""
import datetime
import json
import os
import subprocess
import sys

SHIPPED = os.path.join(os.environ.get("LATTE_SHARE") or "/usr/share/latteos", "activity.json")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "latteos", "activity.json")
REPO = "arkaysk/jihlavanka001"
API = "https://api.github.com/repos/" + REPO
FRESH = 6 * 3600                       # GitHub lets 60 questions an hour without an account: a few, a few times a day


def api(path):
    import urllib.request
    req = urllib.request.Request(API + path, headers={"Accept": "application/vnd.github+json", "User-Agent": "latte-activity"})
    with urllib.request.urlopen(req, timeout=20) as r:
        return r.status, json.load(r)


def from_github():
    """The days from the dates of the commits of the last year (GitHub's own statistics are often still being counted),
    and the latest commits; their files are asked for one at a time, when one is opened (`files`)."""
    since = (datetime.date.today() - datetime.timedelta(weeks=WEEKS)).isoformat() + "T00:00:00Z"
    days, latest = {}, []
    for page in range(1, 11):
        _, found = api("/commits?per_page=100&since=%s&page=%d" % (since, page))
        for c in found:
            when = c["commit"]["author"]["date"]
            local = datetime.datetime.fromisoformat(when.replace("Z", "+00:00")).astimezone().date().isoformat()
            days[local] = days.get(local, 0) + 1
            if len(latest) < COMMITS:
                msg = c["commit"]["message"].split("\n", 1)
                latest.append({"hash": c["sha"][:7], "at": when, "author": c["commit"]["author"]["name"], "subject": msg[0],
                               "body": msg[1].strip() if len(msg) > 1 else "", "files": None, "more": 0})
        if len(found) < 100:
            break
    _, repo = api("")
    return {"written": datetime.datetime.now().isoformat(timespec="seconds"), "from": "github", "branch": repo.get("default_branch", ""),
            "days": days, "total": sum(days.values()), "commits": latest}
COMMITS, FILES, WEEKS = 30, 40, 53


def git(*args):
    return subprocess.run(["git"] + list(args), capture_output=True, text=True, check=True).stdout


def history():
    since = (datetime.date.today() - datetime.timedelta(weeks=WEEKS)).isoformat()
    days = {}
    for line in git("log", "--since=" + since, "--format=%ad", "--date=short").splitlines():
        days[line] = days.get(line, 0) + 1
    out = []
    # a record separator and a unit separator: a message may hold any text, but not these
    for rec in git("log", "-n", str(COMMITS), "--format=%h%x1f%aI%x1f%an%x1f%s%x1f%b%x1e").split("\x1e"):
        if not rec.strip():
            continue
        h, at, author, subject, body = (rec.strip("\n").split("\x1f") + [""] * 5)[:5]
        files = []
        for l in git("show", "--numstat", "--format=", h).splitlines():
            p = l.split("\t")
            if len(p) == 3:
                files.append({"path": p[2], "added": int(p[0]) if p[0].isdigit() else 0, "removed": int(p[1]) if p[1].isdigit() else 0})
        out.append({"hash": h, "at": at, "author": author, "subject": subject, "body": body.strip(),
                    "files": files[:FILES], "more": max(0, len(files) - FILES)})
    return {"written": datetime.datetime.now().isoformat(timespec="seconds"), "days": days,
            "total": int(git("rev-list", "--count", "HEAD").strip()), "commits": out}


def main(a):
    if len(a) == 2 and a[0] == "write":
        try:
            data = history()
        except (OSError, subprocess.CalledProcessError) as e:
            print("latte-activity: no history here (%s)" % e, file=sys.stderr)
            return 1
        os.makedirs(os.path.dirname(os.path.abspath(a[1])), exist_ok=True)
        with open(a[1], "w") as f:
            json.dump(data, f, ensure_ascii=False)
        print("latte-activity: %d commits, %d days" % (len(data["commits"]), len(data["days"])))
        return 0
    if a == ["fetch"]:
        try:
            if os.path.exists(CACHE) and datetime.datetime.now().timestamp() - os.path.getmtime(CACHE) < FRESH:
                return 0
            data = from_github()
        except (OSError, ValueError, KeyError) as e:
            print("latte-activity: GitHub did not answer (%s)" % e, file=sys.stderr)
            return 1
        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
        with open(CACHE + ".tmp", "w") as f:
            json.dump(data, f, ensure_ascii=False)
        os.replace(CACHE + ".tmp", CACHE)
        return 0
    if len(a) == 2 and a[0] == "files":
        try:
            _, c = api("/commits/" + a[1])
            print(json.dumps([{"path": f["filename"], "added": f.get("additions", 0), "removed": f.get("deletions", 0)} for f in c.get("files", [])][:FILES]))
        except (OSError, ValueError):
            print("[]")
        return 0
    if a[:1] == ["show"]:
        if len(a) > 1:
            paths = [a[1]]
        else:   # the fresher of the two: what GitHub said, or what the install wrote
            paths = sorted([p for p in (CACHE, SHIPPED) if os.path.exists(p)], key=os.path.getmtime, reverse=True)
        for path in paths:
            try:
                with open(path) as f:
                    print(f.read())
                return 0
            except OSError:
                pass
        print("{}")
        return 0
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
