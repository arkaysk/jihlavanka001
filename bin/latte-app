#!/bin/sh
# latte-app NAME [WORD…]: opens one of LatteOS's own apps, a window drawn by Quickshell from apps/NAME.qml.
#   latte-app appmanager [updates | mine | app ID]
# The words after the name say where in the app to begin; the app reads them from LATTE_APP_ARGS, one a line.
share="${LATTE_SHARE:-/usr/share/latteos}"
app="${1:?latte-app NAME [WORD…]}"; shift
[ -f "$share/apps/$app.qml" ] || { echo "latte-app: no such app: $app" >&2; exit 1; }
# with no graphics card Qt draws by itself: cheaper than a card made of software
case "${LATTE_TIER:-}" in software|minimal) export QT_QUICK_BACKEND=software ;; esac
# choosing a file is the desktop's own window for it (the portal), the same one every other app opens
export QT_QPA_PLATFORMTHEME="${QT_QPA_PLATFORMTHEME:-xdgdesktopportal}"
# the icons of files and apps come from one set, whatever the session's own theme happens to be
[ -n "${QS_ICON_THEME:-}" ] || { [ -d /usr/share/icons/breeze ] && export QS_ICON_THEME=breeze || export QS_ICON_THEME=Adwaita; }
LATTE_APP_ARGS="$(printf '%s\n' "$@")" exec qs -n -p "$share/apps/$app.qml"
