#!/usr/bin/env python3
"""latte-monitor: what runs on this computer and what starts by itself, for the Monitor.

  latte-monitor watch [SECONDS]      a JSON line now and one every SECONDS (default 2), until killed:
                                     {"cores": [percent…], "swap", "swap_total", "net": {"down", "up"}, "disk": {"read",
                                     "write"} (bytes a second), "apps": […], "background": […]}
                                     apps are the programs that have a window, background the rest; each is
                                     {"name", "pids": […], "cpu": percent of the whole processor, "mem": bytes, "user"}
  latte-monitor startup              what starts by itself, and why: [{"id", "kind", "name", "what", "where", "origin",
                                     "on", "running", "mine", "took"}]   kind: "app" (starts when the user logs in),
                                     "user" (a service of the user's), "system" (a service of the system's);
                                     mine: it can be switched here, with no password, and back again;
                                     took: milliseconds it added to the last start, where the system says
  latte-monitor startup-set ID on|off    switches one of the user's own (kind "app" or "user")
  latte-monitor sensors              [{"chip", "name", "value", "unit"}]: temperatures, fans, voltages, power
                                     each reading also has a stable "id" and a "source"
  latte-monitor hardware             {"schema": 1, "groups": [{"id", "name", "items": [… ]}, …]}:
                                     readable CPU, memory, board/BIOS and graphics inventory
  latte-monitor watch [SECONDS]      versioned JSONL: {"schema": 1, "timestamp": epoch milliseconds,
                                     "sensors": [{"id", "source", "name", "chip", "value", "unit"}, …], …}
                                     for local dashboards and external displays
  latte-monitor end PID…             asks those processes to end (TERM)
  latte-monitor kill PID…            ends them at once (KILL)

The processor, the memory and the graphics card as a whole are latte-stats's to tell. Everything is read from
/proc, /sys and systemd as the user; only the user's own things can be changed here.
"""
import configparser
import glob
import json
import os
import pwd
import re
import shutil
import signal
import subprocess
import sys
import time

TICK = os.sysconf("SC_CLK_TCK")
PAGE = os.sysconf("SC_PAGE_SIZE")
HOME = os.path.expanduser("~")
AUTOSTART = [os.path.join(os.environ.get("XDG_CONFIG_HOME") or HOME + "/.config", "autostart"), "/etc/xdg/autostart"]


def read(path, default=""):
    try:
        with open(path, errors="replace") as f:
            return f.read()
    except OSError:
        return default


def out(*argv, timeout=15):
    try:
        return subprocess.run(argv, capture_output=True, text=True, timeout=timeout).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def guard():
    """GuardDog's reading of who owns a process (bin/latte-guarddog), or None where it is not there."""
    try:
        import importlib.machinery, importlib.util
        sys.dont_write_bytecode = True                   # a command is not a module: no __pycache__ beside it
        path = shutil.which("latte-guarddog") or os.path.join(os.path.dirname(os.path.abspath(__file__)), "latte-guarddog")
        loader = importlib.machinery.SourceFileLoader("latte_guarddog", path)
        module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
        loader.exec_module(module)
        return module
    except (OSError, ImportError, SyntaxError):
        return None


# ── what runs ────────────────────────────────────────────────────────────────────────────────────────────────
def processes():
    """{pid: (name, parent, ticks of processor used, bytes of memory, uid)}"""
    found = {}
    for path in glob.glob("/proc/[0-9]*"):
        stat = read(path + "/stat")
        if not stat:
            continue
        name = stat[stat.find("(") + 1:stat.rfind(")")]
        rest = stat[stat.rfind(")") + 2:].split()
        try:
            found[int(path[6:])] = (name, int(rest[1]), int(rest[11]) + int(rest[12]), int(rest[21]) * PAGE, os.stat(path).st_uid)
        except (IndexError, ValueError, OSError):
            pass
    return found


def cores(text):
    return [(sum(v), v[3] + v[4]) for v in ([int(x) for x in line.split()[1:9]] for line in text.splitlines() if re.match(r"cpu\d", line))]


def traffic():
    down = up = 0
    for line in read("/proc/net/dev").splitlines()[2:]:
        name, _, rest = line.partition(":")
        if name.strip() != "lo" and rest:
            v = rest.split()
            down, up = down + int(v[0]), up + int(v[8])
    done = read("/proc/diskstats").splitlines()
    sectors = [(int(v[5]), int(v[9])) for v in (l.split() for l in done) if len(v) > 9 and re.fullmatch(r"sd[a-z]+|nvme\d+n\d+|vd[a-z]+|mmcblk\d+", v[2])]
    return down, up, sum(s[0] for s in sectors) * 512, sum(s[1] for s in sectors) * 512


def windows():
    """The pids of the programs that have a window, as the compositor lists them."""
    try:
        return {c.get("pid") for c in json.loads(out("hyprctl", "-j", "clients", timeout=3) or "[]")}
    except ValueError:
        return set()


def grouped(now, before, elapsed, ncpu, shown):
    """Processes as programs: one line for a program and everything it started that bears no window of its own."""
    kids = {}
    for pid, p in now.items():
        kids.setdefault(p[1], []).append(pid)
    apps, used = [], set()

    def family(pid, into):
        into.append(pid)
        used.add(pid)
        for k in kids.get(pid, []):
            if k not in shown and k not in used:
                family(k, into)

    def line(name, pids):
        cpu = sum(max(0, now[p][2] - before[p][2]) for p in pids if p in before) / TICK / max(elapsed, 0.01) / ncpu * 100
        try:
            user = pwd.getpwuid(now[pids[0]][4]).pw_name
        except KeyError:
            user = str(now[pids[0]][4])
        return {"name": name, "pids": pids, "cpu": round(cpu, 1), "mem": sum(now[p][3] for p in pids), "user": user,
                "owner": dog.owner(pids[0]) if dog else "user"}

    for pid in sorted(shown & set(now)):
        pids = []
        family(pid, pids)
        apps.append(line(now[pid][0], pids))
    rest = {}
    for pid, p in now.items():
        if pid not in used and p[3] > 0:                # kernel threads have no memory of their own: not shown
            rest.setdefault((p[0], p[4]), []).append(pid)
    background = [line(name, pids) for (name, _), pids in rest.items()]
    order = lambda l: sorted(l, key=lambda a: (-a["cpu"], -a["mem"]))
    return order(apps), order(background)[:120]


dog = guard()


def watch(seconds):
    ncpu = os.cpu_count() or 1
    before, cpu0, io0, t0 = processes(), cores(read("/proc/stat")), traffic(), time.monotonic()
    time.sleep(0.5)
    while True:
        now, cpu1, io1, t1 = processes(), cores(read("/proc/stat")), traffic(), time.monotonic()
        dt = t1 - t0
        mem = dict(re.findall(r"(\w+):\s+(\d+)", read("/proc/meminfo")))
        apps, background = grouped(now, before, dt, ncpu, windows())
        print(json.dumps({
            "schema": 1,
            "timestamp": time.time_ns() // 1_000_000,
            "cores": [round(100 * (1 - (b[1] - a[1]) / max(1, b[0] - a[0]))) for a, b in zip(cpu0, cpu1)],
            "swap": (int(mem.get("SwapTotal", 0)) - int(mem.get("SwapFree", 0))) * 1024, "swap_total": int(mem.get("SwapTotal", 0)) * 1024,
            "net": {"down": round((io1[0] - io0[0]) / dt), "up": round((io1[1] - io0[1]) / dt)},
            "disk": {"read": round((io1[2] - io0[2]) / dt), "write": round((io1[3] - io0[3]) / dt)},
            "apps": apps, "background": background, "guard": dog.status() if dog else [],
            "sensors": sensors()}), flush=True)
        before, cpu0, io0, t0 = now, cpu1, io1, t1
        time.sleep(seconds)


# ── what starts by itself ────────────────────────────────────────────────────────────────────────────────────
def desktop(path):
    p = configparser.RawConfigParser(strict=False, interpolation=None)
    p.optionxform = str
    try:
        p.read(path, encoding="utf-8")
        return p["Desktop Entry"]
    except (KeyError, configparser.Error, UnicodeDecodeError, OSError):
        return None


def origin(path):
    if path.startswith(HOME): return "yours"
    if "/latteos" in path or "latte-" in os.path.basename(path): return "LatteOS"
    if "/flatpak/" in path: return "Flatpak"
    return "system"


def units(scope):
    """The services of the system or of the user that are set to start by themselves, with what systemd says of them."""
    ctl = ["systemctl"] + (["--user"] if scope == "user" else [])
    names = [l.split()[0] for l in out(*ctl, "list-unit-files", "--state=enabled", "--type=service,timer,socket", "--no-legend", "--plain").splitlines() if l.split()]
    if not names:
        return []
    took = {}
    for l in out("systemd-analyze", *(["--user"] if scope == "user" else []), "blame", "--no-pager").splitlines():
        m = re.match(r"\s*((?:[\d.]+(?:min|ms|s)\s*)+)\s+(\S+)$", l)
        if m:
            ms = sum(float(v) * {"min": 60000, "s": 1000, "ms": 1}[u] for v, u in re.findall(r"([\d.]+)(min|ms|s)", m.group(1)))
            took[m.group(2)] = round(ms)
    found = []
    for block in out(*ctl, "show", "-p", "Id,Description,FragmentPath,ActiveState", *names).strip().split("\n\n"):
        f = dict(l.split("=", 1) for l in block.splitlines() if "=" in l)
        if f.get("Id"):
            path = f.get("FragmentPath", "")
            found.append({"id": scope + ":" + f["Id"], "kind": scope, "name": f["Id"], "what": f.get("Description", ""), "where": path,
                          "origin": origin(path), "on": True, "running": f.get("ActiveState") == "active",
                          # the user's own to switch are those the user put there: the desktop needs the ones the system brings
                          "mine": scope == "user" and path.startswith(HOME),
                          "took": took.get(f["Id"], 0)})
    return found


def startup():
    found, seen = [], set()
    for folder in AUTOSTART:
        for path in sorted(glob.glob(folder + "/*.desktop")):
            name = os.path.basename(path)
            if name in seen:
                continue
            seen.add(name)
            e = desktop(path)
            if e is None or (e.get("OnlyShowIn") and "Hyprland" not in e.get("OnlyShowIn", "")):
                continue
            # the program itself is the system's when the user's file only switches a system one off
            base = next((p for p in (f + "/" + name for f in AUTOSTART[1:]) if os.path.exists(p)), path)
            found.append({"id": "app:" + name, "kind": "app", "name": e.get("Name", name[:-8]), "what": e.get("Comment", "") or e.get("Exec", ""),
                          "where": base, "origin": origin(base), "on": e.get("Hidden", "").lower() != "true", "running": False, "mine": True, "took": 0})
    # the user's services that are switched off are listed too, where they are the user's own to switch back on
    return found + units("user") + units("system")


def startup_set(ident, on):
    kind, _, name = ident.partition(":")
    if kind == "user" and re.fullmatch(r"[\w@.:-]+", name):
        return subprocess.run(["systemctl", "--user", "enable" if on else "disable", name]).returncode
    if kind != "app" or "/" in name or not name.endswith(".desktop"):
        return 2
    mine = os.path.join(AUTOSTART[0], name)
    theirs = next((p for p in (f + "/" + name for f in AUTOSTART[1:]) if os.path.exists(p)), None)
    if on:
        e = read(mine)
        if theirs and re.sub(r"(?m)^Hidden=.*\n?", "", e).strip() == read(theirs).strip():
            os.remove(mine)                             # it only switched the system's one off: without it that one starts again
        elif e:
            with open(mine, "w") as f:
                f.write(re.sub(r"(?m)^Hidden=.*\n?", "", e))
    else:
        text = read(mine) or read(theirs or "")
        if not text:
            return 2
        os.makedirs(AUTOSTART[0], exist_ok=True)
        text = re.sub(r"(?m)^Hidden=.*\n?", "", text)
        with open(mine, "w") as f:
            f.write(text.rstrip("\n") + "\nHidden=true\n")
    return 0


# ── what the sensors say ─────────────────────────────────────────────────────────────────────────────────────
def sensors(root="/sys/class/hwmon"):
    kinds = {"temp": ("°C", 1000), "fan": ("RPM", 1), "in": ("V", 1000), "power": ("W", 1000000), "curr": ("A", 1000)}
    found = []
    for chip in sorted(glob.glob(os.path.join(root, "hwmon*"))):
        name = read(chip + "/name").strip()
        device = os.path.basename(os.path.realpath(chip + "/device")) or "unknown"
        for path in sorted(glob.glob(chip + "/*_input")):
            m = re.match(r"(temp|fan|in|power|curr)(\d+)_input", os.path.basename(path))
            try:
                value = int(read(path).strip())
            except ValueError:
                continue
            if m:
                unit, by = kinds[m.group(1)]
                channel = m.group(1) + m.group(2)
                label = read(path[:-6] + "_label").strip() or channel
                sensor_id = ":".join(("hwmon", name.lower(), device.lower(), channel))
                found.append({"id": sensor_id, "source": "hwmon", "chip": name, "name": label,
                              "value": round(value / by, 2 if by > 1 and unit != "°C" else 0), "unit": unit})
    return found


def hardware(root="/"):
    """A read-only hardware inventory. Missing kernel/DMI fields are explicit, never inferred."""
    def path(name):
        return os.path.join(root, name.lstrip("/"))

    def value(group, ident, name, filename, source, unit="", scale=1):
        raw = read(path(filename)).strip()
        if raw.lower() in {"to be filled by o.e.m.", "system manufacturer", "system product name",
                           "default string", "unknown", "not specified"}:
            raw = ""
        if raw:
            try:
                number = int(raw, 10)
                val = number // scale if scale > 1 else number
            except ValueError:
                val = " ".join(raw.split())
            available = True
        else:
            val, available = None, False
        group["items"].append({"id": ident, "name": name, "value": val, "unit": unit,
                               "source": source, "available": available})

    groups = [{"id": ident, "name": name, "items": []} for ident, name in (
        ("processor", "Processor"), ("memory", "Memory"), ("board", "Motherboard and BIOS"), ("graphics", "Graphics"))]
    cpu, memory, board, graphics = groups
    cpuinfo = read(path("/proc/cpuinfo"))
    first_cpu = cpuinfo.split("\n\n", 1)[0]
    fields = dict((key.strip(), val.strip()) for line in first_cpu.splitlines()
                  if ":" in line for key, val in [line.split(":", 1)])
    for ident, label, key in (("model", "Model", "model name"), ("vendor", "Vendor", "vendor_id"),
                              ("family", "Family", "cpu family"), ("model_id", "Model ID", "model"),
                              ("stepping", "Stepping", "stepping"), ("microcode", "Microcode", "microcode"),
                              ("cores", "Cores", "cpu cores")):
        val = fields.get(key)
        cpu["items"].append({"id": "cpu:" + ident, "name": label, "value": val, "unit": "",
                             "source": "procfs:/proc/cpuinfo", "available": bool(val)})
    specs = {}
    try:
        rows = json.loads(out("lscpu", "--json", timeout=3) or "{}").get("lscpu", [])
        specs = {row["field"].rstrip(":"): row.get("data") for row in rows if row.get("field")}
    except (KeyError, TypeError, ValueError):
        pass
    for ident, label, field in (
        ("architecture", "Architecture", "Architecture"),
        ("operation_modes", "CPU operation modes", "CPU op-mode(s)"),
        ("byte_order", "Byte order", "Byte Order"),
        ("threads_per_core", "Threads per core", "Thread(s) per core"),
        ("cores_per_socket", "Cores per socket", "Core(s) per socket"),
        ("sockets", "Sockets", "Socket(s)"),
        ("cpu_min_mhz", "Minimum frequency", "CPU min MHz"),
        ("cpu_max_mhz", "Maximum frequency", "CPU max MHz"),
        ("frequency_scaling", "Frequency scaling", "CPU(s) scaling MHz"),
        ("virtualization", "Virtualization", "Virtualization"),
        ("instruction_flags", "Instruction flags", "Flags"),
    ):
        val = specs.get(field)
        cpu["items"].append({"id": "cpu:" + ident, "name": label, "value": val, "unit": "",
                             "source": "lscpu", "available": bool(val)})
    threads = len(re.findall(r"(?m)^processor\s*:", cpuinfo))
    cpu["items"].append({"id": "cpu:threads", "name": "Threads", "value": threads or None, "unit": "",
                         "source": "procfs:/proc/cpuinfo", "available": threads > 0})
    for ident, label, filename, unit in (
        ("online", "Online processors", "/sys/devices/system/cpu/online", ""),
    ):
        value(cpu, "cpu:" + ident, label, filename, "sysfs:" + filename, unit)

    policies = sorted(glob.glob(path("/sys/devices/system/cpu/cpufreq/policy[0-9]*")))
    for policy in policies:
        name = os.path.basename(policy)
        for key, label in (("scaling_cur_freq", "Current"), ("cpuinfo_min_freq", "Minimum"),
                           ("cpuinfo_max_freq", "Maximum")):
            filename = os.path.join(policy, key)
            raw = read(filename).strip()
            try:
                mhz = int(raw) // 1000
                available = True
            except ValueError:
                mhz, available = None, False
            cpu["items"].append({"id": "cpu:" + name + ":" + key, "name": label, "device": name,
                                 "value": mhz, "unit": "MHz", "source": "sysfs:" + filename.lstrip("/"),
                                 "available": available})
        filename = os.path.join(policy, "scaling_governor")
        governor = read(filename).strip()
        cpu["items"].append({"id": "cpu:" + name + ":governor", "name": "Governor", "device": name,
                             "value": governor or None, "unit": "", "source": "sysfs:" + filename.lstrip("/"),
                             "available": bool(governor)})

    seen_caches = set()
    for cache in sorted(glob.glob(path("/sys/devices/system/cpu/cpu[0-9]*/cache/index[0-9]*"))):
        level = read(os.path.join(cache, "level")).strip()
        kind = read(os.path.join(cache, "type")).strip()
        size = read(os.path.join(cache, "size")).strip()
        shared = read(os.path.join(cache, "shared_cpu_list")).strip()
        match = re.fullmatch(r"(\d+)([KMG]?)", size, re.I)
        if not (level.isdigit() and kind and match):
            continue
        amount, prefix = int(match.group(1)), match.group(2).upper()
        size_bytes = amount * {"": 1, "K": 1024, "M": 1048576, "G": 1073741824}[prefix]
        cache_name = "L" + level + " " + kind.lower() + " cache"
        cache_id = "cpu:cache:l" + level + ":" + kind.lower() + ":" + shared
        if cache_id in seen_caches:
            continue
        seen_caches.add(cache_id)
        cache_source = "sysfs:" + os.path.join(cache.removeprefix(root), "size").lstrip("/")
        cpu["items"].append({"id": cache_id, "name": cache_name,
                         "device": "CPUs " + shared if shared else "", "value": size_bytes, "unit": "bytes",
                         "source": cache_source,
                         "available": True})
        for key, suffix, label, unit in (
            ("coherency_line_size", "line_size", "Cache line size", "bytes"),
            ("physical_line_partition", "line_partitions", "Physical line partitions", ""),
            ("number_of_sets", "sets", "Number of sets", ""),
            ("ways_of_associativity", "associativity", "Associativity", "ways"),
        ):
            raw = read(os.path.join(cache, key)).strip()
            number = int(raw) if raw.isdigit() else None
            cpu["items"].append({"id": cache_id + ":" + suffix, "name": label,
                                 "device": "CPUs " + shared if shared else "", "value": number, "unit": unit,
                                 "source": "sysfs:" + os.path.join(cache.removeprefix(root), key).lstrip("/"),
                                 "available": number is not None})

    meminfo = dict(re.findall(r"(?m)^(\w+):\s+(\d+)", read(path("/proc/meminfo"))))
    total = int(meminfo.get("MemTotal", "0")) * 1024
    memory["items"].append({"id": "memory:total", "name": "Usable memory", "value": total or None,
                            "unit": "bytes", "source": "procfs:/proc/meminfo", "available": total > 0})
    modules = []
    for dimm in sorted(glob.glob(path("/sys/devices/system/edac/mc/mc*/dimm*"))):
        size = read(os.path.join(dimm, "size")).strip()
        if not size.isdigit() or int(size) == 0:
            continue
        label = read(os.path.join(dimm, "dimm_label")).strip() or os.path.basename(dimm)
        kind = read(os.path.join(dimm, "dimm_mem_type")).strip()
        modules.append((dimm, label, size, kind))
    if modules:
        for dimm, label, size, kind in modules:
            memory["items"].append({"id": "memory:module:" + os.path.basename(dimm), "name": label,
                                    "value": int(size), "unit": "MiB" + ((" · " + kind) if kind else ""),
                                    "source": "sysfs:" + dimm.removeprefix(root).lstrip("/"), "available": True})
    else:
        memory["items"].append({"id": "memory:modules", "name": "Memory modules", "value": None, "unit": "",
                                "source": "sysfs:/sys/devices/system/edac", "available": False})

    for ident, label, filename in (
        ("system_vendor", "System manufacturer", "/sys/class/dmi/id/sys_vendor"),
        ("system_model", "System model", "/sys/class/dmi/id/product_name"),
        ("board_vendor", "Board manufacturer", "/sys/class/dmi/id/board_vendor"),
        ("board_name", "Board model", "/sys/class/dmi/id/board_name"),
        ("board_version", "Board version", "/sys/class/dmi/id/board_version"),
        ("bios_vendor", "BIOS manufacturer", "/sys/class/dmi/id/bios_vendor"),
        ("bios_version", "BIOS version", "/sys/class/dmi/id/bios_version"),
        ("bios_date", "BIOS date", "/sys/class/dmi/id/bios_date"),
    ):
        value(board, "board:" + ident, label, filename, "sysfs:" + filename)
    pci_listing = out("lspci", "-vmm", timeout=3)
    for block in pci_listing.strip().split("\n\n"):
        f = dict(line.split(":\t", 1) for line in block.splitlines() if ":\t" in line)
        category = f.get("Class", "").lower()
        if not any(bridge in category for bridge in ("host bridge", "smbus")):
            continue
        slot = f.get("Slot", "")
        vendor, model = f.get("Vendor", ""), f.get("Device", "")
        if not slot or not (vendor or model):
            continue
        board["items"].append({"id": "board:chipset:" + slot, "name": "Chipset",
                               "device": slot, "value": " ".join(v for v in (vendor, model) if v),
                               "unit": "", "source": "lspci", "available": True})

    cards = sorted(p for p in glob.glob(path("/sys/class/drm/card[0-9]*"))
                   if re.fullmatch(r"card\d+", os.path.basename(p)))
    for card in cards:
        cardname = os.path.basename(card)
        dev = os.path.realpath(os.path.join(card, "device"))
        pci = os.path.basename(dev)
        driverpath = os.path.join(dev, "driver")
        driver = os.path.basename(os.path.realpath(driverpath)) if os.path.islink(driverpath) else ""
        model = read(os.path.join(dev, "product_name")).strip()
        model_source = "sysfs:" + os.path.join("/sys/class/drm", cardname, "device", "product_name")
        pci_info = {}
        if not model and pci:
            listing = out("lspci", "-s", pci, "-vmm", timeout=3)
            pci_info = dict(line.split(":\t", 1) for line in listing.splitlines() if ":\t" in line)
            vendor_name, device_name = pci_info.get("Vendor", ""), pci_info.get("Device", "")
            if vendor_name or device_name:
                model = " ".join(v for v in (vendor_name, device_name) if v)
                model_source = "lspci"
        graphics["items"].append({"id": "gpu:" + pci + ":model", "name": "GPU model", "device": cardname,
                                  "value": model or None, "unit": "", "source": model_source,
                                  "available": bool(model)})
        for suffix, label, raw, unit in (
            ("vendor", "Vendor ID", read(os.path.join(dev, "vendor")).strip(), ""),
            ("device", "Device ID", read(os.path.join(dev, "device")).strip(), ""),
            ("driver", "Driver", driver, ""),
        ):
            graphics["items"].append({"id": "gpu:" + pci + ":" + suffix, "name": label, "device": cardname, "value": raw or None,
                                      "unit": unit, "source": "sysfs:/sys/class/drm/" + cardname + "/device",
                                      "available": bool(raw)})
        for key, suffix, label, sysfs_key in (("Rev", "revision", "PCI revision", "revision"),
                                              ("SVendor", "subsystem_vendor", "Subsystem vendor", "subsystem_vendor"),
                                              ("SDevice", "subsystem_device", "Subsystem device", "subsystem_device"),
                                              ("Class", "class", "PCI class", "class"),
                                              ("ProgIf", "prog_if", "Programming interface", "prog_if")):
            raw = pci_info.get(key, "")
            source = "lspci"
            if not raw:
                raw = read(os.path.join(dev, sysfs_key)).strip()
                source = "sysfs:/sys/class/drm/" + cardname + "/device/" + sysfs_key
            graphics["items"].append({"id": "gpu:" + pci + ":" + suffix, "name": label, "device": cardname,
                                      "value": raw or None, "unit": "", "source": source, "available": bool(raw)})
        for key, label in (("gpu_busy_percent", "GPU usage"), ("mem_info_vram_used", "Video memory used"),
                           ("mem_info_vram_total", "Video memory total"), ("mem_info_gtt_used", "Graphics shared memory used"),
                           ("mem_info_gtt_total", "Graphics shared memory total")):
            raw = read(os.path.join(dev, key)).strip()
            try:
                val = int(raw)
                unit = "%" if key == "gpu_busy_percent" else "bytes"
                available = True
            except ValueError:
                val, unit, available = None, "%" if key == "gpu_busy_percent" else "bytes", False
            graphics["items"].append({"id": "gpu:" + pci + ":" + key, "name": label, "device": cardname,
                                      "value": val, "unit": unit, "source": "sysfs:" + os.path.join(
                                          "/sys/class/drm", cardname, "device", key), "available": available})
        for key in ("gt_cur_freq_mhz", "gt_min_freq_mhz", "gt_max_freq_mhz"):
            raw = read(os.path.join(dev, key)).strip()
            if raw.isdigit():
                label = {"gt_cur_freq_mhz": "Current frequency", "gt_min_freq_mhz": "Minimum frequency",
                         "gt_max_freq_mhz": "Maximum frequency"}[key]
                graphics["items"].append({"id": "gpu:" + pci + ":" + key, "name": label, "device": cardname,
                                          "value": int(raw), "unit": "MHz", "source": "sysfs:" + os.path.join(
                                              "/sys/class/drm", cardname, "device", key), "available": True})
        for key, label in (("pp_dpm_sclk", "Core clock states"), ("pp_dpm_mclk", "Memory clock states"),
                           ("pp_dpm_pcie", "PCI Express link states")):
            filename = os.path.join(dev, key)
            states = read(filename).strip()
            graphics["items"].append({"id": "gpu:" + pci + ":" + key, "name": label, "device": cardname,
                                      "value": states or None, "unit": "", "source": "sysfs:" + os.path.join(
                                              "/sys/class/drm", cardname, "device", key), "available": bool(states)})
        for key, suffix, label, unit in (
            ("current_link_speed", "pcie_current_link_speed", "Current PCIe link speed", ""),
            ("current_link_width", "pcie_current_link_width", "Current PCIe link width", "lanes"),
            ("max_link_speed", "pcie_max_link_speed", "Maximum PCIe link speed", ""),
            ("max_link_width", "pcie_max_link_width", "Maximum PCIe link width", "lanes"),
        ):
            raw = read(os.path.join(dev, key)).strip()
            if key.endswith("width"):
                val = int(raw) if raw.isdigit() else None
            else:
                val = raw if raw and raw.lower() != "unknown" else None
            graphics["items"].append({"id": "gpu:" + pci + ":" + suffix, "name": label, "device": cardname,
                                      "value": val, "unit": unit, "source": "sysfs:" + os.path.join(
                                          "/sys/class/drm", cardname, "device", key),
                                      "available": val is not None})
    if not cards:
        graphics["items"].append({"id": "gpu:none", "name": "Graphics devices", "value": None, "unit": "",
                                  "source": "sysfs:/sys/class/drm", "available": False})
    return {"schema": 1, "groups": groups}


def main(a):
    if a[:1] == ["watch"]:
        try:
            watch(max(1, float(a[1])) if len(a) > 1 else 2)
        except (BrokenPipeError, KeyboardInterrupt):
            os._exit(0)                                 # whoever listened has gone: nothing is left to say, or to flush
    elif a == ["startup"]:
        print(json.dumps(startup(), ensure_ascii=False))
    elif len(a) == 3 and a[0] == "startup-set" and a[2] in ("on", "off"):
        return startup_set(a[1], a[2] == "on")
    elif a == ["sensors"]:
        print(json.dumps(sensors(), ensure_ascii=False))
    elif a == ["hardware"]:
        print(json.dumps(hardware(), ensure_ascii=False))
    elif a[:1] in (["end"], ["kill"]) and len(a) > 1 and all(p.isdigit() for p in a[1:]):
        for pid in a[1:]:
            try:
                os.kill(int(pid), signal.SIGTERM if a[0] == "end" else signal.SIGKILL)
            except OSError as e:
                print(e, file=sys.stderr)
    else:
        print(__doc__.strip())
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
