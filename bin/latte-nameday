#!/usr/bin/env python3
"""latte-nameday: whose name day it is today and tomorrow, for the country of the user's language.

  latte-nameday        {"today": "Kvetoslava", "tomorrow": "Aurel"}  (an empty text where it is not known)

The source is nameday.abalin.net (no key needed). Each date is asked once and kept in ~/.cache/latteos/nameday.json;
with no network what was kept is told, and nothing otherwise. The country is the one in LANG (sk_SK: sk), "sk" if there is none.
"""
import datetime, json, os, sys, urllib.request

CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "latteos", "nameday.json")


def country():
    lang = (os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or "").split(".")[0]
    return (lang.split("_")[1] if "_" in lang else "sk").lower()


def kept():
    try:
        with open(CACHE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def name_on(day, c, memory):
    key = "%s:%s" % (c, day.strftime("%m-%d"))
    if memory.get(key):
        return memory[key]
    url = "https://nameday.abalin.net/api/V2/date?day=%d&month=%d" % (day.day, day.month)
    try:
        said = (json.load(urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "LatteOS"}), timeout=6)).get("data") or {}).get(c) or ""
    except Exception:
        return ""
    if said and said != "n/a":
        memory[key] = said
    return memory.get(key, "")


def main():
    c, memory, today = country(), kept(), datetime.date.today()
    out = {"today": name_on(today, c, memory), "tomorrow": name_on(today + datetime.timedelta(days=1), c, memory)}
    try:
        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
        with open(CACHE + ".new", "w") as f:
            json.dump(memory, f, ensure_ascii=False)
        os.replace(CACHE + ".new", CACHE)
    except OSError:
        pass
    print(json.dumps(out, ensure_ascii=False))


if __name__ == "__main__":
    if len(sys.argv) > 1:
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(2)
    main()
