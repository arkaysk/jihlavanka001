#!/usr/bin/env python3
"""latte-ai: who answers in LensGoo's AI mode and in LensAI, and the conversations kept with them.
No API key: the official tool of a service answers, with the account the user is logged in to it with.

  latte-ai providers [all]  what there is on this computer: [{"id", "name", "local", "style", "models": [{"id", "name"}],
                            "efforts": [how hard it may think, from least to most; empty when it cannot be told]}];
                            "local" tells an answer made on this machine from one that goes to a service, "style"
                            whose look the field to write in takes (claude, gemini, grok, chatgpt, own); "web" the
                            service's page, "plus" and "menu" the rows of the field's + and chip (see PLUS). None when the
                            user turned the AI off (Settings › AI: the word "off" in ~/.config/latteos/ai), unless `all`
  latte-ai send CHAT PROVIDER MODEL TEXT [--effort E] [--attach PATH]… [--stream] [--markdown]
                            asks the next question of a conversation and keeps both in it. CHAT "new" begins one.
                            A model "" is the tool's own choice. What is attached is copied beside the question, and
                            the tool may read only that: files and pictures, never the rest of the computer.
                            Prints {"chat", "answer", "ok", "usage": {"context", "window", "tokens", "cost", "limits"}}:
                            context is what the last question filled of the model's window, tokens all the
                            conversation has spent, limits what the service told of the account's own:
                            {"five_hour": {"used": 0…1, "resets": unix time}, "seven_day": {…}} (Claude tells them).
                            What went wrong is the answer, with "ok": false.
                            --stream: the answer is printed as it comes too, a line {"delta": text} for each piece,
                            before the last line. --markdown: the answer may be formatted (LensAI shows
                            Markdown; LensGoo's card does not). Ended (SIGTERM), it keeps what had come, "stopped": true
  latte-ai again CHAT PROVIDER MODEL [--text TEXT] [same options as send]
                            the last answer once more, from this service and model; with --text the last question
                            is changed first
  latte-ai services         every service LatteOS knows, also those not installed, for LensAI:
                            [{"id", "name", "local", "style", "installed", "signed" (true, false, or null where it
                            cannot be told), "account", "login": [command], "logout": [command], "install": shell}]; a
                            command to sign in or out, or to install the tool, is run in a terminal, where it asks what it needs
  latte-ai pick             a file chooser; the paths chosen, one a line
  latte-ai shot             a picture of the screen now; its path
  latte-ai keys             the services one can bring a key of one's own to, as in VS Code, and the user's own
                            servers: [{"id", "name", "style", "url", "has" (a key is kept), "server" (one of the user's)}]
  latte-ai key ID           keeps the key read from stdin, in the system's keyring (never in a file)
  latte-ai forget-key ID    takes it out of the keyring
  latte-ai server add NAME URL     a server of the user's own that speaks the OpenAI API (llama-server, Ollama…)
  latte-ai server remove ID
  latte-ai agents           what the services tell of the accounts and what was used, for LensAI's agents panel:
                            {"services": [{"id", "name", "plan", "signed", "login", "limits": [{"label", "used", "resets"}],
                            "asked"}], "stats": {"week", "today", "model", "busiest", "prompts", "sessions"}}
  latte-ai skill install|reset|path   LatteOS's skill for the agents (Claude Code, Codex, Gemini): the user's copy in
                            ~/.config/latteos/skills/latteos, linked into each agent's skills; reset brings back LatteOS's own
  latte-ai do TASK [AGENT]  "Do it for me": the agent (claude, chatgpt = Codex, gemini; else the chosen one) on the task in
                            a terminal, planning first with LatteOS's skill and changing nothing until the user says yes
  latte-ai doer AGENT       the agent "Do it for me" uses (~/.config/latteos/agent)
  latte-ai local hardware | recommend | models | search TEXT [best|downloads|updated|likes] | files REPO | readme REPO |
                 get REPO FILE | runtime get | gpu on|off | remove PATH
                            the AI on this computer: what it can carry, LatteOS's recommended models (with "fit": gpu ·
                            partial · cpu · too-big, and the "best"), Hugging Face's GGUF models as LM Studio lists them,
                            a download ({"got", "total"} lines, then {"done"}), llama.cpp's Vulkan build
  latte-ai crash PID        a program that crashed (systemd-coredump): the agent finds out what happened and explains it
  latte-ai why              in SAFE: the agent finds out why the last session ended and explains it
  latte-ai models           every model of every service there is, for LensAI: [{"id", "name", "models":
                            [{"id", "name", "hidden", "default"}]}]; `providers` leaves the hidden ones out and puts
                            the default first
  latte-ai model show|hide|default PROVIDER MODEL
  latte-ai listen start|stop    the microphone: start records, stop ends it and prints what was said, {"text"}
                            (whisper.cpp, in the language of the desktop; a build with Vulkan and the large-v3-turbo
                            model when there is one, else the small model on the processor)
  latte-ai agent NAME [TEXT]    a small fixed task (a micro-agent) as a question for the AI: {"question", "provider",
                            "model"}; the text is TEXT, or the clipboard when there is none. NAME: summarize, translate,
                            explain, command. It goes to the AI on this computer when there is one: quick, and the
                            clipboard does not leave the computer
  latte-ai usage PROVIDER   {"limits", "asked"}: what the service tells of the account's own limits without being asked
                            anything, as "limits" of send (Copilot: {"chat", "completions"}; {} when it tells nothing), and
                            how many questions went to it through Lens this month — LatteOS's own count, not the account's
  latte-ai chats            the conversations, the newest first: [{"id", "title", "provider", "model", "updated", "count"}]
  latte-ai chat ID          one conversation whole: {"id", "title", "provider", "model", "messages": [{"role", "content",
                            "provider", "model", "at"}], "usage"}
  latte-ai forget ID        throws one away

The conversations are kept in ~/.local/state/latteos/ai/chats/ID.json, one file each. What the user wants every AI
to know or keep to (LensAI › Instructions) is ~/.config/latteos/ai-instructions.txt; it goes with every question.
The AI on this computer is llama.cpp's llama-server with a model file (.gguf), found under ~/.local/share/latteos/ai
or /data/ai (llama/*/llama-server, models/*.gguf). It starts the first time it is asked and stays, on 127.0.0.1 only;
`latte-ai stop` ends it.
"""
import datetime
import glob
import json
import os
import shutil
import subprocess
import sys
import uuid


def N(s):
    """A text the apps show translated (goo/lang): marked, so that tests/check.sh asks for its translation."""
    return s

SYSTEM = ("You are the assistant in the launcher of the LatteOS desktop. Answer briefly and to the point, in the "
          "language of the question, in plain text: no Markdown, no headings.")
SYSTEM_MD = ("You are the assistant of the LatteOS desktop. Answer to the point, in the language of the question. "
             "Markdown is shown: use it where it helps (lists, code blocks, bold), not for headings on short answers.")
STREAM = False                  # --stream: the pieces of an answer are printed as they come
PIECES = []                     # what has come of the answer so far, kept for a stop
CHILD = None                    # the tool asked now, ended with us


class Stopped(BaseException):          # not an error of the service: no except of theirs may swallow it
    pass


def piece(text):
    """A piece of the answer: kept, and told at once when someone is watching."""
    if text:
        PIECES.append(text)
        if STREAM:
            say(delta=text)


def say(**what):
    print(json.dumps(what, ensure_ascii=False), flush=True)
# Where a tool is run: an empty folder of its own, so that it finds no project there to read.
# The desktop's services have a short PATH (no ~/.local/bin, where a user's own tools live): look there too.
SEARCH = os.pathsep.join([os.environ.get("PATH", "/usr/local/bin:/usr/bin"), os.path.expanduser("~/.local/bin"), os.path.expanduser("~/bin"),
                          os.path.expanduser("~/.grok/bin"), os.path.expanduser("~/.local/share/mise/shims")])
ROOM = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "latteos", "ai")
CHATS = os.path.join(ROOM, "chats")
KEEP = 12                       # what a tool is reminded of: the last six turns


def claude(prompt, model, effort="", files=()):
    # No tools: it answers, it does not act on the computer — but reading, where something is attached: the files lie
    # in the folder it runs in, and it reads only there. The conversation is not kept among the user's own, and what
    # the user set up for their own work with the tool (hooks, instructions) stays out of the answers.
    if files:
        prompt += "\n\nAttached, in this folder: " + ", ".join(files)
    return ["claude", "-p", prompt, "--system-prompt", SYSTEM, "--output-format", "stream-json", "--verbose"] + (["--include-partial-messages"] if STREAM else []) + ["--no-session-persistence",
            "--setting-sources", "project", "--restricted", "--strict-mcp-config"] + (["--model", model] if model else []) + (["--effort", effort] if effort else []) \
        + (["--allowedTools", "Read(./**)", "--tools", "Read"] if files else ["--tools", ""])


def claude_read(out):
    """The answer, what it cost and how much of the account's limits is used, from the lines claude prints.
    The limits come as a rate_limit_event: the share of the five hours and of the week, and when each starts again."""
    d, limits = {}, {}
    for line in out.splitlines():
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if e.get("type") == "result":
            d = e
        elif e.get("type") == "rate_limit_event":
            for k, w in ((e.get("rate_limit_info") or {}).get("unifiedWindows") or {}).items():
                limits[k] = {"used": w.get("utilization", 0), "resets": w.get("resetsAt", 0)}
    if not d:
        raise ValueError("no result")
    used = next(iter((d.get("modelUsage") or {}).values()), {})
    u = d.get("usage") or {}
    context = sum(u.get(k, 0) for k in ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens", "output_tokens"))
    return d.get("result", ""), not d.get("is_error"), {"context": context, "window": used.get("contextWindow", 200000),
                                                        "tokens": used.get("inputTokens", 0) + used.get("outputTokens", 0), "cost": d.get("total_cost_usd", 0),
                                                        "limits": limits}


# Gemini, Codex, Grok and Mistral answered on latte-lab (21. 10.), signed in with the user's accounts; Grok and Mistral
# were also asked to write a file and did not. Ollama is written from its documentation. Their answers come as plain
# text, without usage.
def gemini(prompt, model, effort="", files=()):
    # plan: it may read, never change anything; @ puts an attached file into the question
    # the folder it runs in is LatteOS's own empty one: trusted without asking, so that plan is not overridden
    return ["gemini", "-p", SYSTEM + "\n\n" + prompt + "".join(" @" + f for f in files), "--skip-trust", "--approval-mode", "plan", "-o", "text"] \
        + (["-m", model] if model else [])


def grok(prompt, model, effort="", files=()):
    # plan: a headless run cannot be asked to allow anything, so it reads and never writes or runs
    if files:
        prompt += "\n\nAttached, in this folder: " + ", ".join(files)
    return ["grok", "-p", SYSTEM + "\n\n" + prompt, "--permission-mode", "plan", "--output-format", "plain"] + (["-m", model] if model else [])


def vibe(prompt, model, effort="", files=()):
    # ask: a tool would need a yes nobody can give; one turn: it answers and stops
    if files:
        prompt += "\n\nAttached, in this folder: " + ", ".join(files)
    return ["vibe", "-p", SYSTEM + "\n\n" + prompt, "--agent", "ask", "--max-turns", "1", "--output", "text"]


LOCAL_PORT = 8790
LOCAL_CONTEXT = 8192
LOCAL_DIRS = [os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "latteos", "ai"), "/data/ai"]


# ── the AI on this computer: what the hardware can carry, LatteOS's recommended models, and any other found on Hugging
# Face as LM Studio finds them (GGUF files, how each would fit), downloaded into LOCAL_DIRS ──────────────────────────
RECOMMENDED = os.path.join(os.environ.get("LATTE_SHARE") or "/usr/share/latteos", "ai", "local-models.json")
HF = "https://huggingface.co"
LOCAL_SETTINGS = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "latteos", "local-ai.json")


def hardware():
    """The processor (and whether it has AVX2: without it, only small models answer at a reading pace), the memory, the
    graphics cards with their own memory, and the room where models go."""
    cpu, flags = "", ""
    for line in open("/proc/cpuinfo", errors="replace"):
        if line.startswith("model name") and not cpu:
            cpu = line.split(":", 1)[1].strip()
        elif line.startswith("flags") and not flags:
            flags = line
    ram = 0
    for line in open("/proc/meminfo"):
        if line.startswith("MemTotal:"):
            ram = int(line.split()[1]) * 1024
    gpus = []
    for dev in sorted(glob.glob("/sys/class/drm/card[0-9]/device")):
        vendor = open(os.path.join(dev, "vendor")).read().strip() if os.path.exists(os.path.join(dev, "vendor")) else ""
        vram = 0
        try:
            vram = int(open(os.path.join(dev, "mem_info_vram_total")).read())          # AMD
        except (OSError, ValueError):
            pass
        name = {"0x1002": "AMD", "0x10de": "NVIDIA", "0x8086": "Intel"}.get(vendor, vendor)
        try:
            slot = os.path.basename(os.path.realpath(dev))
            name = subprocess.run(["lspci", "-s", slot], capture_output=True, text=True, timeout=5).stdout.split(": ", 1)[-1].strip() or name
        except (OSError, subprocess.TimeoutExpired):
            pass
        if vendor == "0x10de" and shutil.which("nvidia-smi"):
            try:
                vram = int(subprocess.run(["nvidia-smi", "--query-gpu=memory.total", "--format=csv,noheader,nounits"],
                                          capture_output=True, text=True, timeout=10).stdout.split()[0]) * 1048576
            except (OSError, ValueError, IndexError, subprocess.TimeoutExpired):
                pass
        gpus.append({"name": name, "vendor": {"0x1002": "amd", "0x10de": "nvidia", "0x8086": "intel"}.get(vendor, ""), "vram": vram})
    where = models_dir()
    free = shutil.disk_usage(where if os.path.exists(where) else os.path.expanduser("~")).free
    return {"cpu": cpu, "cores": os.cpu_count() or 1, "avx2": " avx2" in flags, "ram": ram, "gpus": gpus, "dir": where, "free": free}


def models_dir():
    """Where a downloaded model goes: the first of LOCAL_DIRS that already has models, else the user's own."""
    for d in LOCAL_DIRS:
        if os.path.isdir(os.path.join(d, "models")) and os.access(os.path.join(d, "models"), os.W_OK):
            return os.path.join(d, "models")
    return os.path.join(LOCAL_DIRS[0], "models")


def fit(size, hw):
    """How a file of this size would run here, in LM Studio's words: on the graphics card whole, partly, on the processor
    alone, or too large. Memory is left for the system and the rest of the desktop."""
    vram = max([g["vram"] for g in hw["gpus"]] or [0])
    need = size * 1.15                                  # the file and the context beside it
    if vram and need <= vram * 0.9:
        return "gpu"
    ram = hw["ram"] * 0.6
    if vram and need <= vram * 0.9 + ram:
        return "partial"
    return "cpu" if need <= ram else "too-big"


def recommend():
    """LatteOS's list with how each would fit, and the one offered: the best that fits; without AVX2 a dense model over
    5 GB that leans on the processor answers too slowly to count (latte-lab, inspo/ai-na-ploche.md)."""
    try:
        with open(RECOMMENDED) as f:
            listed = json.load(f)
    except (OSError, ValueError):
        listed = {"models": [], "updated": ""}
    hw = hardware()
    have = {os.path.basename(m["id"]) for m in local_models_all()}
    best = ""
    for m in listed["models"]:
        m["fit"] = fit(m["size"], hw)
        m["have"] = m["file"] in have
        slow = m["fit"] in ("cpu", "partial") and not hw["avx2"] and not m.get("moe") and m["size"] > 5e9
        if not best and m["fit"] != "too-big" and not slow:
            best = m["id"]
    small = listed["models"][-1]["id"] if listed["models"] else ""
    return {"hardware": hw, "updated": listed.get("updated", ""), "models": listed["models"], "best": best, "fast": small,
            "gpu": local_settings().get("gpu", False), "runtime": local_server() or ""}


def local_settings():
    try:
        with open(LOCAL_SETTINGS) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def hf(path):
    import urllib.request
    return json.load(urllib.request.urlopen(urllib.request.Request(HF + path, headers={"Accept": "application/json"}), timeout=20))


SORTS = {"best": "trendingScore", "downloads": "downloads", "updated": "lastModified", "likes": "likes"}


def hf_search(text, sort="best"):
    """Models on Hugging Face with GGUF files, as LM Studio's search lists them: sorted by best match (trending),
    downloads, the latest or likes; each with what can be told without opening it (size class, base, licence, vision)."""
    import re
    import urllib.parse
    found = hf("/api/models?" + urllib.parse.urlencode({"search": text, "filter": "gguf", "sort": SORTS.get(sort, "trendingScore"),
                                                          "direction": "-1", "limit": "40", "full": "true"}))
    out = []
    for m in found:
        tags = m.get("tags") or []
        name = m["id"].split("/", 1)[1]
        params = re.search(r"(\d+(?:\.\d+)?)[Bb](?![a-z])", name)
        out.append({"repo": m["id"], "author": m["id"].split("/")[0], "name": re.sub(r"[-_]GGUF$", "", name, flags=re.I),
                    "downloads": m.get("downloads", 0), "likes": m.get("likes", 0),
                    "updated": (m.get("lastModified") or m.get("createdAt") or "")[:10], "params": (params.group(1) + "B") if params else "",
                    "base": next((t.split(":", 1)[1] for t in tags if t.startswith("base_model:") and t.count(":") == 1), ""),
                    "license": next((t.split(":", 1)[1] for t in tags if t.startswith("license:")), ""),
                    "vision": m.get("pipeline_tag") == "image-text-to-text"})
    return out


def hf_readme(repo):
    """A model's card, its README, without the front matter: what its page says of it."""
    import urllib.request
    try:
        text = urllib.request.urlopen("%s/%s/raw/main/README.md" % (HF, repo), timeout=20).read().decode(errors="replace")
    except OSError:
        return ""
    if text.startswith("---"):
        end = text.find("\n---", 3)
        text = text[end + 4:] if end > 0 else text
    return text.strip()[:20000]


def hf_files(repo):
    """The GGUF files of a model on Hugging Face: each quantization with its size and how it would fit here, in LM Studio's
    four estimations (lmstudio-js ModelSearch.ts, MIT: fullGPUOffload · partialGPUOffload · fitWithoutGPU · willNotFit,
    here gpu · partial · cpu · too-big), and the one recommended."""
    import re
    hw = hardware()
    have = {os.path.basename(m["id"]) for m in local_models_all()}
    out, parts = [], {}
    for f in hf("/api/models/%s/tree/main?recursive=true" % repo):
        p = f.get("path", "")
        base = os.path.basename(p).lower()
        # not the model itself: its picture reader, and the small drafts that only speed a big one up (EAGLE, speculators)
        if not p.endswith(".gguf") or "mmproj" in base or base.startswith("eagle") or "draft" in base or "speculator" in base:
            continue
        size = (f.get("lfs") or {}).get("size") or f.get("size") or 0
        split = re.search(r"-(\d{5})-of-(\d{5})\.gguf$", p)
        if split:                                   # a model in parts is one option: the first part, all of them counted
            key = p[:split.start()]
            parts.setdefault(key, []).append((p, size))
            continue
        q = re.search(r"(I?Q\d[\w]*|F16|BF16|F32|MXFP4\w*)", os.path.basename(p), re.I)
        out.append({"file": p, "quant": q.group(1).upper() if q else "", "size": size, "fit": fit(size, hw), "have": os.path.basename(p) in have})
    for key, files in parts.items():
        files.sort()
        size = sum(n for _, n in files)
        q = re.search(r"(I?Q\d[\w]*|F16|BF16|F32|MXFP4\w*)", os.path.basename(key), re.I)
        out.append({"file": files[0][0], "quant": q.group(1).upper() if q else "", "size": size, "fit": fit(size, hw),
                    "have": os.path.basename(files[0][0]) in have, "parts": len(files)})
    out.sort(key=lambda x: x["size"])
    # the variant chosen when nothing is chosen, as LM Studio's `recommended`: Q4_K_M where it fits, else the largest that fits
    fits = [f for f in out if f["fit"] != "too-big"]
    pick = next((f for f in fits if f["quant"] == "Q4_K_M"), fits[-1] if fits else None)
    for f in out:
        f["recommended"] = f is pick
    return out


def hf_get(repo, file):
    """Downloads a model file into models_dir(), resuming a broken one; a line {"got", "total"} as it comes. A model in
    parts (-00001-of-0000N) comes whole: llama.cpp is given the first and finds the others beside it."""
    import re
    if ".." in repo or ".." in file or not file.endswith(".gguf"):
        print(json.dumps({"error": "not a model file"}))
        return 1
    split = re.search(r"-00001-of-(\d{5})\.gguf$", file)
    if split:
        for n in range(int(split.group(1)), 0, -1):         # the first last: it is what says the model is here
            code = hf_get_one(repo, file[:split.start()] + "-%05d-of-%s.gguf" % (n, split.group(1)))
            if code:
                return code
        return 0
    return hf_get_one(repo, file)


def hf_get_one(repo, file):
    import urllib.request
    where = models_dir()
    os.makedirs(where, exist_ok=True)
    dest = os.path.join(where, os.path.basename(file))
    part = dest + ".part"
    got = os.path.getsize(part) if os.path.exists(part) else 0
    req = urllib.request.Request("%s/%s/resolve/main/%s" % (HF, repo, file), headers={"Range": "bytes=%d-" % got} if got else {})
    with urllib.request.urlopen(req, timeout=30) as r, open(part, "ab" if got else "wb") as out:
        total = got + int(r.headers.get("Content-Length") or 0)
        told = 0
        while True:
            chunk = r.read(1 << 20)
            if not chunk:
                break
            out.write(chunk)
            got += len(chunk)
            if got - told >= 8 << 20 or got == total:
                told = got
                print(json.dumps({"got": got, "total": total}), flush=True)
    os.replace(part, dest)
    print(json.dumps({"done": dest}), flush=True)
    return 0


def runtime_get():
    """llama.cpp's latest release built for Vulkan (any graphics card, and the processor), into LOCAL_DIRS[0]/llama."""
    import urllib.request, zipfile
    rel = json.load(urllib.request.urlopen("https://api.github.com/repos/ggml-org/llama.cpp/releases/latest", timeout=20))
    asset = next((a for a in rel["assets"] if a["name"].endswith("-bin-ubuntu-vulkan-x64.zip")), None)
    if not asset:
        print(json.dumps({"error": "no Vulkan build in " + rel.get("tag_name", "")}))
        return 1
    home = os.path.join(LOCAL_DIRS[0], "llama", rel["tag_name"])
    os.makedirs(home, exist_ok=True)
    zpath = home + ".zip"
    with urllib.request.urlopen(asset["browser_download_url"], timeout=30) as r, open(zpath, "wb") as out:
        total, got = asset["size"], 0
        while True:
            chunk = r.read(1 << 20)
            if not chunk:
                break
            out.write(chunk)
            got += len(chunk)
            print(json.dumps({"got": got, "total": total}), flush=True)
    with zipfile.ZipFile(zpath) as z:
        z.extractall(home)
    os.remove(zpath)
    # the archive keeps its programs in build/bin: llama-server is looked for one folder down
    for f in glob.glob(os.path.join(home, "**", "*"), recursive=True):
        if os.path.isfile(f) and os.path.dirname(f) != home:
            os.replace(f, os.path.join(home, os.path.basename(f)))
    for f in glob.glob(os.path.join(home, "*")):
        if os.path.isfile(f) and not f.endswith((".so", ".txt", ".md")) and "." not in os.path.basename(f):
            os.chmod(f, 0o755)
    print(json.dumps({"done": os.path.join(home, "llama-server")}), flush=True)
    return 0


def local_server():
    for d in LOCAL_DIRS:
        found = sorted(glob.glob(os.path.join(d, "llama", "*", "llama-server")))
        if found:
            return found[-1]
    return shutil.which("llama-server", path=SEARCH)


def local_models_all():
    found = []
    for d in LOCAL_DIRS:
        found += glob.glob(os.path.join(d, "models", "*.gguf"))
    return [{"id": f, "name": os.path.basename(f)[:-5], "size": os.path.getsize(f)} for f in sorted(found, key=os.path.getsize)
            if "mmproj" not in os.path.basename(f).lower()]


def local_models():
    """The model files there are, the smallest first: a small one answers soonest."""
    found = []
    for d in LOCAL_DIRS:
        found += glob.glob(os.path.join(d, "models", "*.gguf"))
    found = [f for f in sorted(found, key=os.path.getsize) if "mmproj" not in os.path.basename(f).lower()]
    return [{"id": f, "name": os.path.basename(f)[:-5].replace("-Q4_K_M", "").replace("-q4_k_m", "").replace("-", " ")} for f in found] if local_server() else []


def local_call(path, body=None, timeout=5):
    import urllib.request
    req = urllib.request.Request("http://127.0.0.1:%d%s" % (LOCAL_PORT, path), json.dumps(body).encode() if body else None,
                                 {"Content-Type": "application/json"})
    return json.load(urllib.request.urlopen(req, timeout=timeout))


def local_start(model):
    """llama-server with this model, on this computer only; one that runs another model is ended first."""
    try:
        if local_call("/props").get("model_path") == model:
            return True
    except (OSError, ValueError):
        pass
    subprocess.run(["pkill", "-f", "llama-server.*--port %d" % LOCAL_PORT])
    os.makedirs(ROOM, exist_ok=True)
    # the processor: on graphics cards like latte-lab's the small models run faster there (inspo/ai-na-ploche.md)
    gpu = "99" if local_settings().get("gpu") else "0"        # the user's choice in LensAI › This computer
    subprocess.Popen([local_server(), "-m", model, "-c", str(LOCAL_CONTEXT), "-t", str(max(2, (os.cpu_count() or 4) // 2)), "-ngl", gpu,
                      "--host", "127.0.0.1", "--port", str(LOCAL_PORT), "--jinja"],
                     stdout=open(os.path.join(ROOM, "llama-server.log"), "w"), stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, start_new_session=True)
    for _ in range(240):
        try:
            local_call("/health")
            return True
        except (OSError, ValueError):
            import time
            time.sleep(0.5)          # a model takes a moment to load
    return False


def chat_completion(url, head, body, timeout=600):
    """An OpenAI-style answer (llama-server, the services' APIs, the user's servers): the text and the tokens used.
    Asked for in pieces when someone is watching, and each piece is told as it comes."""
    import urllib.request
    if STREAM:
        body = dict(body, stream=True, stream_options={"include_usage": True})
    req = urllib.request.Request(url.rstrip("/") + "/chat/completions", json.dumps(body).encode(), dict(head, **{"Content-Type": "application/json"}))
    with urllib.request.urlopen(req, timeout=timeout) as r:
        if not STREAM:
            d = json.load(r)
            u = d.get("usage") or {}
            return d["choices"][0]["message"]["content"].strip(), u.get("prompt_tokens", 0) + u.get("completion_tokens", 0)
        text, used = [], 0
        for raw in r:
            line = raw.decode(errors="replace").strip()
            if not line.startswith("data:") or line == "data: [DONE]":
                continue
            d = json.loads(line[5:])
            for c in d.get("choices") or []:
                bit = (c.get("delta") or {}).get("content") or ""
                text.append(bit)
                piece(bit)
            u = d.get("usage") or {}
            used = u.get("prompt_tokens", 0) + u.get("completion_tokens", 0) or used
        return "".join(text).strip(), used


def local_ask(messages, model, effort, files, room):
    """The whole conversation, as messages: the server keeps no memory between questions."""
    if not local_start(model):
        return "latte-ai: the AI on this computer did not start (see llama-server.log)", False, {}
    talk = [{"role": "system", "content": SYSTEM}] + [{"role": m["role"], "content": m["content"]} for m in messages if m.get("content")][-KEEP:]
    if len(talk) > KEEP:
        talk = [talk[0]] + talk[-KEEP:]
    for f in files:
        try:
            with open(os.path.join(room, f), errors="replace") as fh:
                talk[-1]["content"] += "\n\n--- %s ---\n%s" % (f, fh.read(20000))
        except OSError:
            pass
    text, used = chat_completion("http://127.0.0.1:%d/v1" % LOCAL_PORT, {}, {"messages": talk, "temperature": 0.5, "max_tokens": 1024,
                                                                              "chat_template_kwargs": {"enable_thinking": effort == "think"}})
    return text, True, {"context": used, "window": LOCAL_CONTEXT, "tokens": used, "cost": 0}


# ── a key of one's own (as VS Code's "Manage Models"): the service's API is asked directly, a conversation and nothing
# else, no tools. The key lives in the system's keyring (Secret Service: gnome-keyring), looked up when it is needed.
APIS = {
    "api-anthropic": {"name": "Claude API", "style": "claude", "url": "https://api.anthropic.com/v1", "kind": "anthropic"},
    "api-openai": {"name": "OpenAI API", "style": "chatgpt", "url": "https://api.openai.com/v1", "kind": "openai"},
    "api-google": {"name": "Gemini API", "style": "gemini", "url": "https://generativelanguage.googleapis.com/v1beta/openai", "kind": "openai"},
    "api-xai": {"name": "Grok API", "style": "grok", "url": "https://api.x.ai/v1", "kind": "openai"},
    "api-mistral": {"name": "Mistral API", "style": "mistral", "url": "https://api.mistral.ai/v1", "kind": "openai"},
    "api-deepseek": {"name": "DeepSeek", "style": "deepseek", "url": "https://api.deepseek.com", "kind": "openai"},
}
SERVERS = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "latteos", "ai-servers.json")


def servers():
    try:
        with open(SERVERS) as f:
            return {s["id"]: dict(s, style="own", kind="openai", server=True) for s in json.load(f)}
    except (OSError, ValueError, KeyError, TypeError):
        return {}


def apis():
    return dict(APIS, **servers())


def secret(ident, value=None, forget=False):
    """The key of a service in the keyring: read it, keep one, or take it out. None when there is none or no keyring."""
    attrs = ["latteos", "ai", "service", ident]
    try:
        if forget:
            return subprocess.run(["secret-tool", "clear"] + attrs, capture_output=True, timeout=20).returncode == 0
        if value is not None:
            return subprocess.run(["secret-tool", "store", "--label", "LatteOS AI: " + apis().get(ident, {}).get("name", ident)] + attrs,
                                  input=value, capture_output=True, text=True, timeout=60).returncode == 0
        out = subprocess.run(["secret-tool", "lookup"] + attrs, capture_output=True, text=True, timeout=20)
        return out.stdout.strip() or None if out.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired):
        return None


def api_call(a, path, body=None, timeout=20):
    import urllib.request
    key = secret(a["id"])
    head = {"Content-Type": "application/json"}
    if a["kind"] == "anthropic":
        head.update({"x-api-key": key or "", "anthropic-version": "2023-06-01"})
    elif key:
        head["Authorization"] = "Bearer " + key
    req = urllib.request.Request(a["url"].rstrip("/") + path, json.dumps(body).encode() if body else None, head)
    return json.load(urllib.request.urlopen(req, timeout=timeout))


def api_models(ident):
    """What the service offers, asked once a day: the list is long and the question costs a moment."""
    cache = os.path.join(ROOM, "models-%s.json" % ident)
    try:
        if os.path.getmtime(cache) > datetime.datetime.now().timestamp() - 86400:
            with open(cache) as f:
                return json.load(f)
    except (OSError, ValueError):
        pass
    a = dict(apis()[ident], id=ident)
    try:
        found = [m["id"] for m in api_call(a, "/models").get("data", [])]
    except (OSError, ValueError, KeyError):
        return []
    found = [m.split("/")[-1] for m in found if not any(w in m for w in ("embed", "tts", "whisper", "dall-e", "moderation", "image", "audio", "realtime"))]
    out = [{"id": m, "name": m} for m in sorted(set(found))][:40]
    os.makedirs(ROOM, exist_ok=True)
    with open(cache, "w") as f:
        json.dump(out, f)
    return out


def api_ask(ident):
    def ask(messages, model, effort, files, room):
        a = dict(apis()[ident], id=ident)
        talk = [{"role": m["role"], "content": m["content"]} for m in messages if m.get("content")][-KEEP:]
        for f in files:
            try:
                with open(os.path.join(room, f), errors="replace") as fh:
                    talk[-1]["content"] += "\n\n--- %s ---\n%s" % (f, fh.read(20000))
            except OSError:
                pass
        if a["kind"] == "anthropic":
            r = api_call(a, "/messages", {"model": model, "max_tokens": 2048, "system": SYSTEM, "messages": talk}, timeout=300)
            u = r.get("usage") or {}
            used = u.get("input_tokens", 0) + u.get("output_tokens", 0)
            return "".join(b.get("text", "") for b in r.get("content", [])).strip(), True, {"context": used, "window": 200000, "tokens": used, "cost": 0}
        key = secret(ident)
        text, used = chat_completion(a["url"], {"Authorization": "Bearer " + key} if key else {},
                                     {"model": model, "messages": [{"role": "system", "content": SYSTEM}] + talk}, timeout=300)
        return text, True, {"context": used, "window": 0, "tokens": used, "cost": 0}
    return ask


def codex_models():
    """The models ChatGPT's Codex offers the account, and how hard each may think; asked once a day."""
    cache = os.path.join(ROOM, "models-chatgpt.json")
    try:
        if os.path.getmtime(cache) > datetime.datetime.now().timestamp() - 86400:
            with open(cache) as f:
                return json.load(f)
    except (OSError, ValueError):
        pass
    try:
        d = json.loads(subprocess.run(["codex", "debug", "models"], capture_output=True, text=True, timeout=30, env=dict(os.environ, PATH=SEARCH)).stdout)
        out = [{"id": m["slug"], "name": m.get("display_name") or m["slug"], "efforts": [e["effort"] for e in m.get("supported_reasoning_levels", [])]}
               for m in d.get("models", []) if m.get("visibility") == "list"]
    except (OSError, ValueError, KeyError, subprocess.TimeoutExpired):
        return [{"id": "", "name": "Auto"}]
    os.makedirs(ROOM, exist_ok=True)
    with open(cache, "w") as f:
        json.dump(out, f)
    return out or [{"id": "", "name": "Auto"}]


CHOICE = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "latteos", "ai-models.json")


def choice():
    """The user's word on the models: which are hidden ("provider/model") and which one is the default."""
    try:
        with open(CHOICE) as f:
            c = json.load(f)
        return {"hidden": list(c.get("hidden", [])), "default": c.get("default", "")}
    except (OSError, ValueError, AttributeError):
        return {"hidden": [], "default": ""}


def whisper():
    """whisper-cli and the model it is best with here: on the graphics card the large turbo model is quick enough
    (8 s for a 4 s sentence on latte-lab's RX 640), on the processor only the small one is (inspo/ai-na-ploche.md)."""
    for d in LOCAL_DIRS:
        for build, models in (("build-vk", ("ggml-large-v3-turbo-q5_0.bin", "ggml-small.bin")), ("build", ("ggml-small.bin", "ggml-base.bin"))):
            cli = os.path.join(d, "whisper-src", build, "bin", "whisper-cli")
            for m in models:
                if os.path.exists(cli) and os.path.exists(os.path.join(d, "whisper", m)):
                    return cli, os.path.join(d, "whisper", m)
    return None, None


def listen(what):
    wav, pid = os.path.join(ROOM, "listen.wav"), os.path.join(ROOM, "listen.pid")
    os.makedirs(ROOM, exist_ok=True)
    if what == "start":
        p = subprocess.Popen(["pw-record", "--rate", "16000", "--channels", "1", "--format", "s16", wav],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        open(pid, "w").write(str(p.pid))
        return {"ok": True}
    import signal, time
    try:
        os.kill(int(open(pid).read()), signal.SIGINT)        # SIGINT: pw-record closes the file properly
        time.sleep(0.4)
    except (OSError, ValueError):
        pass                                                 # it had ended by itself: what it wrote is still there
    try:
        os.remove(pid)
    except OSError:
        pass
    if not os.path.exists(wav) or os.path.getsize(wav) < 8000:   # under a quarter of a second: nothing was heard
        return {"text": "", "ok": False, "error": "nothing was heard"}
    cli, model = whisper()
    if not cli:
        return {"text": "", "ok": False, "error": "whisper.cpp is not here"}
    lang = (os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or "en")[:2]
    out = subprocess.run([cli, "-m", model, "-l", lang, "-t", str(max(2, (os.cpu_count() or 4) // 2)), "-nt", "-np", "-f", wav],
                         capture_output=True, text=True, timeout=120).stdout
    return {"text": " ".join(l.strip() for l in out.splitlines() if l.strip()), "ok": True}


# Micro-agents (inspo/ai-na-ploche.md): each a fixed task with words of its own, for a small model to do quickly.
LANGS = {"sk": "Slovak", "cs": "Czech", "en": "English", "de": "German", "hu": "Hungarian", "pl": "Polish"}
AGENTS = {
    "summarize": "Summarize the following in a few sentences, in {lang}:\n\n{text}",
    "translate": "Translate the following into {lang}; if it is already {lang}, into English. Only the translation:\n\n{text}",
    "explain": "This is an error message from a Linux computer (Fedora). Explain simply in {lang} what it means and how to fix it:\n\n{text}",
    "command": "Write one bash command for Fedora Linux that does this, then one sentence in {lang} saying what it does. "
               "The user's home folder is {home}; use the folder names as they are given:\n\n{text}",
}


def agent(name, text):
    if not text.strip():
        try:
            text = subprocess.run(["wl-paste", "--no-newline"], capture_output=True, text=True, timeout=5).stdout
        except (OSError, subprocess.TimeoutExpired):
            text = ""
    if not text.strip():
        return {"question": "", "error": "nothing to work on: the field and the clipboard are empty"}
    lang = LANGS.get((os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or "en")[:2], "English")
    local = [p for p in providers() if p["id"] == "local"]
    pick = local[0] if local else (providers() or [None])[0]
    return {"question": AGENTS[name].format(lang=lang, home=os.path.expanduser("~"), text=text.strip()[:12000]), "provider": pick["id"] if pick else "",
            "model": pick["models"][0]["id"] if pick else ""}


def copilot(prompt, model, effort="", files=()):
    # prompt mode asks for no permission, so a tool that would change something is refused; no MCP servers of the user's
    if files:
        prompt += "\n\nAttached, in this folder: " + ", ".join(files)
    return ["copilot", "-p", SYSTEM + "\n\n" + prompt, "-s", "--disable-builtin-mcps", "--model", model or "auto"]


def copilot_usage():
    """What GitHub tells of the account's Copilot (what VS Code shows): {"chat": {"used", "resets"}, "completions": …}."""
    try:
        d = json.loads(subprocess.run(["gh", "api", "/copilot_internal/user"], capture_output=True, text=True, timeout=15).stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return {}
    resets = 0
    try:
        resets = int(datetime.datetime.fromisoformat(d.get("quota_reset_date", "") + "T00:00:00").timestamp())
    except ValueError:
        pass
    out = {}
    for k, q in (d.get("quota_snapshots") or {}).items():
        if k in ("chat", "completions") and not q.get("unlimited"):
            out[k] = {"used": round(1 - (q.get("percent_remaining", 100) / 100), 4), "resets": resets}
    return out


# ── what the services tell of the account, asked without a question (the way Omarchy's agents panel does; MIT) ──
USAGE_REUSE = 900                     # Anthropic refuses usage checks readily: an answer is good for a quarter of an hour
USAGE_REUSE_NEAR = 180                # …and for three minutes once a limit is 80 % used, when it matters (as Omarchy does)


def _remembered(name, fetch):
    """A service's answer, kept for USAGE_REUSE seconds and given again when a new one cannot be had."""
    cache = os.path.join(ROOM, "usage-%s.json" % name)
    try:
        with open(cache) as f:
            kept = json.load(f)
    except (OSError, ValueError):
        kept = {}
    near = any(isinstance(v, dict) and (v.get("used") or 0) >= 0.8 for v in (kept.get("limits") or {}).values())
    if kept.get("at", 0) > datetime.datetime.now().timestamp() - (USAGE_REUSE_NEAR if near else USAGE_REUSE) and kept.get("limits"):
        return kept["limits"]
    try:
        fresh = fetch()
    except Exception:                 # the service did not answer, or answered with something else: the last answer stays
        fresh = None
    if not fresh:
        return kept.get("limits") or {}
    os.makedirs(ROOM, exist_ok=True)
    with open(cache, "w") as f:
        json.dump({"at": datetime.datetime.now().timestamp(), "limits": fresh}, f)
    return fresh


def _when(iso):
    try:
        return int(datetime.datetime.fromisoformat(str(iso).replace("Z", "+00:00")).timestamp())
    except ValueError:
        return 0


def claude_usage():
    """The five hours and the week, from Anthropic's usage endpoint, with the sign-in Claude Code keeps. The token is
    read, used in the one request and nowhere written; when it has run out, Claude Code renews it the next time it runs."""
    def fetch():
        import urllib.request
        home = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
        with open(os.path.join(home, ".credentials.json")) as f:
            login = json.load(f).get("claudeAiOauth") or {}
        if (login.get("expiresAt") or 0) / 1000 < datetime.datetime.now().timestamp():
            return None
        req = urllib.request.Request("https://api.anthropic.com/api/oauth/usage", headers={
            "Authorization": "Bearer " + login.get("accessToken", ""), "anthropic-beta": "oauth-2025-04-20", "Accept": "application/json"})
        d = json.load(urllib.request.urlopen(req, timeout=10))
        out = {}
        for key, name in (("five_hour", "five_hour"), ("seven_day_oauth_apps", "seven_day"), ("seven_day", "seven_day")):
            b = d.get(key)
            if isinstance(b, dict) and b.get("utilization") is not None and name not in out:
                u = float(b["utilization"])
                out[name] = {"used": round(u / 100 if u > 1 else u, 4), "resets": _when(b.get("resets_at"))}
        return out
    return _remembered("claude", fetch)


def grok_usage():
    """The period's credits, from xAI's billing, with the sign-in Grok Build keeps."""
    def fetch():
        import urllib.request
        with open(os.path.join(os.environ.get("GROK_HOME") or os.path.expanduser("~/.grok"), "auth.json")) as f:
            login = next((v for v in json.load(f).values() if isinstance(v, dict)), {})
        req = urllib.request.Request("https://cli-chat-proxy.grok.com/v1/billing?format=credits",
                                     headers={"Authorization": "Bearer " + str(login.get("key", "")), "Accept": "application/json"})
        config = json.load(urllib.request.urlopen(req, timeout=10))["config"]
        period = config["currentPeriod"]
        return {"credits": {"used": round(float(config.get("creditUsagePercent") or 0) / 100, 4), "resets": _when(period.get("end")),
                            "week": "WEEK" in str(period.get("type"))}}
    return _remembered("grok", fetch)


def chatgpt_usage():
    """The five hours and the week of the ChatGPT plan, as Codex itself tells them: its app-server (read-only) asked for
    account/rateLimits/read over JSON-RPC, the way Omarchy's omarchy-agent-usage-codex does (MIT)."""
    def fetch():
        import select
        proc = subprocess.Popen([shutil.which("codex", path=SEARCH) or "codex", "-s", "read-only", "-a", "on-request", "app-server"],
                                stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, env=dict(os.environ, PATH=SEARCH))
        pending = b""

        def ask(n, method, params=None):
            nonlocal pending
            proc.stdin.write((json.dumps({"id": n, "method": method, "params": params or {}}) + "\n").encode())
            proc.stdin.flush()
            end = datetime.datetime.now().timestamp() + 8
            while datetime.datetime.now().timestamp() < end:
                while b"\n" in pending:            # replies and notifications can come in one write: split them here
                    line, pending = pending.split(b"\n", 1)
                    try:
                        m = json.loads(line)
                    except ValueError:
                        continue
                    if isinstance(m, dict) and m.get("id") == n:
                        return m
                if select.select([proc.stdout], [], [], 0.25)[0]:
                    chunk = os.read(proc.stdout.fileno(), 65536)
                    if not chunk:
                        return {}
                    pending += chunk
            return {}
        try:
            ask(1, "initialize", {"clientInfo": {"name": "latte-ai", "version": "1"}})
            proc.stdin.write((json.dumps({"method": "initialized", "params": {}}) + "\n").encode())
            proc.stdin.flush()
            limits = ((ask(2, "account/rateLimits/read").get("result") or {}).get("rateLimits")) or {}
        finally:
            proc.terminate()
            try:
                proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                proc.kill()
        out = {"plan": str(limits.get("planType") or "")} if limits else {}
        for w in (limits.get("primary"), limits.get("secondary")):
            if isinstance(w, dict) and w.get("usedPercent") is not None:
                name = "seven_day" if (w.get("windowDurationMins") or 0) >= 10080 else "five_hour"
                out[name] = {"used": round(float(w["usedPercent"]) / 100, 4), "resets": int(w.get("resetsAt") or 0)}
        return out
    return _remembered("chatgpt", fetch)


def claude_stats(days=7):
    """Tokens of the last days by day and model, from Claude Code's own transcripts (~/.claude/projects; LatteOS's
    questions to Claude are there too): a message counted once (its blocks repeat its usage), input, output and what went
    into the cache, not what was read from it again. Each file's sums are kept by its size, so only a changed one is read."""
    home = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
    since = datetime.datetime.now().timestamp() - (days + 1) * 86400
    cache_path = os.path.join(ROOM, "stats-claude.json")
    try:
        with open(cache_path) as f:
            cache = json.load(f)
    except (OSError, ValueError):
        cache = {}
    fresh = {}
    for path in glob.glob(os.path.join(home, "projects", "*", "*.jsonl")):
        try:
            st = os.stat(path)
        except OSError:
            continue
        if st.st_mtime < since:
            continue
        kept = cache.get(path)
        if kept and kept.get("s") == st.st_size:
            fresh[path] = kept
            continue
        sums, prompts, seen = {}, {}, set()
        with open(path, errors="replace") as f:
            for line in f:
                if '"usage"' not in line and '"promptId"' not in line:
                    continue
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                day = str(d.get("timestamp", ""))[:10]
                m = d.get("message") if isinstance(d.get("message"), dict) else {}
                if d.get("type") == "assistant" and m.get("usage") and m.get("id") not in seen:
                    seen.add(m.get("id"))
                    u = m["usage"]
                    n = (u.get("input_tokens") or 0) + (u.get("output_tokens") or 0) + (u.get("cache_creation_input_tokens") or 0)
                    by = sums.setdefault(day, {})
                    by[m.get("model", "")] = by.get(m.get("model", ""), 0) + n
                elif d.get("type") == "user" and d.get("promptId") and d["promptId"] not in seen:
                    seen.add(d["promptId"])
                    prompts[day] = prompts.get(day, 0) + 1
        fresh[path] = {"s": st.st_size, "days": sums, "prompts": prompts}
    os.makedirs(ROOM, exist_ok=True)
    with open(cache_path, "w") as f:
        json.dump(fresh, f)
    return fresh


SKILL_SHIPPED = "/usr/share/latteos/agents/skills/latteos"
SKILL_MINE = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "latteos", "skills", "latteos")
# where the agents look for skills (as Omarchy links its own): a tool's folder only when the tool is there
SKILL_HOMES = (("~/.claude", "skills"), ("~/.codex", "skills"), ("~/.gemini", "../.agents/skills"))


def skill(what):
    """LatteOS's skill for the agents: the user's own copy, made from LatteOS's and linked where each agent looks.
    install: the copy if there is none, and the links where there are none (a skill of the user's own of the same name
    is left alone); reset: LatteOS's own again, the user's kept beside it as SKILL.md.bak; path: where the copy is."""
    if what == "path":
        return os.path.join(SKILL_MINE, "SKILL.md")
    mine = os.path.join(SKILL_MINE, "SKILL.md")
    if what == "reset" and os.path.exists(mine):
        shutil.copy(mine, mine + ".bak")
    if what == "reset" or not os.path.exists(mine):
        os.makedirs(SKILL_MINE, exist_ok=True)
        shutil.copy(os.path.join(SKILL_SHIPPED, "SKILL.md"), mine)
    for home, sub in SKILL_HOMES:
        home = os.path.expanduser(home)
        if not os.path.isdir(home):
            continue
        where = os.path.normpath(os.path.join(home, sub))
        os.makedirs(where, exist_ok=True)
        link = os.path.join(where, "latteos")
        if not os.path.lexists(link):
            os.symlink(SKILL_MINE, link)
    return mine


# ── "Do it for me": a task for an agent, in a terminal the user sees (Omarchy's `omarchy agent prompt`, MIT, but never
# approving by itself): the agent plans first with LatteOS's skill and changes nothing until the user says yes there.
DOERS = {
    "claude": {"name": "Claude Code", "tool": "claude", "argv": lambda task: ["claude", "--permission-mode", "plan", task]},
    "chatgpt": {"name": "Codex", "tool": "codex", "argv": lambda task: ["codex", "-s", "read-only", "-a", "on-request", task]},
    "gemini": {"name": "Gemini", "tool": "gemini", "argv": lambda task: ["gemini", "--approval-mode", "default", "-i", task]},
}
LANGUAGES = {"sk": "Slovak", "cs": "Czech", "en": "English", "de": "German", "hu": "Hungarian", "pl": "Polish", "uk": "Ukrainian"}
DO_FIRST = ("Use the latteos skill. Look first, then make a plan and ask me before you change anything. "
            "Answer in %s. The task: ")


def first_words():
    code = (os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or "en").split("_")[0].split(".")[0]
    return DO_FIRST % LANGUAGES.get(code, "the language of the locale " + code)
IDEAS = [N("Make room on my disk: what fills it, and what can go?"), N("Why is my computer slow right now?"),
         N("Set up my second monitor"), N("Set up my printer"), N("Change the wallpaper with the time of day"),
         N("Explain what started with my computer today, and what I can turn off")]
AGENT_WORD = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "latteos", "agent")


def doers():
    """The agents that can do a task here, the user's chosen one first (~/.config/latteos/agent)."""
    try:
        with open(AGENT_WORD) as f:
            chosen = f.read().strip()
    except OSError:
        chosen = ""
    there = [i for i, d in DOERS.items() if shutil.which(d["tool"], path=SEARCH)]
    return sorted(there, key=lambda i: i != chosen)


def do(task, who=""):
    """Starts the agent on the task in a terminal; who: one of DOERS, else the chosen one."""
    can = doers()
    who = who if who in can else (can[0] if can else "")
    if not who:
        return {"ok": False, "agent": ""}
    argv = DOERS[who]["argv"](first_words() + task) if task.strip() else DOERS[who]["argv"]("")[:-1]
    argv[0] = shutil.which(argv[0], path=SEARCH) or argv[0]
    subprocess.Popen(["foot", "--title", DOERS[who]["name"], "--working-directory", os.path.expanduser("~"), "--"] + argv,
                     start_new_session=True, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     env=dict(os.environ, PATH=SEARCH))
    return {"ok": True, "agent": who}


# ── a crash, and why the session ended: the facts to an agent, which explains and changes nothing (Omarchy's
# diagnose-crash, MIT; GuardDog's notice and LatteOS SAFE ask for it)
def crash(pid):
    try:
        found = json.loads(subprocess.run(["coredumpctl", "list", "--json=short", "--no-pager", str(pid)],
                                          capture_output=True, text=True, timeout=20).stdout or "[]")
    except (OSError, ValueError, subprocess.TimeoutExpired):
        found = []
    c = found[-1] if found else {"exe": "?", "pid": pid, "sig": "?", "time": 0}
    at = datetime.datetime.fromtimestamp((c.get("time") or 0) / 1e6)
    task = ("The program %s (pid %s) crashed on %s with signal %s; systemd-coredump caught it. Find out what happened: "
            "`coredumpctl info %s`, the journal around that moment (`journalctl --since '%s' --until '%s'`), and whose it is "
            "(LatteOS's, Fedora's or an app's: `latte-guarddog crashes`). Tell me in plain words what happened, whether it is "
            "worth reporting and to whom, and what I can do. Do not change anything."
            % (c.get("exe"), c.get("pid"), at.strftime("%Y-%m-%d %H:%M:%S"), c.get("sig"), c.get("pid"),
               (at - datetime.timedelta(minutes=2)).strftime("%Y-%m-%d %H:%M:%S"), (at + datetime.timedelta(seconds=30)).strftime("%Y-%m-%d %H:%M:%S")))
    return do(task)


def why():
    task = ("My LatteOS desktop session ended and I am in the SAFE session. Find out why: `latte-safe why` (LatteOS's own "
            "note, and whyd's reading of the journal when it is installed), `journalctl -b -1 -p warning`, "
            "`coredumpctl list --since=-1d`. Tell me in plain words what happened and what I can do; change nothing "
            "without asking me first.")
    return do(task)


def agents():
    """What the services tell of the accounts and what was used, for LensAI's agents panel (Omarchy's, MIT):
    {"services": [{"id", "name", "style", "plan", "signed", "login", "limits": [{"label", "used", "resets"}], "asked"}],
     "stats": {"week", "today", "model", "busiest", "prompts", "sessions"}} — tokens of Claude Code's transcripts."""
    out = []
    for s in services():
        if not s["installed"] or s["local"]:
            continue
        told = {"claude": claude_usage, "chatgpt": chatgpt_usage, "grok": grok_usage, "copilot": copilot_usage}.get(s["id"], dict)() \
            if s["signed"] is not False else {}
        rows = []
        for key, label in (("five_hour", N("Session (5 h)")), ("seven_day", N("Week (7 days)")), ("chat", N("Credits (month)")),
                           ("completions", N("Suggestions in the editor"))):
            if isinstance(told.get(key), dict):
                rows.append({"label": label, "used": told[key].get("used", 0), "resets": told[key].get("resets", 0)})
        if isinstance(told.get("credits"), dict):
            c = told["credits"]
            rows.append({"label": N("Credits (week)") if c.get("week") else N("Credits (month)"), "used": c.get("used", 0), "resets": c.get("resets", 0)})
        plan = told.get("plan") or (s["account"].split(" · ")[-1] if " · " in s["account"] else "")
        out.append({"id": s["id"], "name": s["name"], "style": s["style"], "plan": plan, "account": s["account"], "signed": s["signed"],
                    "login": s["login"], "limits": rows, "asked": asked_this_month(s["id"])})
    today = datetime.date.today()
    week = {str(today - datetime.timedelta(days=i)) for i in range(7)}
    by_day, by_model, prompts, sessions = {}, {}, 0, 0
    for f in claude_stats().values():
        touched = False
        for day, models in f["days"].items():
            if day in week:
                for model, n in models.items():
                    by_day[day] = by_day.get(day, 0) + n
                    by_model[model] = by_model.get(model, 0) + n
            touched = touched or day == str(today)
        prompts += f["prompts"].get(str(today), 0)
        sessions += 1 if touched else 0
    stats = {"week": sum(by_day.values()), "today": by_day.get(str(today), 0),
             "model": max(by_model, key=by_model.get) if by_model else "", "busiest": max(by_day, key=by_day.get) if by_day else "",
             "prompts": prompts, "sessions": sessions}
    can = doers()
    return {"services": out, "stats": stats, "doers": [{"id": i, "name": DOERS[i]["name"]} for i in can], "ideas": IDEAS}


def asked_this_month(provider):
    month = datetime.datetime.now().strftime("%Y-%m")
    n = 0
    for path in glob.glob(os.path.join(CHATS, "*.json")):
        c = load(os.path.basename(path)[:-5]) or {}
        n += sum(1 for m in c.get("messages", []) if m.get("role") == "user" and m.get("provider") == provider and m.get("at", "").startswith(month))
    return n


def grok_models():
    try:
        out = subprocess.run(["grok", "models"], capture_output=True, text=True, timeout=20, env=dict(os.environ, PATH=SEARCH)).stdout
    except (OSError, subprocess.TimeoutExpired):
        return []
    found = [l.strip().lstrip("*").split()[0] for l in out.splitlines() if l.startswith("  ") and l.strip()]
    return [{"id": m, "name": m.replace("grok-", "Grok ")} for m in found]


def codex(prompt, model, effort="", files=()):
    # read-only: it may look, never write or run anything that changes the computer; ephemeral: not kept among the user's own
    pictures = [f for f in files if os.path.splitext(f)[1].lower() in (".png", ".jpg", ".jpeg", ".webp", ".gif")]
    others = [f for f in files if f not in pictures]
    if others:
        prompt += "\n\nAttached, in this folder: " + ", ".join(others)
    return ["codex", "exec", "--skip-git-repo-check", "--ephemeral", "--sandbox", "read-only"] + (["-m", model] if model else []) \
        + (["-c", "model_reasoning_effort=" + effort] if effort else []) + sum((["-i", f] for f in pictures), []) + [SYSTEM + "\n\n" + prompt]


def ollama(prompt, model, effort="", files=()):
    return ["ollama", "run", model, SYSTEM + "\n\n" + prompt]


def ollama_models():
    try:
        out = subprocess.run(["ollama", "list"], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return []
    return [{"id": l.split()[0], "name": l.split()[0]} for l in out.splitlines()[1:] if l.strip()]


