def turned_off():
    try:
        with open(os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "latteos", "ai")) as f:
            return f.read().strip() == "off"
    except OSError:
        return False


# ── the field's menus, each a copy of the service's own (the user's pictures, 21. 10.): + and its chip ───────────────
# LensGoo and LensAI draw them from here. A row: name, glyph (Tabler), "do" — what LatteOS does with it:
# {"attach": 0 file | 1 picture of the screen}, {"model": id}, {"effort": e}, {"think": true} (effort on or off),
# {"reset": true} (the field emptied), {"sub": [rows]} (a menu beside it); a row without "do" opens the service's page
# ("web"), drawn in one colour shared by all. desc under the name, hint after it, key at the right ("@effort": the
# effort chosen), sep a line before it, more a chevron, note a small text, on ticked whatever is chosen
WEB = {"claude": "https://claude.ai/new", "gemini": "https://gemini.google.com/app", "chatgpt": "https://chatgpt.com/",
       "grok": "https://grok.com/", "mistral": "https://chat.mistral.ai/chat", "copilot": "https://github.com/copilot",
       "deepseek": "https://chat.deepseek.com/"}


def _row(name, glyph=None, do=None, **o):
    r = dict(o, name=name)
    if glyph:
        r["glyph"] = glyph
    if do is not None:
        r["do"] = do
    return r


ATTACH, SHOT = {"attach": 0}, {"attach": 1}
PLUS = {
    "claude": [_row(N("Upload or add files"), "paperclip", ATTACH, key="Ctrl+U"), _row(N("Add folder"), "folder-plus"),
