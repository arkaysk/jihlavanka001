               _row(N("Guided learning"), "book-2")],
    "chatgpt": [_row(N("Add photos and files"), "paperclip", ATTACH, hint=N("Upload from the computer")),
                _row(N("Add from the library"), "books", hint=N("Browse and search your files")),
