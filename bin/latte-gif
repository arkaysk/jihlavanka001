#!/usr/bin/env python3
"""latte-gif: GIFs from the service the user chose, with the user's own key, for LensShore (Raycast's GIF Search).

  latte-gif search SOURCE [QUERY] [PAGE]   {"items": [{"id", "title", "preview", "full", "page"}], "more": true, "error": ""}
                                           with no query what is trending; 8 a page; "preview" a small GIF downloaded
  latte-gif get SOURCE ID URL              the whole GIF downloaded once (for pasting it as a picture): its path

SOURCE is giphy, tenor or klipy; the key is in LATTE_GIF_KEY (not on the command line, where any process could read it).
Nothing is asked of a service without a key. Kept in ~/.cache/latteos/gif/.
"""
import concurrent.futures, json, os, sys, urllib.error, urllib.parse, urllib.request

CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "latteos", "gif")
PER = 8
LANG = (os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or "en").split(".")[0]


def fetch(url):
    req = urllib.request.Request(url, headers={"User-Agent": "LatteOS"})
    with urllib.request.urlopen(req, timeout=12) as r:
        return r.read()


def giphy(key, q, page):
    args = {"api_key": key, "limit": PER, "offset": (page - 1) * PER, "rating": "pg-13"}
    if q:
        args.update(q=q, lang=LANG.split("_")[0])
    d = json.loads(fetch("https://api.giphy.com/v1/gifs/%s?%s" % ("search" if q else "trending", urllib.parse.urlencode(args))))
    items = []
    for g in d.get("data", []):
        im = g.get("images", {})
        items.append({"id": g.get("id", ""), "title": g.get("title", "") or g.get("slug", ""), "page": g.get("url", ""),
                      "small": (im.get("fixed_width_small") or im.get("fixed_width") or {}).get("url", ""),
                      "full": (im.get("downsized") or im.get("original") or {}).get("url", "")})
    total = (d.get("pagination") or {}).get("total_count", 0)
    return items, page * PER < total


def tenor(key, q, page):
    # Tenor counts by a position it hands back; pages before this one are walked to reach it
    pos, items, more = "", [], False
    for _ in range(page):
        args = {"key": key, "client_key": "latteos", "limit": PER, "media_filter": "gif,tinygif", "contentfilter": "medium", "locale": LANG}
        if q:
            args["q"] = q
        if pos:
            args["pos"] = pos
        d = json.loads(fetch("https://tenor.googleapis.com/v2/%s?%s" % ("search" if q else "featured", urllib.parse.urlencode(args))))
        pos = d.get("next", "")
        items = [{"id": g.get("id", ""), "title": g.get("content_description", ""), "page": g.get("itemurl", ""),
                  "small": g.get("media_formats", {}).get("tinygif", {}).get("url", ""),
                  "full": g.get("media_formats", {}).get("gif", {}).get("url", "")} for g in d.get("results", [])]
        more = bool(pos)
        if not pos:
            break
    return items, more


def klipy(key, q, page):
    args = {"page": page, "per_page": PER, "customer_id": "latteos", "locale": LANG.split("_")[0]}
    if q:
        args["q"] = q
    d = json.loads(fetch("https://api.klipy.com/api/v1/%s/gifs/%s?%s" % (urllib.parse.quote(key), "search" if q else "trending", urllib.parse.urlencode(args))))
    data = d.get("data") or {}
    items = []
    for g in data.get("data", []):
        f = g.get("file") or {}
        def url(size):
            return ((f.get(size) or {}).get("gif") or {}).get("url", "")
        items.append({"id": str(g.get("id", "")), "title": g.get("title", ""), "page": "https://klipy.com/gifs/%s" % g.get("slug", ""),
                      "small": url("xs") or url("sm"), "full": url("md") or url("hd")})
    return items, bool(data.get("has_next"))


SOURCES = {"giphy": giphy, "tenor": tenor, "klipy": klipy}


def keep(source, ident, url, size):
    """A GIF downloaded once into the cache; its path, "" if it could not be had."""
    if not url:
        return ""
    path = os.path.join(CACHE, "%s-%s-%s.gif" % (source, "".join(c for c in ident if c.isalnum() or c in "-_")[:80], size))
    if not os.path.exists(path):
        try:
            data = fetch(url)
        except OSError:
            return ""
        os.makedirs(CACHE, exist_ok=True)
        with open(path + ".part", "wb") as f:
            f.write(data)
        os.replace(path + ".part", path)
    return path


def main(a):
    key = os.environ.get("LATTE_GIF_KEY", "").strip()
    if len(a) >= 2 and a[0] == "search" and a[1] in SOURCES:
        if not key:
            print(json.dumps({"items": [], "more": False, "error": "key"}))
            return 1
        q = a[2] if len(a) > 2 else ""
        page = max(1, int(a[3])) if len(a) > 3 and a[3].isdigit() else 1
        try:
            items, more = SOURCES[a[1]](key, q, page)
        except urllib.error.HTTPError as e:
            print(json.dumps({"items": [], "more": False, "error": "key" if e.code in (401, 403) else str(e)[:200]}))
            return 1
        except (OSError, ValueError) as e:
            print(json.dumps({"items": [], "more": False, "error": str(e)[:200]}))
            return 1
        with concurrent.futures.ThreadPoolExecutor(8) as pool:
            previews = list(pool.map(lambda g: keep(a[1], g["id"], g["small"], "s"), items))
        out = [{"id": g["id"], "title": g["title"], "preview": p, "full": g["full"], "page": g["page"]} for g, p in zip(items, previews) if p]
        print(json.dumps({"items": out, "more": more, "error": ""}, ensure_ascii=False))
        return 0
    if len(a) == 4 and a[0] == "get" and a[1] in SOURCES:
        path = keep(a[1], a[2], a[3], "f")
        print(path)
        return 0 if path else 1
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
