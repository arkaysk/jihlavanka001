#!/usr/bin/env python3
"""latte-network: how this computer is connected, and what else is on its network. For the Device Manager.

  latte-network status         {"connections": [{"name", "type", "device", "ip", "prefix", "gateway", "dns": […], "mac",
                               "speed"}], "saved": [names]}: what NetworkManager and the kernel say
  latte-network scan           looks who is on the local network and prints
                               {"me": {"ip", "mac", "name"}, "gateway": ip, "network": id, "devices": [{"key", "ip", "mac",
                               "name", "given", "vendor", "kind", "online", "first", "last", "fresh", "router"}]}
                               kind: router · pc · phone · tv · audio · printer · nas · home (a smart-home thing) · device
                               fresh: it has not been seen on this network before this scan
  latte-network last           the last scan, at once, without looking again
  latte-network inspect        looks closer at every device that is there: which services answer, what it can do, and
                               what makes the network weaker, as the last scan plus, for each device, {"ports": […],
                               "caps": […], "upnp": {"name", "maker", "model", "type"}, "findings": [{"level", "what"}]},
                               and {"health": {"score", "findings": [{"level", "what", "ip", "fix"}]}}
                               caps: cast · airplay · play-to (DLNA renderer) · media (DLNA server) · camera · print ·
                               files · remote · smart-home · web · scan; level: high · medium · low · info
  latte-network dns            which name servers the active connections use: {"mode": auto|cloudflare|quad9|adguard|google|own,
                               "servers": […]}
  latte-network dns MODE [--dry-run]     every active connection asks those servers instead (auto: the router's
                               again); NetworkManager brings the connections up again, a moment without the network
  latte-network firewall       {"on", "zone", "services": […], "edited"}: whether firewalld guards this computer, in which zone,
                               and what that zone lets in as it comes (a zone the system changed cannot be read without root:
                               "edited" says so)
  latte-network watch          a scan, and a notification for each device never seen on this network before
                               (latte-netwatch.timer, every half hour in the session)
  latte-network name KEY NAME [KIND]     what the user calls a device, and what it is; empty NAME takes it back
  latte-network forget KEY               drops a device from what is remembered

`inspect` only does what any program on the network may do: it opens and closes a connection to a few well-known
ports, asks the devices that announce themselves (UPnP, ONVIF, NetBIOS) who they are, and asks a camera for its picture's
description without a password to tell whether it gives it to anyone. It changes nothing and logs in nowhere.

Looking is harmless and needs no password: every address of the local network is sent one empty packet, which
makes the kernel ask who has it (ARP); the neighbours it then knows are the devices. Their names come from what
they announce themselves (mDNS) and from the router (reverse DNS), the maker from the first half of the hardware
address (/usr/share/hwdata/oui.txt). Smart-home things are told by their Matter and Thread announcements; nothing
is paired with and nothing is asked of them. What was seen is remembered per network in
~/.local/state/latteos/network.json, so a device that is new can be told from one that is back.
"""
import ipaddress
import shutil
import json
import os
import re
import socket
import struct
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor

STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "latteos", "network.json")
# what a device announces, and what that makes it
SERVICES = {"_matter._tcp": "home", "_matterc._udp": "home", "_meshcop._udp": "home", "_hap._tcp": "home", "_homekit._tcp": "home",
            "_googlecast._tcp": "tv", "_airplay._tcp": "tv", "_raop._tcp": "audio", "_spotify-connect._tcp": "audio",
            "_ipp._tcp": "printer", "_ipps._tcp": "printer", "_pdl-datastream._tcp": "printer", "_printer._tcp": "printer",
            "_smb._tcp": "nas", "_afpovertcp._tcp": "nas", "_nfs._tcp": "nas", "_workstation._tcp": "pc", "_ssh._tcp": "pc",
            "_companion-link._tcp": "phone", "_apple-mobdev2._tcp": "phone", "_kdeconnect._udp": "phone"}


def out(*argv, timeout=8):
    try:
        return subprocess.run(argv, capture_output=True, text=True, timeout=timeout).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def load():
    try:
        with open(STATE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save(data):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE + ".new", "w") as f:
        json.dump(data, f)
    os.replace(STATE + ".new", STATE)


# ── how this computer is connected ───────────────────────────────────────────────────────────────────────────
def links():
    """The network cards that have an address, with their gateway: [{device, ip, prefix, gateway, mac, speed}]"""
    try:
        addrs = json.loads(out("ip", "-j", "-4", "addr", "show", "scope", "global") or "[]")
        routes = json.loads(out("ip", "-j", "route", "show", "default") or "[]")
    except ValueError:
        return []
    found = []
    for a in addrs:
        info = (a.get("addr_info") or [{}])[0]
        dev = a.get("ifname", "")
        mac, speed = "", 0
        try:
            with open("/sys/class/net/%s/address" % dev) as f:
                mac = f.read().strip()
            with open("/sys/class/net/%s/speed" % dev) as f:      # a wireless card has no such figure
                speed = int(f.read().strip())
        except (OSError, ValueError):
            pass
        found.append({"device": dev, "ip": info.get("local", ""), "prefix": info.get("prefixlen", 24), "mac": mac, "speed": max(speed, 0),
                      "gateway": next((r.get("gateway", "") for r in routes if r.get("dev") == dev), "")})
    return found


def status():
    by_device = {l["device"]: l for l in links()}
    active = []
    for line in out("nmcli", "-t", "-f", "NAME,TYPE,DEVICE", "connection", "show", "--active").splitlines():
        name, kind, dev = (line.rsplit(":", 2) + ["", ""])[:3]
        if dev in by_device:
            dns = re.findall(r"IP4\.DNS\[\d+\]:(\S+)", out("nmcli", "-t", "-f", "IP4.DNS", "device", "show", dev))
            active.append(dict(by_device[dev], name=name, type="wifi" if "wireless" in kind else ("wired" if "ethernet" in kind else kind), dns=dns))
    saved = [l.rsplit(":", 1)[0] for l in out("nmcli", "-t", "-f", "NAME,TYPE", "connection", "show").splitlines() if not l.endswith(":loopback")]
    return {"connections": active, "saved": saved}


# ── which name servers: one choice that protects the whole computer ──────────────────────────────────────────
# Quad9 blocks addresses known to spread malware, AdGuard also ads and trackers; Cloudflare is quick and keeps no logs.
DNS = {"cloudflare": ["1.1.1.1", "1.0.0.1"], "quad9": ["9.9.9.9", "149.112.112.112"], "adguard": ["94.140.14.14", "94.140.15.15"],
       "google": ["8.8.8.8", "8.8.4.4"]}


def active_connections():
    return [l.rsplit(":", 1)[0] for l in out("nmcli", "-t", "-f", "NAME,TYPE", "connection", "show", "--active").splitlines()
            if not l.endswith((":loopback", ":bridge", ":tun"))]


def dns():
    names = active_connections()
    servers = []
    for n in names:
        servers += [x for x in out("nmcli", "-g", "ipv4.dns", "connection", "show", n).strip().replace(" ", ",").split(",") if x]
    mode = "auto" if not servers else next((k for k, v in DNS.items() if servers[:len(v)] == v), "own")
    return {"mode": mode, "servers": servers, "connections": names}


def set_dns(mode, dry=False):
    """The commands that put every active connection on these name servers, run unless it is a dry run."""
    plan = []
    for n in active_connections():
        if mode == "auto":
            plan.append(["nmcli", "connection", "modify", n, "ipv4.dns", "", "ipv4.ignore-auto-dns", "no"])
        else:
            plan.append(["nmcli", "connection", "modify", n, "ipv4.dns", " ".join(DNS[mode]), "ipv4.ignore-auto-dns", "yes"])
        plan.append(["nmcli", "connection", "up", n])
    if not dry:
        for argv in plan:
            if subprocess.run(argv, capture_output=True, timeout=60).returncode != 0:
                return {"ok": False, "plan": plan}
    return {"ok": True, "plan": plan}


# ── who else is there ────────────────────────────────────────────────────────────────────────────────────────
def knock(network, me):
    """One empty packet to every address: nothing answers it, but the kernel has to find out who has the address."""
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
        s.setblocking(False)
        for host in network.hosts():
            if str(host) != me:
                try:
                    s.sendto(b"", (str(host), 9))
                except OSError:
                    pass


def neighbours(device):
    try:
        return {n["dst"]: n["lladdr"].lower() for n in json.loads(out("ip", "-j", "neigh", "show", "dev", device) or "[]")
                if n.get("lladdr") and "FAILED" not in n.get("state", []) and ":" not in n["dst"]}
    except ValueError:
        return {}


def name_at(packet, at, depth=0):
    """A name in a DNS packet, which may go on somewhere else in it: (the name, where reading goes on)."""
    parts, after = [], None
    while at < len(packet) and depth < 12:
        n = packet[at]
        if n == 0:
            at += 1
            break
        if n >= 0xC0:
            after = after or at + 2
            at = ((n & 0x3F) << 8) | packet[at + 1]
            depth += 1
            continue
        parts.append(packet[at + 1:at + 1 + n].decode("utf-8", "replace"))
        at += 1 + n
    return ".".join(parts), after or at


def announced(wait=2.2):
    """What the devices on the network say of themselves: {ip: {"kinds": {…}, "name": …}}"""
    q = b"\x00\x00\x00\x00" + struct.pack(">HHHH", len(SERVICES), 0, 0, 0)
    for service in SERVICES:
        q += b"".join(bytes([len(p)]) + p.encode() for p in (service + ".local").split(".")) + b"\x00" + struct.pack(">HH", 12, 1)
    found = {}
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, 255)
        s.settimeout(0.3)
        s.sendto(q, ("224.0.0.251", 5353))
    except OSError:
        return found
    end = time.monotonic() + wait
    while time.monotonic() < end:
        try:
            packet, (ip, _) = s.recvfrom(9000)
        except socket.timeout:
            continue
        except OSError:
            break
        try:
            questions, answers, authority, extra = struct.unpack(">HHHH", packet[4:12])
            at = 12
            for _ in range(questions):
                at = name_at(packet, at)[1] + 4
            seen = found.setdefault(ip, {"kinds": set(), "name": ""})
            for _ in range(answers + authority + extra):
                name, at = name_at(packet, at)
                kind, _, _, length = struct.unpack(">HHIH", packet[at:at + 10])
                at += 10
                for service, what in SERVICES.items():
                    if name.startswith(service) or ("." + service) in name:
                        seen["kinds"].add(what)
                if kind == 12 and not seen["name"]:                       # PTR: "Living room TV._airplay._tcp.local"
                    target = name_at(packet, at)[0]
                    if "._" in target:
                        seen["name"] = target.split("._")[0]
                elif kind == 1 and name.endswith(".local") and not seen["name"]:      # A: "kitchen-speaker.local"
                    seen["name"] = name[:-6]
                at += length
        except (struct.error, IndexError):
            pass
    s.close()
    return found


MAKERS = {}


def maker(mac):
    """Who made the network card, from the first half of its address; nothing for an address a phone made up."""
    if int(mac[1], 16) & 2:
        return ""                                   # locally administered: a private address, it names nobody
    if not MAKERS:
        try:
            with open("/usr/share/hwdata/oui.txt", errors="replace") as f:
                for line in f:
                    m = re.match(r"([0-9A-F]{6})\s+\(base 16\)\s+(.+)", line)
                    if m:
                        MAKERS[m.group(1)] = m.group(2).strip()
        except OSError:
            MAKERS["-"] = ""
    name = MAKERS.get(mac.replace(":", "").upper()[:6], "")
    return re.sub(r",? (Inc\.?|Corporation|Corp\.?|Co\.,? ?Ltd\.?|Ltd\.?|GmbH|LLC|Technologies|Technology|Electronics|International).*$", "", name, flags=re.I)


def kind_of(kinds, vendor, name):
    for k in ("home", "printer", "tv", "audio", "nas", "phone", "pc"):
        if k in kinds:
            return k
    text = (vendor + " " + name).lower()
    for k, words in (("phone", "iphone|ipad|android|galaxy|pixel|xiaomi|huawei|oneplus"), ("tv", "tv|chromecast|roku|bravia"),
                     ("printer", "printer|laserjet|epson|brother|canon"), ("audio", "sonos|speaker|denon|yamaha"),
                     ("home", "espressif|tuya|shelly|philips lighting|ikea|aqara|nest|ring"), ("nas", "synology|qnap|nas")):
        if re.search(words, text):
            return k
    return "device"


def scan():
    mine = next((l for l in links() if l["gateway"]), None)
    if not mine:
        return {"me": None, "gateway": "", "network": "", "devices": [], "offline": True}
    network = ipaddress.ip_network("%s/%s" % (mine["ip"], mine["prefix"]), strict=False)
    if network.num_addresses <= 1024:               # a home network; a bigger one is not swept address by address
        knock(network, mine["ip"])
    with ThreadPoolExecutor(1) as pool:
        said = pool.submit(announced)
        time.sleep(1.2)
        near = neighbours(mine["device"])
        said = said.result()
    names = {}
    def lookup(ip):
        try:
            name = socket.gethostbyaddr(ip)[0].split(".")[0]
            return ip, "" if name.startswith("_") else name      # "_gateway" is the resolver's own word, not the router's
        except OSError:
            return ip, ""
    socket.setdefaulttimeout(1.5)
    with ThreadPoolExecutor(16) as pool:
        names = dict(pool.map(lookup, near))
    gateway_mac = near.get(mine["gateway"], "")
    net_id = gateway_mac or str(network)
    data = load()
    known = data.setdefault(net_id, {})
    now = int(time.time())
    for ip, mac in near.items():
        d = known.get(mac)
        fresh = d is None
        d = known.setdefault(mac, {"first": now})
        about = said.get(ip, {"kinds": set(), "name": ""})
        vendor = maker(mac)
        d.update(ip=ip, last=now, vendor=vendor, name=about["name"] or names.get(ip, "") or d.get("name", ""),
                 kind="router" if ip == mine["gateway"] else kind_of(about["kinds"], vendor, about["name"] or names.get(ip, "")), fresh=fresh)
    save(data)
    return answer(mine, net_id, known, set(near.values()))


def answer(mine, net_id, known, online):
    devices = [{"key": mac, "ip": d.get("ip", ""), "mac": mac, "name": d.get("given") or d.get("name", ""), "given": d.get("given", ""),
                "vendor": d.get("vendor", ""), "kind": d.get("given_kind") or d.get("kind", "device"), "online": mac in online,
                "first": d.get("first", 0), "last": d.get("last", 0), "fresh": bool(d.get("fresh")) and mac in online,
                "router": d.get("kind") == "router", "ports": d.get("ports", []), "services": [PORTS[p][0] for p in d.get("ports", []) if p in PORTS],
                "caps": d.get("caps", []), "upnp": d.get("upnp", {})} for mac, d in known.items()]
    devices.sort(key=lambda d: (not d["router"], not d["online"], [int(p) for p in d["ip"].split(".")] if d["ip"] else [999]))
    health = load().get("_health", {}).get(net_id)
    return {"health": health,"me": {"ip": mine["ip"], "mac": mine["mac"], "name": socket.gethostname()} if mine else None,
            "gateway": mine["gateway"] if mine else "", "network": net_id, "devices": devices}


def last():
    mine = next((l for l in links() if l["gateway"]), None)
    data = load()
    if not mine:
        return {"me": None, "gateway": "", "network": "", "devices": [], "offline": True}
    near = neighbours(mine["device"])
    net_id = near.get(mine["gateway"], "") or next((k for k in data if not k.startswith("_")), "")
    return answer(mine, net_id, data.get(net_id, {}), set())


def remember(key, change):
    data = load()
    for known in data.values():
        if key in known:
            change(known, key)
    save(data)


def firewall():
    on = out("systemctl", "is-active", "firewalld").strip() == "active"
    zone = ""
    for line in out("firewall-cmd", "--get-active-zones").splitlines():
        if line and not line.startswith(" "):
            zone = line.split()[0]
            break
    services, edited = [], os.path.exists("/etc/firewalld/zones/%s.xml" % zone) if zone else False
    try:
        with open("/usr/lib/firewalld/zones/%s.xml" % zone) as f:
            services = re.findall(r'<service name="([^"]+)"', f.read())
    except OSError:
        pass
    if not edited and zone:
        try:
            os.listdir("/etc/firewalld/zones")
        except PermissionError:
            edited = None                     # cannot be told without root
        except OSError:
            pass
    return {"on": on, "zone": zone, "services": [x for x in services if x != "dhcpv6-client"], "edited": edited}


def tr(text):
    """What the screen says, in the desktop's language: the same table as the scenes' (goo/lang/LANG.plm)."""
    lang = (os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or "en")[:2]
    try:
        with open(os.path.join(os.environ.get("LATTE_SHARE") or "/usr/share/latteos", "goo", "lang", lang + ".plm"), encoding="utf-8") as f:
            m = re.search(r'^\s*"%s"\s*=\s*"((?:[^"\\]|\\.)*)"' % re.escape(text), f.read(), re.M)
            return m.group(1) if m else text
    except OSError:
        return text


def watch():
    found = scan()
    for d in found["devices"]:
        if d["fresh"] and shutil.which("notify-send"):
            subprocess.run(["notify-send", "-a", "LatteOS", "-i", "network-wired", tr("A new device on the network"),
                            "%s  ·  %s" % (d["name"] or d["vendor"] or tr("Unknown device"), d["ip"])], timeout=10)
    return found


# ── a closer look: what each device serves, what it can do, and what makes the network weaker ────────────────
# well-known ports, what is behind them, what that lets the device do
PORTS = {21: ("ftp", "files"), 22: ("ssh", "remote"), 23: ("telnet", "remote"), 53: ("dns", ""), 80: ("http", "web"), 139: ("netbios", "files"),
         443: ("https", "web"), 445: ("smb", "files"), 515: ("lpd", "print"), 554: ("rtsp", "camera"), 631: ("ipp", "print"), 1400: ("sonos", "play-to"),
         1883: ("mqtt", "smart-home"), 2020: ("onvif-tapo", "camera"), 3389: ("rdp", "remote"), 5000: ("upnp-http", "web"), 5900: ("vnc", "remote"),
         7000: ("airplay", "airplay"), 8008: ("cast", "cast"), 8009: ("cast", "cast"), 8080: ("http-alt", "web"), 8200: ("dlna", "media"),
         8443: ("https-alt", "web"), 9100: ("printer", "print"), 32400: ("plex", "media")}
# what an open port says about the network's safety, and what to do about it
WEAK = {"telnet": ("high", "Telnet is open: passwords travel unencrypted", "Turn Telnet off on the device; use SSH or its app instead."),
        "ftp": ("medium", "FTP is open: files and passwords travel unencrypted", "Turn FTP off, or use SFTP."),
        "rdp": ("medium", "Remote desktop (RDP) is open to the network", "Allow remote desktop only when needed, with a strong password."),
        "vnc": ("medium", "VNC remote screen is open to the network", "Give VNC a password, or turn it off."),
        "mqtt": ("medium", "An MQTT broker answers without encryption", "Give the broker a password and TLS, or keep it on a separate network."),
        "netbios": ("low", "Old Windows file sharing (NetBIOS) is on", "Turn NetBIOS off where SMB alone will do.")}


def open_ports(ip, wait=0.5):
    def try_port(port):
        with socket.socket() as c:
            c.settimeout(wait)
            return port if c.connect_ex((ip, port)) == 0 else None
    with ThreadPoolExecutor(len(PORTS)) as pool:
        return sorted(p for p in pool.map(try_port, PORTS) if p)


def ssdp(wait=2.5):
    """Who answers a UPnP search: {ip: {"name", "maker", "model", "type"}} from each device's own description."""
    import urllib.request
    q = ("M-SEARCH * HTTP/1.1\r\nHOST: 239.255.255.250:1900\r\nMAN: \"ssdp:discover\"\r\nMX: 2\r\nST: ssdp:all\r\n\r\n").encode()
    where = {}
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, 2)
        s.settimeout(0.3)
        s.sendto(q, ("239.255.255.250", 1900))
    except OSError:
        return {}
    end = time.monotonic() + wait
    while time.monotonic() < end:
        try:
            data, (ip, _) = s.recvfrom(4096)
        except socket.timeout:
            continue
        except OSError:
            break
        m = re.search(rb"(?im)^location:\s*(\S+)", data)
        if m:
            where.setdefault(ip, set()).add(m.group(1).decode(errors="replace"))
    s.close()
    found = {}
    for ip, urls in where.items():
        info = {"name": "", "maker": "", "model": "", "types": []}
        for url in list(urls)[:4]:
            try:
                xml = urllib.request.urlopen(url, timeout=3).read(65536).decode(errors="replace")
            except (OSError, ValueError):
                continue
            for key, tag in (("name", "friendlyName"), ("maker", "manufacturer"), ("model", "modelName")):
                m = re.search(r"<%s>([^<]+)</%s>" % (tag, tag), xml)
                if m and not info[key]:
                    info[key] = m.group(1).strip()
            info["types"] += re.findall(r"<deviceType>urn:[^:]+:device:([^:<]+)", xml)
        found[ip] = info
    return found


def onvif(wait=2.5):
    """Cameras that answer an ONVIF WS-Discovery probe: the set of their addresses."""
    import uuid
    probe = ('<?xml version="1.0" encoding="UTF-8"?><e:Envelope xmlns:e="http://www.w3.org/2003/05/soap-envelope" '
             'xmlns:w="http://schemas.xmlsoap.org/ws/2004/08/addressing" xmlns:d="http://schemas.xmlsoap.org/ws/2005/04/discovery" '
             'xmlns:dn="http://www.onvif.org/ver10/network/wsdl"><e:Header><w:MessageID>uuid:%s</w:MessageID>'
             '<w:To>urn:schemas-xmlsoap-org:ws:2005:04:discovery</w:To><w:Action>http://schemas.xmlsoap.org/ws/2005/04/discovery/Probe</w:Action>'
             '</e:Header><e:Body><d:Probe><d:Types>dn:NetworkVideoTransmitter</d:Types></d:Probe></e:Body></e:Envelope>') % uuid.uuid4()
    found = set()
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, 2)
        s.settimeout(0.3)
        s.sendto(probe.encode(), ("239.255.255.250", 3702))
    except OSError:
        return found
    end = time.monotonic() + wait
    while time.monotonic() < end:
        try:
            data, (ip, _) = s.recvfrom(65536)
            if b"ProbeMatch" in data:
                found.add(ip)
        except socket.timeout:
            continue
        except OSError:
            break
    s.close()
    return found


def netbios(ip):
    """The name a Windows computer gives itself (a NetBIOS node status question), or ""."""
    q = b"\x13\x37\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x20" + b"CK" + b"A" * 30 + b"\x00\x00\x21\x00\x01"
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
            s.settimeout(1.0)
            s.sendto(q, (ip, 137))
            data = s.recv(2048)
        count = data[56]
        for i in range(count):
            name = data[57 + i * 18:57 + i * 18 + 15].decode(errors="replace").strip()
            kind, flags = data[57 + i * 18 + 15], data[57 + i * 18 + 16]
            if kind == 0 and not flags & 0x80:
                return name
    except (OSError, IndexError):
        pass
    return ""


def rtsp_open(ip, port=554):
    """Whether a camera describes its picture to anyone, without a password (an RTSP DESCRIBE with no credentials)."""
    try:
        with socket.create_connection((ip, port), timeout=2) as c:
            c.sendall(("DESCRIBE rtsp://%s:%d/ RTSP/1.0\r\nCSeq: 1\r\nAccept: application/sdp\r\n\r\n" % (ip, port)).encode())
            first = c.recv(256).decode(errors="replace").split("\r\n")[0]
        return " 200 " in first
    except OSError:
        return False


def look_closer(d, upnp, cams):
    """The ports, what the device can do, and what is weak about it, from what it answered."""
    ports = open_ports(d["ip"])
    names = [PORTS[p][0] for p in ports]
    caps = sorted({PORTS[p][1] for p in ports if PORTS[p][1]})
    info = upnp.get(d["ip"])
    types = info["types"] if info else []
    if "MediaRenderer" in types:
        caps.append("play-to")
    if "MediaServer" in types:
        caps.append("media")
    if d["ip"] in cams:
        caps.append("camera")
    findings = []
    for n in names:
        if n in WEAK:
            level, what, fix = WEAK[n]
            findings.append({"level": level, "what": what, "fix": fix})
    rtsp = next((p for p in ports if PORTS[p][0] == "rtsp"), None)
    if rtsp and rtsp_open(d["ip"], rtsp):
        findings.append({"level": "high", "what": "The camera gives its picture to anyone on the network, without a password",
                         "fix": "Set a password for the camera's stream in its app."})
    if d.get("router") and "InternetGatewayDevice" in types:
        findings.append({"level": "medium", "what": "UPnP is on in the router: any device can open a door to the internet by itself",
                         "fix": "Turn UPnP off in the router's settings, unless a game console needs it."})
    if "web" in caps and 80 in ports and 443 not in ports and 8443 not in ports and (d.get("router") or "camera" in caps):
        findings.append({"level": "low", "what": "Its settings page is not encrypted (http)", "fix": "Use the device's app, or turn on https if it has it."})
    if d.get("fresh"):
        findings.append({"level": "info", "what": "A device not seen on this network before", "fix": "If you do not know it, name it, or block it in the router."})
    return {"ports": ports, "services": names, "caps": sorted(set(caps)), "findings": findings,
            "upnp": {k: info[k] for k in ("name", "maker", "model")} if info else {}, "types": types}


KIND_BY_CAPS = (("camera", "camera"), ("print", "printer"), ("cast", "tv"), ("airplay", "tv"), ("play-to", "tv"), ("smart-home", "home"),
                ("media", "nas"))


def inspect():
    found = scan()
    if not found["devices"]:
        return found
    with ThreadPoolExecutor(2) as pool:
        upnp, cams = pool.submit(ssdp), pool.submit(onvif)
        upnp, cams = upnp.result(), cams.result()
    live = [d for d in found["devices"] if d["online"]]
    with ThreadPoolExecutor(8) as pool:
        closer = dict(zip([d["key"] for d in live], pool.map(lambda d: look_closer(d, upnp, cams), live)))
        names = dict(zip([d["key"] for d in live], pool.map(lambda d: netbios(d["ip"]), live)))
    data = load()
    known = data.get(found["network"], {})
    health = []
    for d in found["devices"]:
        c = closer.get(d["key"])
        if not c:
            continue
        d.update(c)
        if not d["name"]:
            d["name"] = c["upnp"].get("name") or names.get(d["key"], "")
        if d["kind"] in ("device", "pc") and not d.get("given"):
            d["kind"] = next((k for cap, k in KIND_BY_CAPS if cap in c["caps"]), d["kind"])
        k = known.get(d["key"])
        if k is not None:
            k.update(ports=c["ports"], caps=c["caps"], upnp=c["upnp"], name=k.get("name") or d["name"], kind=k.get("kind") if k.get("kind") == "router" else d["kind"])
        for f in c["findings"]:
            health.append(dict(f, ip=d["ip"], device=d["name"] or d["vendor"] or d["ip"]))
    save(data)
    # the score: a hundred, less for every weakness by how much it weighs
    score = max(0, 100 - sum({"high": 25, "medium": 10, "low": 3, "info": 0}[f["level"]] for f in health))
    order = {"high": 0, "medium": 1, "low": 2, "info": 3}
    found["health"] = {"score": score, "findings": sorted(health, key=lambda f: order[f["level"]]), "when": int(time.time())}
    data = load()
    data.setdefault("_health", {})[found["network"]] = found["health"]      # the last closer look stays to be shown again
    save(data)
    return found


def main(a):
    if a == ["status"]:
        print(json.dumps(status(), ensure_ascii=False))
    elif a == ["scan"]:
        print(json.dumps(scan(), ensure_ascii=False))
    elif a == ["firewall"]:
        print(json.dumps(firewall(), ensure_ascii=False))
    elif a == ["watch"]:
        watch()
    elif a == ["dns"]:
        print(json.dumps(dns(), ensure_ascii=False))
    elif a[:1] == ["dns"] and len(a) in (2, 3) and (a[1] == "auto" or a[1] in DNS):
        print(json.dumps(set_dns(a[1], a[2:] == ["--dry-run"]), ensure_ascii=False))
    elif a == ["inspect"]:
        print(json.dumps(inspect(), ensure_ascii=False))
    elif a == ["last"]:
        print(json.dumps(last(), ensure_ascii=False))
    elif a[:1] == ["name"] and len(a) in (3, 4):
        def change(known, key):
            known[key]["given"] = a[2].strip()
            if len(a) == 4: known[key]["given_kind"] = a[3]
        remember(a[1].lower(), change)
    elif a[:1] == ["forget"] and len(a) == 2:
        remember(a[1].lower(), lambda known, key: known.pop(key))
    else:
        print(__doc__.strip())
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
