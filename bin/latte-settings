#!/usr/bin/env python3
"""latte-settings: finds a page of the Settings by what it is about. For LensGoo, which offers settings under the apps.

  latte-settings find TEXT      [{"area", "page", "name", "area_name", "icon"}] — the pages whose name or keywords
                                have every word of TEXT, in the user's language or in English; the best first
  latte-settings pages          every page, the same way
  latte-settings wallpapers     the pictures and the films a desktop can have behind it: [{"path", "live", "own"}] —
                                LatteOS's own, then what is in the user's Pictures and Videos folders (and in a
                                folder Wallpapers in either); live: it is a film
  latte-settings sound          {"outputs": […], "inputs": […]}: each {"name", "label", "volume" 0…1.5, "muted", "default"}
  latte-settings defaults       which app opens what: [{"kind", "current", "apps": [{"id", "name", "icon"}]}] for the
                                kinds browser, mail, files, images, video, music, text, pdf
  latte-settings default KIND APP.desktop     makes that app the one for everything of the kind
  latte-settings region         {"lang", "formats", "locales": [{"id", "name", "place"}]}: the languages this system
                                has, each named in itself; formats is "" when they follow the language
  latte-settings locale LANG [FORMATS]        the user's language, and whose dates, numbers and money (from next login)
  latte-settings time           {"zone", "auto", "zones": […]}: the time zone, whether the clock sets itself
  latte-settings keyboard       {"current": ["sk", "us:intl"], "layouts": [{"id", "name"}]}: a layout is LAYOUT or
                                LAYOUT:VARIANT, named in the user's language
  latte-settings keyboard ID…   the user's layouts, the first is the one typed in; at once and from next login
  latte-settings storage        {"disks": [{"mount", "device", "kind", "size", "used"}]} in bytes, a disk once
  latte-settings sizes          {"folders": [{"id", "path", "size"}], "trash", "cache"}: how much the user's own
                                folders hold, in bytes; it reads them all, so it takes a while
  latte-settings account        {"uid", "user", "name", "picture"}: who the user is to the system
  latte-settings password       changes the user's own password to the one on standard input (never an argument);
                                the system asks for the present one itself. Prints {"ok"} or {"ok": false, "error"}
  latte-settings icons          {"chosen", "sets": [{"id", "name", "folder", "file", "trash"}]}: the icon sets this
                                system has, each with three of its pictures, and the one in use
  latte-settings icons ID       makes that set the one files and apps are shown with (LatteOS's own apps, the
                                desktop, and apps that follow the system's setting)
  latte-settings loginscreen    {"panel", "news_url", "place", "lat", "lon"}: what the login screen shows (login.conf)
  latte-settings loginscreen panel news|none     what is under the surface when nothing crashed
  latte-settings loginscreen news URL…           the feeds, RSS or Atom, one or more (empty: none)
  latte-settings loginscreen place NAME          looks the place up and sets it; prints {"ok", "place"} (empty: no weather)

The user's choices are kept in ~/.config/latteos/: `locale` and `keyboard` are read by latte-session when it starts.

A page is opened with `latte-app settings PAGE`. The pages are listed in apps/settings/pages.json, the one list the
Settings app itself is built from.
"""
import json
import os
import re
import subprocess
import sys
import unicodedata

SHARE = os.environ.get("LATTE_SHARE") or "/usr/share/latteos"


CONFIG = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "latteos")


def out(*argv, timeout=8, **env):
    try:
        return subprocess.run(argv, capture_output=True, text=True, timeout=timeout, env=dict(os.environ, **env) if env else None).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def kept(name):
    """What a file of the user's choices says: {"KEY": "value"} of its KEY=value lines."""
    try:
        with open(os.path.join(CONFIG, name), encoding="utf-8") as f:
            return dict(re.findall(r"^(\w+)=(.*)$", f.read(), re.M))
    except OSError:
        return {}


def keep(name, values):
    os.makedirs(CONFIG, exist_ok=True)
    with open(os.path.join(CONFIG, name), "w", encoding="utf-8") as f:
        f.write("".join("%s=%s\n" % kv for kv in values.items()))


def plain(s):
    # no accents, no case, and y as i (Slovak and Czech write the same sound both ways: "prostredye")
    return "".join(c for c in unicodedata.normalize("NFD", s.lower()) if not unicodedata.combining(c)).replace("y", "i")


def close(a, b):
    """a and b differ by at most one letter: one more, one fewer, one other, or two swapped."""
    if abs(len(a) - len(b)) > 1:
        return False
    if a == b:
        return True
    i = 0
    while i < min(len(a), len(b)) and a[i] == b[i]:
        i += 1
    return (a[i + 1:] == b[i + 1:] or a[i:] == b[i + 1:] or a[i + 1:] == b[i:]
            or (i + 1 < min(len(a), len(b)) and a[i] == b[i + 1] and a[i + 1] == b[i] and a[i + 2:] == b[i + 2:]))


def near(word, hay):
    """The word is in the text, or a word of it begins with something one slip away from it (from four letters)."""
    if word in hay:
        return True
    if len(word) < 4:
        return False
    for token in hay.split():
        for n in (len(word) - 1, len(word), len(word) + 1):
            if close(word, token[:n]):
                return True
    return False


def words():
    """The user's language: {"English": "translation"} from the table the whole desktop uses."""
    lang = (os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or "").split("_")[0].split(".")[0]
    try:
        with open(os.path.join(SHARE, "goo", "lang", lang + ".plm"), encoding="utf-8") as f:
            return dict(re.findall(r'^\s*"((?:[^"\\]|\\.)*)"\s*=\s*"((?:[^"\\]|\\.)*)"\s*$', f.read(), re.M))
    except OSError:
        return {}


def pages():
    with open(os.path.join(SHARE, "apps", "settings", "pages.json"), encoding="utf-8") as f:
        areas = json.load(f)
    tr = words()
    return [{"area": a["id"], "page": p["id"], "name": tr.get(p["name"], p["name"]), "area_name": tr.get(a["name"], a["name"]), "icon": p["icon"],
             "hay": plain(" ".join([p["name"], tr.get(p["name"], ""), a["name"], tr.get(a["name"], ""), p.get("words", ""), tr.get(p.get("words", ""), "")]))}
            for a in areas for p in a["pages"]]


def find(text):
    # a word is looked for by its beginning, so that "klavesove skratky" finds "Klavesnica a skratky": inflected
    # endings do not matter (ponytail: a crude stem, five letters; a real stemmer when a language needs one); a slip of
    # a letter does not matter either (near)
    asked = [w[:5] for w in plain(text).split()]
    found = [p for p in pages() if asked and all(near(w, p["hay"]) for w in asked)]
    # the page that is named for it first, then those that only have it among their words
    found.sort(key=lambda p: (not plain(p["name"]).startswith(asked[0]) if asked else 0, not all(near(w, plain(p["name"])) for w in asked), p["name"]))
    return found


def wallpapers():
    import glob
    import subprocess
    found = [{"path": p, "live": False, "own": False} for p in sorted(glob.glob(os.path.join(SHARE, "wallpapers", "*")))]
    for kind, still in (("PICTURES", True), ("VIDEOS", False)):
        try:
            folder = subprocess.run(["xdg-user-dir", kind], capture_output=True, text=True, timeout=5).stdout.strip()
        except (OSError, subprocess.TimeoutExpired):
            folder = ""
        if not folder or folder == os.path.expanduser("~"):
            continue
        ends = (".jpg", ".jpeg", ".png", ".webp") if still else (".mp4", ".webm", ".mkv", ".mov")
        files = [p for d in (folder, os.path.join(folder, "Wallpapers")) for p in sorted(glob.glob(os.path.join(d, "*"))) if p.lower().endswith(ends)]
        if still:       # the library of wallpapers holds films too: what was fetched from the internet lands there
            files += [p for p in sorted(glob.glob(os.path.join(folder, "Wallpapers", "*"))) if p.lower().endswith((".mp4", ".webm", ".mkv", ".mov"))]
        found += [{"path": p, "live": not p.lower().endswith((".jpg", ".jpeg", ".png", ".webp")), "own": True} for p in files[:60]]
    # LatteOS's own are copied into that library for the picker (bin/latte-wall): shown once
    def same(p):
        try:
            return (os.path.basename(p), os.path.getsize(p))
        except OSError:
            return (p, -1)
    ours = {same(w["path"]) for w in found if not w["own"]}
    return [w for w in found if not (w["own"] and same(w["path"]) in ours)]


def sound():
    import subprocess

    def listed(what, default):
        try:
            found = json.loads(subprocess.run(["pactl", "-f", "json", "list", what], capture_output=True, text=True, timeout=8).stdout or "[]")
        except (OSError, ValueError, subprocess.TimeoutExpired):
            return []
        out = []
        for d in found:
            if d.get("name", "").endswith(".monitor"):
                continue                    # what a speaker plays, offered as a microphone: not a thing to choose
            levels = [int(v.get("value_percent", "0%").rstrip("%")) for v in (d.get("volume") or {}).values()] or [0]
            out.append({"name": d["name"], "label": d.get("description") or d["name"], "volume": round(sum(levels) / len(levels) / 100, 2),
                        "muted": d.get("mute") is True, "default": d["name"] == default})
        return out

    said = lambda *a: subprocess.run(["pactl", *a], capture_output=True, text=True, timeout=8).stdout.strip()
    try:
        return {"outputs": listed("sinks", said("get-default-sink")), "inputs": listed("sources", said("get-default-source"))}
    except (OSError, subprocess.TimeoutExpired):
        return {"outputs": [], "inputs": []}


# what a kind of thing is, as files and addresses name themselves; the first is the one asked about
KINDS = {"browser": ["x-scheme-handler/https", "x-scheme-handler/http", "text/html"], "mail": ["x-scheme-handler/mailto"],
         "files": ["inode/directory"], "images": ["image/png", "image/jpeg", "image/webp", "image/gif", "image/bmp"],
         "video": ["video/mp4", "video/x-matroska", "video/webm", "video/quicktime", "video/x-msvideo"],
         "music": ["audio/mpeg", "audio/flac", "audio/ogg", "audio/x-wav", "audio/mp4"], "text": ["text/plain"], "pdf": ["application/pdf"]}


def launchers():
    """Every app that says what it can open: {desktop id: (name, icon, {types})}"""
    import configparser
    import glob
    lang = (os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or "").split("_")[0]
    found = {}
    for folder in (os.path.expanduser("~/.local/share/applications"), os.path.expanduser("~/.local/share/flatpak/exports/share/applications"),
                   "/var/lib/flatpak/exports/share/applications", "/usr/share/applications"):
        for path in sorted(glob.glob(folder + "/*.desktop")):
            name = os.path.basename(path)
            if name in found:
                continue
            p = configparser.RawConfigParser(strict=False, interpolation=None)
            p.optionxform = str
            try:
                p.read(path, encoding="utf-8")
                e = p["Desktop Entry"]
            except (KeyError, configparser.Error, UnicodeDecodeError):
                continue
            if e.get("MimeType") and e.get("NoDisplay", "").lower() != "true":
                found[name] = (e.get("Name[%s]" % lang) or e.get("Name", name), e.get("Icon", ""), set(filter(None, e["MimeType"].split(";"))))
    return found


def defaults():
    import subprocess
    apps = launchers()
    out = []
    for kind, types in KINDS.items():
        try:
            current = subprocess.run(["xdg-mime", "query", "default", types[0]], capture_output=True, text=True, timeout=5).stdout.strip()
        except (OSError, subprocess.TimeoutExpired):
            current = ""
        can = sorted(((i, a) for i, a in apps.items() if types[0] in a[2]), key=lambda x: x[1][0].lower())
        out.append({"kind": kind, "current": current, "apps": [{"id": i, "name": a[0], "icon": a[1]} for i, a in can]})
    return out


FORMATS = ("LC_TIME", "LC_NUMERIC", "LC_MONETARY", "LC_MEASUREMENT", "LC_PAPER")


def region():
    found = []
    for loc in out("locale", "-a").split():
        if re.fullmatch(r"[a-z]{2,3}_[A-Z]{2}\.utf8", loc):
            said = dict(re.findall(r'^(\w+)="(.*)"$', out("locale", "-k", "LC_ADDRESS", LC_ALL=loc), re.M))
            found.append({"id": loc[:-5] + ".UTF-8", "name": said.get("lang_name") or loc[:-5], "place": said.get("country_name", "")})
    mine = kept("locale")
    lang = mine.get("LANG") or os.environ.get("LANG") or ""
    return {"lang": lang, "formats": mine.get("LC_TIME", "") if mine.get("LC_TIME") != lang else "",
            "locales": sorted(found, key=lambda l: (plain(l["name"]), l["place"]))}


# The icon sets offered, the best known first; a set shows up only if the system has it.
ICON_SETS = (("Yaru", "Yaru"), ("Papirus", "Papirus"), ("elementary", "elementary"), ("Fluent", "Fluent"), ("Mint-Y", "Mint-Y"),
             ("breeze", "Breeze"), ("Adwaita", "Adwaita"))
ICON_DEFAULT = "Yaru"


def password():
    """Through AccountsService, which asks for the present password in the desktop's own dialog (polkit)."""
    new = sys.stdin.readline().rstrip("\n")
    if len(new) < 1:
        return {"ok": False, "error": "empty"}
    try:
        hashed = subprocess.run(["openssl", "passwd", "-6", "-stdin"], input=new + "\n", capture_output=True, text=True, timeout=10).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        hashed = ""
    if not hashed.startswith("$6$"):
        return {"ok": False, "error": "no openssl"}
    try:
        from gi.repository import Gio, GLib
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        bus.call_sync("org.freedesktop.Accounts", "/org/freedesktop/Accounts/User%d" % os.getuid(), "org.freedesktop.Accounts.User", "SetPassword",
                      GLib.Variant("(ss)", (hashed, "")), None, Gio.DBusCallFlags.NONE, 120000, None)
    except ImportError:
        return {"ok": False, "error": "no gi"}
    except Exception as e:                      # refused, or the dialog was closed
        return {"ok": False, "error": "refused" if "NotAuthorized" in str(e) or "Dismissed" in str(e) or "PermissionDenied" in str(e) else str(e)[:120]}
    return {"ok": True}


def icon_file(theme, name):
    """A big picture of that name from the set, or "". Sets lay their folders out as size/kind or kind/size."""
    for root in ("/usr/share/icons", os.path.expanduser("~/.local/share/icons"), os.path.expanduser("~/.icons")):
        for size in ("256x256", "128x128", "scalable", "96x96", "64x64", "48x48", "128", "96", "64", "48"):
            for kind in ("places", "mimetypes", "mimes"):
                for folder in (os.path.join(size, kind), os.path.join(kind, size)):
                    for ending in (".svg", ".png"):
                        path = os.path.join(root, theme, folder, name + ending)
                        if os.path.exists(path):
                            return path
    return ""


def chosen_icons():
    try:
        return open(os.path.join(CONFIG, "icons")).read().split()[0]
    except (OSError, IndexError):
        return ICON_DEFAULT


def icons(a):
    have = [(i, n) for i, n in ICON_SETS if any(os.path.isfile(os.path.join(r, i, "index.theme"))
            for r in ("/usr/share/icons", os.path.expanduser("~/.local/share/icons"), os.path.expanduser("~/.icons")))]
    if a:
        if a[0] not in [i for i, _ in have]:
            return {"ok": False}
        os.makedirs(CONFIG, exist_ok=True)
        with open(os.path.join(CONFIG, "icons"), "w") as f:
            f.write(a[0] + "\n")
        # apps that ask the system which set to use follow, and the desktop shows the new one at once
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "icon-theme", a[0]], capture_output=True)
        subprocess.run(["latte-desktop", "restart"], capture_output=True)
        return {"ok": True}
    return {"chosen": chosen_icons(), "sets": [{"id": i, "name": n, "folder": icon_file(i, "folder"), "file": icon_file(i, "text-x-generic"),
                                                "trash": icon_file(i, "user-trash")} for i, n in have]}


LOGIN_CONF = "/var/lib/latteos/login/login.conf"


def login_conf():
    try:
        return dict(re.findall(r'^\s*(\w+)\s*=\s*"?(.*?)"?\s*$', open(LOGIN_CONF, encoding="utf-8").read(), re.M))
    except OSError:
        return {}


def set_login_conf(**values):
    """Changes only the lines it is told about: the file's comments say what each is for."""
    try:
        lines = open(LOGIN_CONF, encoding="utf-8").read().splitlines()
        for key, value in values.items():
            line = '%s = "%s"' % (key, value.replace('"', ""))
            at = next((i for i, l in enumerate(lines) if re.match(r"\s*%s\s*=" % key, l)), None)
            if at is None:
                lines.append(line)
            else:
                lines[at] = line
        with open(LOGIN_CONF + ".new", "w", encoding="utf-8") as f:
            f.write("\n".join(lines) + "\n")
        os.replace(LOGIN_CONF + ".new", LOGIN_CONF)
    except OSError:
        return False
    return True


def loginscreen(a):
    c = login_conf()
    if a[:1] == ["panel"] and a[1:] in (["news"], ["none"]):
        return {"ok": set_login_conf(panel=a[1])}
    if a[:1] == ["news"]:
        urls = a[1:]
        if not all(re.fullmatch(r"https?://\S+", u) for u in urls):
            return {"ok": False, "error": "not an address"}
        return {"ok": set_login_conf(news_url=" ".join(urls))}
    if a[:1] == ["place"]:
        name = " ".join(a[1:]).strip()
        if not name:
            return {"ok": set_login_conf(lat="", lon="", place="")}
        import urllib.parse, urllib.request
        try:
            url = "https://geocoding-api.open-meteo.com/v1/search?count=1&name=" + urllib.parse.quote(name)
            hit = (json.load(urllib.request.urlopen(url, timeout=8)).get("results") or [None])[0]
        except (OSError, ValueError):
            return {"ok": False, "error": "no network"}
        if not hit:
            return {"ok": False, "error": "not found"}
        place = ", ".join(x for x in (hit.get("name"), hit.get("admin1"), hit.get("country")) if x)
        return {"ok": set_login_conf(lat=str(hit["latitude"]), lon=str(hit["longitude"]), place=place), "place": place}
    return {"panel": c.get("panel", "news"), "news_url": c.get("news_url", ""), "place": c.get("place", ""),
            "lat": c.get("lat", ""), "lon": c.get("lon", "")}


def clock():
    said = dict(line.split("=", 1) for line in out("timedatectl", "show").splitlines() if "=" in line)
    return {"zone": said.get("Timezone", ""), "auto": said.get("NTP") == "yes", "zones": out("timedatectl", "list-timezones").split()}


def layouts():
    """Every keyboard layout the system knows: [{"id": "sk" or "sk:qwerty", "name"}], named in the user's language."""
    import gettext
    tr = gettext.translation("xkeyboard-config", fallback=True).gettext
    found, part = [], ""
    try:
        with open("/usr/share/X11/xkb/rules/evdev.lst", encoding="utf-8") as f:
            for line in f:
                if line.startswith("!"):
                    part = line[1:].strip()
                elif part == "layout" and line.strip():
                    code, name = line.split(None, 1)
                    found.append({"id": code, "name": tr(name.strip())})
                elif part == "variant" and ": " in line:
                    variant, rest = line.split(None, 1)
                    found.append({"id": rest.split(":")[0].strip() + ":" + variant, "name": tr(rest.split(": ", 1)[1].strip())})
    except OSError:
        pass
    return sorted(found, key=lambda l: plain(l["name"]))


def keyboard():
    mine = kept("keyboard")
    pick = lambda what: mine.get("XKB_DEFAULT_" + what, os.environ.get("XKB_DEFAULT_" + what, ""))
    codes, variants = pick("LAYOUT").split(","), pick("VARIANT").split(",")
    current = [c + (":" + variants[i] if i < len(variants) and variants[i] else "") for i, c in enumerate(codes) if c]
    return {"current": current or ["us"], "layouts": layouts()}


def set_keyboard(ids):
    known = {l["id"] for l in layouts()}
    if not ids or len(ids) > 4 or len(set(ids)) != len(ids) or any(i not in known for i in ids):
        return 2
    codes, variants = ",".join(i.split(":")[0] for i in ids), ",".join(i.partition(":")[2] for i in ids)
    # the other options stay as they are; with more layouts than one there has to be a way from one to the next
    options = [o for o in kept("keyboard").get("XKB_DEFAULT_OPTIONS", os.environ.get("XKB_DEFAULT_OPTIONS", "")).split(",") if o and (len(ids) > 1 or not o.startswith("grp:"))]
    if len(ids) > 1 and not any(o.startswith("grp:") for o in options):
        options.append("grp:alt_shift_toggle")
    keep("keyboard", {"XKB_DEFAULT_LAYOUT": codes, "XKB_DEFAULT_VARIANT": variants, "XKB_DEFAULT_OPTIONS": ",".join(options)})
    out("hyprctl", "eval", 'hl.config({ input = { kb_layout = "%s", kb_variant = "%s", kb_options = "%s" } })' % (codes, variants, ",".join(options)))
    return 0


def set_locale(lang, formats):
    known = {l["id"] for l in region()["locales"]}
    if lang not in known or (formats and formats not in known):
        return 2
    keep("locale", dict({"LANG": lang}, **({k: formats for k in FORMATS} if formats and formats != lang else {})))
    return 0


def storage():
    disks, seen = [], set()
    said = out("df", "-B1", "--output=source,fstype,size,used,target", "-x", "tmpfs", "-x", "devtmpfs", "-x", "efivarfs", "-x", "overlay", "-x", "squashfs")
    for line in said.splitlines()[1:]:
        device, kind, size, used, mount = line.split(None, 4)
        # one disk mounted in several places is one disk; what the computer starts from is not the user's room
        if device not in seen and device.startswith("/") and size.isdigit() and not mount.startswith(("/boot", "/efi")):
            seen.add(device)
            disks.append({"mount": mount, "device": device, "kind": kind, "size": int(size), "used": int(used)})
    return {"disks": disks}


def sizes():
    home = os.path.expanduser("~")
    paths = {k: out("xdg-user-dir", k) for k in ("DOCUMENTS", "DOWNLOAD", "PICTURES", "VIDEOS", "MUSIC", "DESKTOP")}
    paths = {k: p for k, p in paths.items() if p and p != home and os.path.isdir(p)}
    data = os.environ.get("XDG_DATA_HOME") or os.path.join(home, ".local/share")
    paths.update({"trash": os.path.join(data, "Trash"), "cache": os.environ.get("XDG_CACHE_HOME") or os.path.join(home, ".cache")})
    told = dict(reversed(line.split("\t", 1)) for line in out("du", "-sbx", "--", *paths.values(), timeout=60).splitlines() if "\t" in line)
    size = lambda k: int(told.get(paths[k], 0))
    return {"folders": [{"id": k, "path": p, "size": size(k)} for k, p in paths.items() if k not in ("trash", "cache")], "trash": size("trash"), "cache": size("cache")}


def account():
    import pwd
    me = pwd.getpwuid(os.getuid())
    told = lambda what: (re.search(r'^s "(.*)"$', out("busctl", "get-property", "org.freedesktop.Accounts", "/org/freedesktop/Accounts/User%d" % me.pw_uid,
                                                      "org.freedesktop.Accounts.User", what)) or [None, ""])[1]
    picture = told("IconFile")
    return {"uid": me.pw_uid, "user": me.pw_name, "name": told("RealName") or me.pw_gecos.split(",")[0], "picture": picture if os.path.isfile(picture) else ""}


def main(a):
    for word, what in (("storage", storage), ("sizes", sizes), ("account", account)):
        if a == [word]:
            print(json.dumps(what(), ensure_ascii=False))
            return 0
    if a == ["password"]:
        print(json.dumps(password()))
        return 0
    if a[:1] == ["icons"] and len(a) <= 2:
        print(json.dumps(icons(a[1:]), ensure_ascii=False))
        return 0
    if a[:1] == ["loginscreen"]:
        print(json.dumps(loginscreen(a[1:]), ensure_ascii=False))
        return 0
    if a == ["region"]:
        print(json.dumps(region(), ensure_ascii=False))
        return 0
    if a[:1] == ["locale"] and len(a) in (2, 3):
        return set_locale(a[1], a[2] if len(a) == 3 else "")
    if a == ["time"]:
        print(json.dumps(clock(), ensure_ascii=False))
        return 0
    if a == ["keyboard"]:
        print(json.dumps(keyboard(), ensure_ascii=False))
        return 0
    if a[:1] == ["keyboard"]:
        return set_keyboard(a[1:])
    if a == ["sound"]:
        print(json.dumps(sound(), ensure_ascii=False))
        return 0
    if a == ["defaults"]:
        print(json.dumps(defaults(), ensure_ascii=False))
        return 0
    if len(a) == 3 and a[0] == "default" and a[1] in KINDS and re.fullmatch(r"[\w.-]+\.desktop", a[2]):
        import subprocess
        mine = launchers().get(a[2], ("", "", set()))[2]
        # everything of the kind that the app says it opens; the first always, or the choice would not show
        return subprocess.run(["xdg-mime", "default", a[2], *[t for i, t in enumerate(KINDS[a[1]]) if i == 0 or t in mine]]).returncode
    if a == ["wallpapers"]:
        print(json.dumps(wallpapers(), ensure_ascii=False))
        return 0
    if a[:1] == ["find"] and len(a) >= 2:
        result = find(" ".join(a[1:]))
    elif a == ["pages"]:
        result = pages()
    else:
        print(__doc__.strip())
        return 2
    print(json.dumps([{k: v for k, v in p.items() if k != "hay"} for p in result], ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
