#!/usr/bin/env python3
"""latte-guarddog: GuardDog. It watches that what the desktop needs is running, starts again what is not, and says
whose every process is.

  latte-guarddog watch          the guard itself (a user service of the session): every few seconds it looks at each
                                component, starts again the one that is down, and keeps the state in
                                $XDG_RUNTIME_DIR/latteos/guarddog.json
  latte-guarddog status         the state: [{"id", "name", "state", "restarts"}]; state is up · restarted · down ·
                                failed (it would not stay up) · off (it is not wanted now)
  latte-guarddog owners         {"pid": "linux" | "latteos" | "user"} for every process
  latte-guarddog owner PID…     the same for the pids given
  latte-guarddog keep PID       keep the user's program that runs as PID running: the guard starts it again when it stops
  latte-guarddog keep NAME off  not any more;   latte-guarddog keep: those kept, [{"name", "run", "flatpak"}]
  latte-guarddog set ID on|off  the user's choice for a component (kept in ~/.config/latteos/guarddog.json, which the Settings write)
  latte-guarddog manifest       (root, at every install and update) writes the list of what LatteOS is made of, with a hash of each
  latte-guarddog log [N]        what the guard did, the last N lines (200): [{"at", "what", "id", "text"}]; what = start ·
                                down · restart · failed · crash · back · thaw · fell (systemd brought it back) ·
                                impostor (a program of a kept one's name that is not it) · changed · doghouse (DogHouse put
                                GuardDog back)
  latte-guarddog summary        the overview: {"watching", "up", "down": [names], "last", "since", "days": [30 counts,
                                oldest first; -1 before the history], "top": [{"id", "name", "count", "last", "what"}]}
  latte-guarddog crashes        the programs that crashed in the last week, newest first: [{"pid", "exe", "name", "sig",
                                "at", "owner", "quiet"}] (systemd-coredump)
  latte-guarddog quiet NAME on|off   no notice when this program crashes (the crash is still in the log); alone, those

Crashes: the guard watches systemd-coredump too. A program of the user's session that crashed gets a notice, with
"Ask the AI" when the AI helper is on: it hands the facts to an agent (latte-ai crash PID), which explains and changes nothing.

A component that is gone is started again after two looks in a row (a restart that someone does on purpose takes a
moment). One that is started five times in five minutes and still falls is let be for five minutes, and the user is
told once; it is not started over and over.

The three owners: "linux" is the kernel and the system the distribution brings (kernel threads, systemd, the
services of the system and of the user's session: sound, portals, the bus), "latteos" is what LatteOS is made of,
"user" is everything the user started: their programs.

What LatteOS is made of is not told by a name, which anyone can take: it is a list that every install and update writes
(guarddog.manifest, owned by root) with the path and the hash of each file, and a process is LatteOS's only if the
program it runs, or the script it is given, is on that list and is still what the list says. A program that is called
latte-anything, or that sits in the user's folder, is the user's.

The user's choices from the Settings (a component switched off) are kept: an update brings the new list of components,
and what the user has switched off stays switched off.
"""
import json, os, re, shlex, shutil, subprocess, sys, time

UID = os.getuid()
RUN = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "latteos")
STATE = os.path.join(RUN, "guarddog.json")
FLAG = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "latteos", "desktop-icons")
EVERY, MISSES, TRIES, WINDOW, REST = 5, 2, 5, 300, 300
# the history outlives a restart of the computer: the overview counts the days since the last problem
LOG = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "latteos", "guarddog.log")
LOG_KEEP = 5000
PROBLEMS = ("crash", "down", "thaw", "fell", "impostor", "changed", "doghouse")


def T(text):
    """The user's language, from the table the scenes and the apps translate with (goo/lang/<language>.plm)."""
    lang = re.split(r"[_.@]", os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or "en")[0]
    table = read(os.path.join(os.environ.get("LATTE_SHARE") or "/usr/share/latteos", "goo", "lang", lang + ".plm"))
    m = re.search(r'^\s*"%s"\s*=\s*"((?:[^"\\]|\\.)*)"\s*$' % re.escape(text), table, re.M) if table else None
    return m.group(1) if m else text


def note(what, ident, text):
    """A line of what the guard did, for its window's console: the file keeps the last LOG_KEEP."""
    line = json.dumps({"at": int(time.time()), "what": what, "id": ident, "text": text})
    print("guarddog: %s %s: %s" % (what, ident, text), flush=True)
    try:
        lines = read(LOG).splitlines()[-(LOG_KEEP - 1):] + [line]
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        with open(LOG + ".tmp", "w") as f:
            f.write("\n".join(lines) + "\n")
        os.replace(LOG + ".tmp", LOG)
    except OSError:
        pass


# ── whose a process is ────────────────────────────────────────────────────────────────────────────────────────
MANIFEST = os.environ.get("LATTE_GUARD_MANIFEST") or "/usr/share/latteos/guarddog.manifest"
SYSTEM = {"systemd", "(sd-pam)", "sshd", "sshd-session", "Xwayland", "dbus-broker", "dbus-broker-lau"}
# programs of the distribution that LatteOS runs as they are: LatteOS's when this very file (its hash) is the one running
BASES = ["/usr/bin/pleamar", "/usr/bin/pleamar-wm", "/usr/bin/Hyprland", "/usr/bin/hyprctl", "/usr/bin/labwc", "/usr/sbin/greetd", "/usr/bin/greetd",
         "/usr/bin/hypridle", "/usr/bin/swaybg", "/usr/bin/mpvpaper", "/usr/bin/skwd-walld", "/usr/bin/skwd-helm", "/usr/bin/skwd-wall-vk",
         "/usr/bin/cliphist", "/usr/bin/wl-paste", "/usr/bin/qs", "/usr/bin/quickshell"]
# those that only carry a script or a scene: LatteOS's if the file they are given is on the list
CARRIERS = ("python3", "python", "sh", "bash", "dash", "qs", "quickshell", "pleamar", "pleamar-wm")


def read(path):
    try:
        with open(path, "rb") as f:
            return f.read().decode(errors="replace")
    except OSError:
        return ""


def sha(path):
    import hashlib
    h = hashlib.sha256()
    try:
        with open(path, "rb") as f:
            for block in iter(lambda: f.read(1 << 20), b""):
                h.update(block)
    except OSError:
        return ""
    return h.hexdigest()


_seen = {}            # (path, mtime, size) → its hash: a file is read once while it is not changed
_listed = {"at": None, "files": {}, "components": [], "state": "missing"}


def listed(path=None):
    """What the list says: {"files": {path: hash}, "components": [...], "state": "ok" | "missing" | "invalid"}. Read again when it changes.
    A list that is not the root's, or that others can write to, counts for nothing: the user must not be able to add to it."""
    path = path or MANIFEST
    try:
        st = os.stat(path)
    except OSError:
        return {"files": {}, "components": [], "state": "missing"}
    key = (path, st.st_mtime_ns, st.st_size)
    if _listed["at"] == key:
        return _listed
    found = {"at": key, "files": {}, "components": [], "state": "ok"}
    if (st.st_uid != 0 and st.st_uid != UID_ALLOWED) or st.st_mode & 0o022:
        found["state"] = "invalid"
    else:
        try:
            with open(path) as f:
                d = json.load(f)
            found["files"], found["components"] = dict(d.get("files", {})), list(d.get("components", []))
        except (OSError, ValueError, AttributeError):
            found["state"] = "invalid"
    _listed.clear()
    _listed.update(found)
    return _listed


UID_ALLOWED = -1      # tests may let their own user own a list


def is_listed(path, files):
    """The file is on the list and is what the list says."""
    want = files.get(path)
    if not want:
        return False
    try:
        st = os.stat(path)
    except OSError:
        return False
    key = (path, st.st_mtime_ns, st.st_size)
    if key not in _seen:
        _seen[key] = sha(path) == want
    return _seen[key]


def script_of(base, argv):
    """The file a carrier is told to run (the script, the scene, the app): what it carries, not what it is."""
    rest = argv[1:]
    if base.startswith(("python", "sh", "bash", "dash")):
        for a in rest:
            if not a.startswith("-"):
                return a
        return None
    for flag in ("-p", "--path", "--scene"):
        if flag in rest and rest.index(flag) + 1 < len(rest):
            return rest[rest.index(flag) + 1]
    return None


def made_by_latteos(exe, argv, files):
    """LatteOS's, by the list: a program that is on it and still what it says, or a carrier (an interpreter, a shell, the
    Quickshell and pleamar that run apps and scenes) that is told to run a file that is on it. Where the carrier stands
    matters too: one in the user's folder is not the distribution's."""
    base = os.path.basename(exe)
    carrier = base.startswith(("python", "sh", "bash", "dash")) or base in ("qs", "quickshell", "pleamar", "pleamar-wm")
    if carrier:
        script = script_of(base, argv)
        return exe.startswith(("/usr/bin/", "/usr/sbin/", "/bin/")) and script is not None and script.startswith("/") and is_listed(os.path.realpath(script), files)
    if base == "wl-paste":
        return is_listed(exe, files) and "cliphist" in argv
    return is_listed(exe, files)


def owner(pid, comm=None, ppid=None, uid=None, cgroup=None, cmdline=None, exe=None, files=None):
    """"linux", "latteos" or "user" for a process; the facts it is asked about are read from /proc if not given."""
    if comm is None:
        stat = read("/proc/%d/stat" % pid)
        if not stat:
            return "user"
        comm = stat[stat.find("(") + 1:stat.rfind(")")]
        ppid = int(stat[stat.rfind(")") + 2:].split()[1])
    if pid in (1, 2) or ppid == 2:
        return "linux"                                   # the kernel's own threads, and systemd
    if cmdline is None:
        cmdline = read("/proc/%d/cmdline" % pid).replace("\0", " ").strip()
    if cgroup is None:
        cgroup = read("/proc/%d/cgroup" % pid).strip().rsplit(":", 1)[-1]
    if exe is None:
        try:
            exe = os.path.realpath("/proc/%d/exe" % pid)
        except OSError:
            exe = ""
    if files is None:
        files = listed()["files"]
    if comm in SYSTEM or cgroup.rstrip("/").endswith("init.scope"):
        return "linux"                                   # systemd of the session, the login's helpers, the X11 layer
    # LatteOS's: by the list, never by a name or by where in the unit tree it sits
    if exe and made_by_latteos(exe, cmdline.split(" "), files):
        return "latteos"
    if uid is None:
        try:
            uid = os.stat("/proc/%d" % pid).st_uid
        except OSError:
            uid = UID
    # the system and the services of the user's session (sound, portals, the bus) are the distribution's;
    # a program the user started sits in an app scope, or in the session itself
    if uid != UID or cgroup.startswith(("/system.slice", "/init.scope")):
        return "linux"
    if "/app.slice/app-" in cgroup or re.search(r"/session-\d+\.scope", cgroup):
        return "user"
    if "/session.slice/" in cgroup or "/background.slice/" in cgroup or cgroup.rstrip("/").rsplit("/", 1)[-1].endswith(".service"):
        return "linux"
    return "user"


def owners(pids=None):
    if pids is None:
        pids = [int(p) for p in os.listdir("/proc") if p.isdigit()]
    return {pid: owner(pid) for pid in pids}


# ── what must run ─────────────────────────────────────────────────────────────────────────────────────────────
def quiet(*argv):
    try:
        return subprocess.run(argv, capture_output=True, text=True, timeout=15).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def running(pattern):
    return quiet("pgrep", "-u", str(UID), "-f", pattern)


def unit_active(name):
    return quiet("systemctl", "--user", "is-active", "--quiet", name)


def goo_alive():
    """The Goo scene runs and its logic is up. pleamar cuts off a logic that takes more than 2 s to start (22. 10.: a
    slow start of the computer): the scene is drawn, without a drop, and the service looks fine. Its first seconds it
    is given; then the scene must say it is alive (the logic's last word in goo.luau)."""
    if not unit_active("latte-goo.service"):
        return False
    try:
        since = int(subprocess.run(["systemctl", "--user", "show", "-p", "ActiveEnterTimestampMonotonic", "--value", "latte-goo.service"],
                                   capture_output=True, text=True, timeout=10).stdout.strip() or 0) / 1e6
        if time.monotonic() - since < 25:
            return True
        said = subprocess.run(["pleamar", "--say", "goo", "get goo_alive"], capture_output=True, text=True, timeout=8).stdout
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return True                         # not known: not a reason to start the desktop again
    return "true" in said


def start_detached(*argv):
    try:
        subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


def wallpaper_up():
    return unit_active("skwd-walld.service") or running(r"^(\S*/)?(swaybg|mpvpaper)( |$)")


def icons_wanted():
    return read(FLAG).strip() != "off"


CHOICES = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "latteos", "guarddog.json")


def choices():
    try:
        with open(CHOICES) as f:
            d = json.load(f)
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def names_in(key):
    """A list of names the user's choices keep: whatever else the file holds there (anyone can write it) is not one."""
    v = choices().get(key)
    return {n for n in v if isinstance(n, str)} if isinstance(v, list) else set()


def switched_off():
    """What the user has switched off in the Settings: it stays so, whatever an update brings."""
    return names_in("off")


def keep_choices(d):
    os.makedirs(os.path.dirname(CHOICES), exist_ok=True)
    with open(CHOICES + ".tmp", "w") as f:
        json.dump(d, f)
    os.replace(CHOICES + ".tmp", CHOICES)


def kept():
    v = choices().get("keep")
    return [k for k in (v if isinstance(v, list) else []) if isinstance(k, dict) and isinstance(k.get("name"), str) and k["name"]
            and isinstance(k.get("run"), list) and k["run"] and all(isinstance(a, str) for a in k["run"])]


def keep(pid):
    """What it takes to start the program again (its Flatpak, or the command it runs) and what it is: the program file it
    runs and that file's hash. A process is this program only if it runs that very file, never by its name alone."""
    stat = read("/proc/%d/stat" % pid)
    if not stat or os.stat("/proc/%d" % pid).st_uid != UID:
        return False
    name = stat[stat.find("(") + 1:stat.rfind(")")]
    app = re.search(r"^name=(.+)$", read("/proc/%d/root/.flatpak-info" % pid), re.M)
    run = ["flatpak", "run", app.group(1)] if app else [a for a in read("/proc/%d/cmdline" % pid).split("\0") if a]
    try:
        exe = os.readlink("/proc/%d/exe" % pid)
    except OSError:
        return False
    keep_choices(dict(choices(), keep=[k for k in kept() if k["name"] != name] +
                      [{"name": name, "run": run, "flatpak": app.group(1) if app else "", "exe": exe, "sha": sha("/proc/%d/exe" % pid)}]))
    return True


_told = set()       # (name, pid) of a look-alike or a changed program already in the log


def is_kept(k, pid):
    """The process runs the kept program's file: the same path, and the same content (its hash), or a path only the root
    can change (a system program that an update replaced). Anything else of that name is a look-alike."""
    try:
        exe, st = os.readlink("/proc/%d/exe" % pid), os.stat("/proc/%d/exe" % pid)
    except OSError:
        return False
    if exe == k.get("exe") and ((st.st_uid == 0 and not st.st_mode & 0o022) or is_listed("/proc/%d/exe" % pid, {"/proc/%d/exe" % pid: k.get("sha")})):
        return True
    same = exe == k.get("exe")
    if (k["name"], pid) not in _told:
        _told.add((k["name"], pid))
        note("impostor" if not same else "changed", "app:" + k["name"], ("runs %s, not %s" % (exe, k.get("exe"))) if not same else
             "%s is not what it was when it was kept (an update, or someone changed it)" % exe)
        if shutil.which("notify-send"):
            start_detached("notify-send", "-u", "critical", "-a", "LatteOS", "GuardDog",
                           T("A program pretends to be {n}." if not same else "{n} has changed since it was kept running.").replace("{n}", k["name"]))
    return same           # a changed program is let be, not started a second time; a look-alike does not count


def kept_alive(k):
    try:
        pids = subprocess.run(["pgrep", "-u", str(UID), "-x", k["name"]], capture_output=True, text=True, timeout=10).stdout.split()
    except (OSError, subprocess.TimeoutExpired):
        return True                         # not known: not a reason to start a second one
    return any([is_kept(k, int(p)) for p in pids])          # every one looked at: each look-alike is told


def unkeep(name):
    keep_choices(dict(choices(), keep=[k for k in kept() if k["name"] != name]))


def kept_components():
    """The user's programs kept running, as components: there while the very program runs (is_kept), started again inside the
    session (Hyprland starts it, so it has the session's screen, sound and bus)."""
    return [("app:" + k["name"], k["name"], lambda: True, lambda k=k: kept_alive(k),
             lambda r=k["run"]: quiet("hyprctl", "eval", "hl.exec_cmd(%s)" % json.dumps(" ".join(shlex.quote(a) for a in r), ensure_ascii=False)))
            for k in kept()]


def choose(ident, on):
    off = switched_off()
    (off.discard if on else off.add)(ident)
    keep_choices(dict(choices(), off=sorted(off)))


# id, the name shown (in English: the shell translates), whether it is wanted now, whether it is there, how to start it again
COMPONENTS = [
    ("goo", "The Goo scene", lambda: unit_active("latte-session.target"), goo_alive,
     lambda: quiet("systemctl", "--user", "restart", "latte-goo.service")),
    ("lockscreen", "The lock screen", lambda: unit_active("latte-session.target"), lambda: unit_active("latte-lockscreen.service"),
     lambda: quiet("systemctl", "--user", "restart", "latte-lockscreen.service")),
    ("idle", "Lock and screen off", lambda: unit_active("latte-session.target"), lambda: unit_active("latte-idle.service"),
     lambda: quiet("systemctl", "--user", "restart", "latte-idle.service")),
    # polkit takes the agent only from inside the login session, so Hyprland starts it, not systemd
    ("polkit", "Asking for the password", lambda: unit_active("latte-session.target"), lambda: running(r"^/usr/bin/pleamar --scene \S*/goo/polkit\.plm"),
     lambda: quiet("hyprctl", "eval", 'hl.exec_cmd("/usr/libexec/latte-polkit-agent")')),
    ("icons", "Icons on the desktop", icons_wanted, lambda: running(r"^qs .*apps/desktop\.qml"),
     lambda: quiet("latte-desktop", "restart")),
    ("focus", "Screen time", lambda: unit_active("latte-session.target"), lambda: unit_active("latte-focus.service"),
     lambda: quiet("systemctl", "--user", "restart", "latte-focus.service")),
    ("wallpaper", "The wallpaper", lambda: unit_active("latte-session.target"), wallpaper_up,
     lambda: quiet("latte-wall", "restore")),
    ("clipboard", "Clipboard history", lambda: shutil.which("cliphist") is not None and shutil.which("wl-paste") is not None,
     lambda: running(r"^wl-paste --watch cliphist"), lambda: start_detached("sh", "-c", "exec wl-paste --watch cliphist store")),
    # the root's: the guard can say it is down, not start it
    ("net", "Cutting off the internet", lambda: os.path.exists("/usr/libexec/latte-netd"), lambda: quiet("systemctl", "is-active", "--quiet", "latte-netd.service"), None),
]


def alive_to_systemd():
    """The watchdog of the guard's own unit (WatchdogSec): while this keeps coming, the guard is not stopped or stuck."""
    path = os.environ.get("NOTIFY_SOCKET", "")
    if not path:
        return
    import socket
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as s:
            s.sendto(b"WATCHDOG=1", "\0" + path[1:] if path.startswith("@") else path)
    except OSError:
        pass


UNIT_OF = {"goo": "latte-goo.service", "lockscreen": "latte-lockscreen.service", "idle": "latte-idle.service", "focus": "latte-focus.service"}
ID_OF = {u: i for i, u in UNIT_OF.items()}
UNITS = "/sys/fs/cgroup/user.slice/user-%d.slice/user@%d.service/*/latte-*.service" % (UID, UID)


def thaw():
    """A unit of LatteOS that was frozen (systemctl freeze) or a process of it that was stopped (kill -STOP) looks alive
    and does nothing; systemd's restart does not see it. It is let go on, and the log says so."""
    import glob, signal
    for cg in glob.glob(UNITS):
        unit = os.path.basename(cg)
        if "frozen 1" in read(os.path.join(cg, "cgroup.events")):
            note("thaw", ID_OF.get(unit, unit), "frozen; let go on")
            quiet("systemctl", "--user", "thaw", unit)
        for pid in read(os.path.join(cg, "cgroup.procs")).split():
            stat = read("/proc/%s/stat" % pid)
            if stat[stat.rfind(")") + 2:][:1] == "T":
                note("thaw", ID_OF.get(unit, unit), "process %s stopped; let go on" % pid)
                try:
                    os.kill(int(pid), signal.SIGCONT)
                except OSError:
                    pass




def restarts():
    """{unit: how many times systemd has started it again}: a fall that systemd mended before the guard looked."""
    try:
        out = subprocess.run(["systemctl", "--user", "show", "-p", "Id", "-p", "NRestarts", "latte-*.service"],
                             capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return {}
    found = {}
    for block in out.split("\n\n"):
        d = dict(l.split("=", 1) for l in block.splitlines() if "=" in l)
        if d.get("Id") and d.get("NRestarts", "").isdigit():
            found[d["Id"]] = int(d["NRestarts"])
    return found


def tell_failed(name):
    if shutil.which("notify-send"):
        start_detached("notify-send", "-u", "critical", "-a", "LatteOS", "GuardDog", T("{n} would not stay up.").replace("{n}", T(name)))


# ── crashes: what systemd-coredump caught, as Omarchy's crash notices do (MIT), with LatteOS's owners ──────────────
def crashes(days=7):
    try:
        out = subprocess.run(["coredumpctl", "list", "--json=short", "--no-pager", "--since=-%dd" % days],
                             capture_output=True, text=True, timeout=20).stdout
        found = json.loads(out) if out.strip() else []
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return []
    muted, files = quiet_ones(), listed()["files"]
    out = []
    for c in reversed(found):
        if c.get("uid") != UID:
            continue
        name = os.path.basename(c.get("exe", "")) or "?"
        out.append({"pid": c.get("pid"), "exe": c.get("exe", ""), "name": name, "sig": c.get("sig", 0),
                    "at": int((c.get("time") or 0) / 1e6), "owner": owner_of_path(c.get("exe", ""), files), "quiet": name in muted})
    return out


def owner_of_path(exe, files):
    """Whose a program that is gone was: LatteOS's when it is on the list, the distribution's under /usr, else the user's."""
    return "latteos" if exe in files else ("linux" if exe.startswith(("/usr/", "/bin/", "/sbin/")) else "user")


def quiet_ones():
    return names_in("quiet")


def hush(name, on):
    q = quiet_ones()
    (q.add if on else q.discard)(name)
    keep_choices(dict(choices(), quiet=sorted(q)))


def tell_crash(c, ask):
    """A notice that a program crashed; with "Ask the AI" when there is an agent to hand the facts to (latte-ai crash),
    which explains and changes nothing. "Not about this program" mutes it."""
    if not shutil.which("notify-send"):
        return
    body = T("{n} crashed. Ask the AI what happened?" if ask else "{n} crashed.").replace("{n}", c["name"])
    script = 'a=$(notify-send -a LatteOS -u normal --wait ${3:+--action=ask="$3"} --action=mute="$4" "$1" "$2"); ' \
             'case "$a" in ask) exec latte-ai crash "$5" ;; mute) exec latte-guarddog quiet "$6" on ;; esac'
    start_detached("sh", "-c", script, "sh", "GuardDog", body, T("Ask the AI") if ask else "", T("Not about this program"), str(c["pid"]), c["name"])


def watch():
    os.makedirs(RUN, exist_ok=True)
    fresh = lambda c: {"id": c[0], "name": c[1], "state": "up", "restarts": 0, "off": False, "missed": 0, "tries": [], "rest": 0, "told": False}
    mine = {c[0]: fresh(c) for c in COMPONENTS}
    note("start", "guarddog", "watching")
    seen = {c["pid"] for c in crashes(1)}
    looked = 0
    mended = restarts()

    def look():
        nonlocal looked, mended
        alive_to_systemd()
        thaw()
        now_mended = restarts()
        for unit, n in now_mended.items():
            if n > mended.get(unit, n) and unit != "latte-guarddog.service":
                note("fell", ID_OF.get(unit, unit), "stopped; systemd brought it back")
        mended = now_mended
        now = time.monotonic()
        # new crashes, a look every half minute: in the log, and a notice unless the user said not about that one
        if now - looked > 30:
            looked = now
            for c in crashes(1):
                if c["pid"] in seen:
                    continue
                seen.add(c["pid"])
                note("crash", c["name"], "%s (pid %s, signal %s, %s)" % (c["exe"], c["pid"], c["sig"], c["owner"]))
                # a notice unless the user said not about that one; the AI is offered as Omarchy's crash-watch does, only
                # when it is turned on (latte-ai toggle crash-capture) and there is an agent to hand it to
                if not c["quiet"]:
                    tell_crash(c, quiet("latte-ai", "offer-crash"))
        off, known = switched_off(), listed()["components"]
        apps = kept_components()
        for gone in [i for i in mine if i.startswith("app:") and i not in {a[0] for a in apps}]:
            del mine[gone]
        known = known and known + [a[0] for a in apps]
        for ident, name, wanted, alive, start in COMPONENTS + apps:
            alive_to_systemd()
            c = mine.setdefault(ident, fresh((ident, name)))
            c["off"] = ident in off
            try:
                # wanted by the system and by the user: a component that the update does not know is not asked for, one
                # the user has switched off stays off
                if ident in off or (known and ident not in known) or not wanted():
                    c["state"], c["missed"] = "off", 0
                    continue
                if alive():
                    if c["state"] in ("down", "failed"):
                        note("back", ident, "up again")
                    if c["state"] in ("down", "failed", "off"):
                        c["state"] = "up"
                    c["missed"], c["told"] = 0, False
                    continue
                c["missed"] += 1
                if c["missed"] == 1:
                    note("down", ident, "not running")
                if start is None:
                    c["state"] = "down"
                    continue
                if c["state"] == "failed" and now < c["rest"]:
                    continue
                if c["missed"] < MISSES:
                    c["state"] = "down" if c["state"] != "restarted" else c["state"]
                    continue
                c["tries"] = [t for t in c["tries"] if now - t < WINDOW]
                if len(c["tries"]) >= TRIES:
                    c["state"], c["rest"] = "failed", now + REST
                    note("failed", ident, "fell %d times in %d minutes; left alone for %d minutes" % (TRIES, WINDOW // 60, REST // 60))
                    if not c["told"]:
                        c["told"] = True
                        tell_failed(name)
                    continue
                c["tries"].append(now)
                note("restart", ident, "starting it again")
                start()
                c["restarts"] += 1
                c["state"], c["missed"] = "restarted", 0
            except Exception as e:                       # one component's trouble does not stop the watch over the others
                print("guarddog: %s: %s" % (ident, e), file=sys.stderr, flush=True)
        shown = [{k: c[k] for k in ("id", "name", "state", "restarts", "off")} for c in mine.values()]
        tmp = STATE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(shown, f)
        os.replace(tmp, STATE)

    while True:
        try:
            look()
        except Exception as e:      # a guard that falls over its own data guards nothing: this round is lost, not the guard
            print("guarddog: %s: %s" % (type(e).__name__, e), file=sys.stderr, flush=True)
            alive_to_systemd()
        time.sleep(EVERY)


def status():
    try:
        with open(STATE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return []


DOGHOUSE = os.environ.get("LATTE_DOGHOUSE_LOG") or "/var/lib/latteos/doghouse.log"


def history():
    """What the guard did, and what DogHouse (the root's, system/libexec/latte-doghouse) did for this user: oldest first."""
    events = []
    for path, mine in ((LOG, lambda e: True), (DOGHOUSE, lambda e: e.get("uid") == UID)):
        for l in read(path).splitlines():
            try:
                e = json.loads(l)
            except ValueError:
                continue
            if isinstance(e, dict) and isinstance(e.get("at"), int) and mine(e):
                events.append(e)
    return sorted(events, key=lambda e: e["at"])


def summary(now=None):
    """The overview of the GuardDog window: how things stand, the days since the last problem and what goes wrong most."""
    now = now or time.time()
    events = history()
    names = dict({c[0]: c[1] for c in COMPONENTS}, guarddog="GuardDog")
    shown = [c for c in status() if not c.get("off") and c.get("state") != "off"]
    problems = [e for e in events if e.get("what") in PROBLEMS]
    midnight = time.mktime(time.localtime(now)[:3] + (0, 0, 0, 0, 0, -1))
    start = events[0]["at"] if events else now
    days = [0 if midnight - (29 - i) * 86400 + 86400 > start else -1 for i in range(30)]      # -1: before the history begins
    top = {}
    for e in problems:
        ago = 0 if e["at"] >= midnight else int((midnight - e["at"]) // 86400) + 1      # 0 today, 1 yesterday…
        if ago < 30:
            days[29 - ago] += 1
            t = top.setdefault(e["id"], {"id": e["id"], "name": names.get(e["id"], e["id"].removeprefix("app:")), "count": 0, "last": 0, "what": e["what"]})
            t["count"] += 1
            if e["at"] >= t["last"]:
                t["last"], t["what"] = e["at"], e["what"]
    return {"watching": len(shown), "up": sum(1 for c in shown if c.get("state") in ("up", "restarted")),
            "down": [c["name"] for c in shown if c.get("state") in ("down", "failed")],
            "last": problems[-1]["at"] if problems else None, "since": events[0]["at"] if events else None, "days": days,
            "top": sorted(top.values(), key=lambda t: (-t["count"], -t["last"]))[:5]}


def manifest():
    """What LatteOS is made of, with a hash of each: its commands, its apps, its scenes, and the programs of the
    distribution it runs as they are. Written at every install and update, by the root, and read by the guard."""
    import glob
    if os.getuid() != 0:
        print("latte-guarddog manifest: this is the root's to write", file=sys.stderr)
        return 1
    mine = sorted(set(glob.glob("/usr/bin/latte-*") + glob.glob("/usr/libexec/latte*") + glob.glob("/usr/share/latteos/apps/*.qml")
                      + glob.glob("/usr/share/latteos/goo/*.plm")))
    files = {}
    for path in mine + [b for b in BASES if os.path.exists(b)]:
        real = os.path.realpath(path)
        if os.path.isfile(real):
            files[path] = files[real] = sha(real)
    body = {"version": 1, "written": int(time.time()), "files": files, "components": [c[0] for c in COMPONENTS]}
    os.makedirs(os.path.dirname(MANIFEST), exist_ok=True)
    tmp = MANIFEST + ".tmp"
    with open(tmp, "w") as f:
        json.dump(body, f, indent=1, sort_keys=True)
    os.chmod(tmp, 0o644)
    os.replace(tmp, MANIFEST)
    print("latte-guarddog: %d files on the list" % len(files))
    return 0


def main(a):
    if a[:1] == ["watch"]:
        watch()
    elif a[:1] == ["summary"]:
        print(json.dumps(summary()))
    elif a[:1] == ["status"]:
        print(json.dumps(status()))
    elif a[:1] == ["owners"]:
        print(json.dumps({str(k): v for k, v in owners().items()}))
    elif a[:1] == ["manifest"]:
        return manifest()
    elif a == ["keep"]:
        print(json.dumps(kept()))
    elif a[:1] == ["keep"] and len(a) == 2 and a[1].isdigit():
        return 0 if keep(int(a[1])) else 1
    elif a[:1] == ["keep"] and len(a) == 3 and a[2] == "off":
        unkeep(a[1])
    elif a[:1] == ["set"] and len(a) == 3 and a[2] in ("on", "off"):
        choose(a[1], a[2] == "on")
    elif a[:1] == ["log"]:
        n = int(a[1]) if len(a) > 1 and a[1].isdigit() else 200
        print(json.dumps(history()[-n:]))
    elif a[:1] == ["crashes"]:
        print(json.dumps(crashes()))
    elif a == ["quiet"]:
        print(json.dumps(sorted(choices().get("quiet", []))))
    elif a[:1] == ["quiet"] and len(a) == 3 and a[2] in ("on", "off"):
        hush(a[1], a[2] == "on")
    elif a[:1] == ["owner"] and len(a) > 1:
        print(json.dumps({p: owner(int(p)) for p in a[1:]}))
    else:
        print(__doc__)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
