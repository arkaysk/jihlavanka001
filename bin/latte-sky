#!/usr/bin/env python3
"""latte-sky: where the sun and the moon are, and the weather, for the place in login.conf.

Prints one JSON object:
  sun, moon   {"alt": degrees above the horizon, "t": 0 at rise … 1 at set, -1 while it is down};
              the moon also "lit" (0…1) and "waxing"
  rain        0 none, 1 in the next hours, 2 right now;  snow: whether that is snow
  wind        km/h
  now         {"temp", "code" (WMO), "kind" 1 clear … 7 storm, "icon"} or null without a forecast
  place, hours [{time, temp, code}], days [{weekday (0 Monday), max, min, code, rain %}]
  latte-sky sources: the next days as the chosen weather services see them, and the links to the place's own services
  latte-sky models · latte-sky choose MODEL on|off: which services, for the Settings
  latte-sky country: the country of the place (two letters, "sk"): what name days and holidays follow. login.conf
  keeps it when the Settings set the place; a place set before that is looked up once by its name, else LANG
  now also "feels" (apparent temperature) and "humidity"; sunrise, sunset ("HH:MM", local today); aqi {value, level 0…5}
"""
import datetime, json, math, os, re, sys, time, urllib.parse, urllib.request

CONF = "/var/lib/latteos/login/login.conf"
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "latteos", "weather.json")
RAIN = set(range(51, 68)) | {80, 81, 82, 95, 96, 99}
SNOW = {71, 73, 75, 77, 85, 86}


def conf():
    try:
        return dict(re.findall(r'^\s*(\w+)\s*=\s*"?(.*?)"?\s*$', open(CONF, encoding="utf-8").read(), re.M))
    except OSError:
        return {}


def country():
    """The place's country: as login.conf keeps it, else found once from the place's name (open-meteo's geocoding,
    kept beside the weather), else the one in LANG."""
    c = conf()
    if c.get("country"):
        return c["country"].lower()
    place = c.get("place", "")
    if place:
        kept = os.path.join(os.path.dirname(CACHE), "country.json")
        try:
            with open(kept) as f:
                k = json.load(f)
            if k.get("place") == place:
                return k["country"]
        except (OSError, ValueError, KeyError):
            pass
        try:
            url = "https://geocoding-api.open-meteo.com/v1/search?count=5&name=" + urllib.parse.quote(place.split(",")[0])
            hits = json.load(urllib.request.urlopen(url, timeout=8)).get("results") or []
            # the hit nearest the place's own coordinates: a name is often in more than one country
            lat, lon = float(c.get("lat") or 0), float(c.get("lon") or 0)
            hit = min(hits, key=lambda h: abs(h["latitude"] - lat) + abs(h["longitude"] - lon)) if hits else None
            if hit and hit.get("country_code"):
                os.makedirs(os.path.dirname(kept), exist_ok=True)
                with open(kept, "w") as f:
                    json.dump({"place": place, "country": hit["country_code"].lower()}, f)
                return hit["country_code"].lower()
        except (OSError, ValueError):
            pass
    lang = os.environ.get("LC_ALL") or os.environ.get("LANG") or "sk_SK"
    return (lang[3:5] if len(lang) >= 5 and lang[2] == "_" else "sk").lower()


def sky(lat, lon, t=None):
    """Low precision (~1°): enough for a silhouette on the login screen."""
    t = time.time() if t is None else t
    d = t / 86400.0 + 2440587.5 - 2451545.0              # days since J2000
    rad, sin, cos = math.radians, math.sin, math.cos
    g = rad((357.529 + 0.98560028 * d) % 360)
    sun_lon = rad((280.459 + 0.98564736 * d + 1.915 * sin(g) + 0.020 * sin(2 * g)) % 360)
    e = rad(23.439 - 0.00000036 * d)
    ra_s, dec_s = math.atan2(cos(e) * sin(sun_lon), cos(sun_lon)), math.asin(sin(e) * sin(sun_lon))
    anomaly = rad((134.963 + 13.064993 * d) % 360)
    moon_lon = rad((218.316 + 13.176396 * d) % 360) + rad(6.289) * sin(anomaly)
    moon_lat = rad(5.128) * sin(rad((93.272 + 13.229350 * d) % 360))
    ra_m = math.atan2(sin(moon_lon) * cos(e) - math.tan(moon_lat) * sin(e), cos(moon_lon))
    dec_m = math.asin(sin(moon_lat) * cos(e) + cos(moon_lat) * sin(e) * sin(moon_lon))
    sidereal = rad((280.46061837 + 360.98564736629 * d + lon) % 360)
    phi = rad(lat)

    def where(ra, dec):
        h = (sidereal - ra + math.pi) % (2 * math.pi) - math.pi          # hour angle
        alt = math.degrees(math.asin(sin(phi) * sin(dec) + cos(phi) * cos(dec) * cos(h)))
        half_day = math.acos(max(-1.0, min(1.0, -math.tan(phi) * math.tan(dec))))
        up = half_day > 0.01 and abs(h) <= half_day
        return {"alt": round(alt, 1), "t": round((h + half_day) / (2 * half_day), 4) if up else -1}

    apart = math.acos(max(-1.0, min(1.0, sin(dec_s) * sin(dec_m) + cos(dec_s) * cos(dec_m) * cos(ra_s - ra_m))))
    moon = where(ra_m, dec_m)
    moon.update(lit=round((1 - cos(apart)) / 2, 3), waxing=sin(moon_lon - sun_lon) > 0)
    return {"sun": where(ra_s, dec_s), "moon": moon}


def forecast(lat, lon):
    """Open-Meteo, no key needed. Asked at most every 20 minutes; with no network, the last one known."""
    try:                                                 # the last one, if it is fresh and for the same place
        kept = json.load(open(CACHE))
        if time.time() - os.path.getmtime(CACHE) < 20 * 60 and kept.get("at") == [lat, lon]:
            return kept
    except (OSError, ValueError, AttributeError):
        pass
    url = ("https://api.open-meteo.com/v1/forecast?latitude=%s&longitude=%s&current=temperature_2m,weather_code,wind_speed_10m,"
           "apparent_temperature,relative_humidity_2m&hourly=temperature_2m,weather_code&daily=weather_code,temperature_2m_max,"
           "temperature_2m_min,precipitation_probability_max,sunrise,sunset&timezone=auto&forecast_days=8" % (lat, lon))
    try:
        d = json.load(urllib.request.urlopen(url, timeout=8))
    except Exception:
        try:
            return json.load(open(CACHE))
        except (OSError, ValueError):
            return {}
    cur, hourly, daily = d.get("current") or {}, d.get("hourly") or {}, d.get("daily") or {}
    out = {"now": {"temp": round(cur.get("temperature_2m") or 0), "code": cur.get("weather_code", 3),
                   "feels": round(cur.get("apparent_temperature") if cur.get("apparent_temperature") is not None else (cur.get("temperature_2m") or 0)),
                   "humidity": round(cur.get("relative_humidity_2m") or 0)},
           "wind": round(cur.get("wind_speed_10m") or 0), "hours": [], "days": [],
           "sunrise": ((daily.get("sunrise") or [""])[0] or "")[11:16], "sunset": ((daily.get("sunset") or [""])[0] or "")[11:16]}
    out["aqi"] = air_quality(lat, lon)
    out["at"] = [lat, lon]
    times = hourly.get("time") or []
    start = next((i for i, t in enumerate(times) if t[:13] == (cur.get("time") or "")[:13]), 0) + 1
    for i in range(start, min(start + 24, len(times)), 3):
        out["hours"].append({"time": times[i][11:16], "temp": round(hourly["temperature_2m"][i]), "code": hourly["weather_code"][i]})
    for i, day in enumerate(daily.get("time") or []):
        out["days"].append({"weekday": datetime.date.fromisoformat(day).weekday(), "max": round(daily["temperature_2m_max"][i]),
                            "min": round(daily["temperature_2m_min"][i]), "code": daily["weather_code"][i],
                            "rain": (daily.get("precipitation_probability_max") or [None] * 9)[i] or 0})
    try:
        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
        json.dump(out, open(CACHE + ".new", "w"))
        os.replace(CACHE + ".new", CACHE)
    except OSError:
        pass
    return out


def air_quality(lat, lon):
    """The European air quality index now, and its word (Open-Meteo, no key); None where it is not known."""
    url = "https://air-quality-api.open-meteo.com/v1/air-quality?latitude=%s&longitude=%s&current=european_aqi" % (lat, lon)
    try:
        v = (json.load(urllib.request.urlopen(url, timeout=8)).get("current") or {}).get("european_aqi")
    except Exception:
        return None
    if v is None:
        return None
    v = round(v)
    return {"value": v, "level": next(i for i, top in enumerate((20, 40, 60, 80, 100, 10 ** 6)) if v <= top)}     # 0 good … 5 extremely poor


# the forecasts of several weather services for the same place: they often differ, and side by side one sees what may
# come. Which of them, the user chooses (Settings › Drops › Clock and weather; ~/.config/latteos/weather.json).
MODELS = [("ecmwf_ifs025", "ECMWF", "EU"), ("icon_seamless", "ICON", "DWD"), ("gfs_seamless", "GFS", "NOAA"),
          ("meteofrance_seamless", "Meteo-France", "FR"), ("ukmo_seamless", "Met Office", "UK"), ("gem_seamless", "GEM", "CA"),
          ("jma_seamless", "JMA", "JP"), ("knmi_seamless", "Harmonie", "KNMI"), ("dmi_seamless", "Harmonie", "DMI"),
          ("metno_seamless", "MET Norway", "NO"), ("italia_meteo_arpae_icon_2i", "ICON-2I", "IT"), ("cma_grapes_global", "GRAPES", "CMA")]
CHOSEN = ["ecmwf_ifs025", "icon_seamless", "gfs_seamless", "meteofrance_seamless", "ukmo_seamless"]
MOST = 5                                                 # the card has room for five
CHOICE = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "latteos", "weather.json")
SERVICES = os.path.join(os.environ.get("LATTE_SHARE") or "/usr/share/latteos", "weather-services.txt")


def chosen():
    try:
        got = [m for m in json.load(open(CHOICE)).get("models", []) if any(m == x[0] for x in MODELS)]
        return got[:MOST] or CHOSEN
    except (OSError, ValueError, AttributeError):
        return CHOSEN


def choose(model, on):
    now = [m for m in chosen() if m != model]
    if on:
        now = (now + [model])[-MOST:]
    os.makedirs(os.path.dirname(CHOICE), exist_ok=True)
    json.dump({"models": now}, open(CHOICE + ".new", "w"))
    os.replace(CHOICE + ".new", CHOICE)


def links(c=None):
    """The weather services of the place's country and those of anywhere, from weather-services.txt, their addresses filled in."""
    c = conf() if c is None else c
    import urllib.parse
    country_, out = country(), []
    try:
        lines = open(SERVICES, encoding="utf-8").read().splitlines()
    except OSError:
        return out
    for line in lines:
        parts = [p.strip() for p in line.split("|")]
        if len(parts) != 4 or line.lstrip().startswith("#") or parts[0] not in (country_, "*"):
            continue
        url = parts[3].replace("{lat}", c.get("lat", "")).replace("{lon}", c.get("lon", "")).replace("{place}", urllib.parse.quote(c.get("place", "").split(",")[0]))
        out.append({"name": parts[1], "what": parts[2], "url": url, "here": parts[0] != "*"})
    return out


SOURCES_CACHE = os.path.join(os.path.dirname(CACHE), "weather-sources.json")


def sources(c=None):
    """{"sources": [{"name", "by", "days": [{"weekday", "max", "min", "code", "rain" (mm)}]}]} — through Open-Meteo, no key;
    asked at most every hour, with no network the last one known."""
    c = conf() if c is None else c
    try:
        lat, lon = float(c.get("lat", "")), float(c.get("lon", ""))
    except ValueError:
        return {"sources": []}
    want = chosen()
    try:
        kept = json.load(open(SOURCES_CACHE))
        if time.time() - os.path.getmtime(SOURCES_CACHE) < 60 * 60 and kept.get("at") == [lat, lon] and kept.get("models") == want:
            kept["links"] = links(c)
            return kept
    except (OSError, ValueError, AttributeError):
        kept = None
    url = ("https://api.open-meteo.com/v1/forecast?latitude=%s&longitude=%s&daily=temperature_2m_max,temperature_2m_min,weather_code,"
           "precipitation_sum&timezone=auto&forecast_days=7&models=%s" % (lat, lon, ",".join(want)))
    try:
        daily = json.load(urllib.request.urlopen(url, timeout=10)).get("daily") or {}
    except Exception:
        return kept or {"sources": []}
    out = {"at": [lat, lon], "models": want, "sources": []}
    for model, name, by in [x for m in want for x in MODELS if x[0] == m]:
        days = []
        for i, day in enumerate(daily.get("time") or []):
            hi, lo = (daily.get("temperature_2m_max_" + model) or [None] * 9)[i], (daily.get("temperature_2m_min_" + model) or [None] * 9)[i]
            if hi is None or lo is None:
                continue
            days.append({"weekday": datetime.date.fromisoformat(day).weekday(), "max": round(hi), "min": round(lo),
                         "code": (daily.get("weather_code_" + model) or [3] * 9)[i] or 0, "rain": round((daily.get("precipitation_sum_" + model) or [0] * 9)[i] or 0, 1)})
        if days:
            out["sources"].append({"name": name, "by": by, "days": days})
    try:
        json.dump(out, open(SOURCES_CACHE + ".new", "w"))
        os.replace(SOURCES_CACHE + ".new", SOURCES_CACHE)
    except OSError:
        pass
    out["links"] = links(c)
    return out


def kind(code):
    """A WMO weather code as (kind, icon): the seven the scenes tell apart."""
    return ((1, "sun") if code == 0 else (2, "sun-low") if code in (1, 2) else (4, "cloud-fog") if code in (45, 48)
            else (7, "cloud-storm") if code >= 95 else (6, "cloud-snow") if code in SNOW
            else (5, "cloud-rain") if code in RAIN else (3, "cloud"))


def report(c=None, f=None):
    c = conf() if c is None else c
    try:
        lat, lon = float(c.get("lat", "")), float(c.get("lon", ""))
    except ValueError:
        return {"sun": {"alt": 0, "t": -1}, "moon": {"alt": 0, "t": -1, "lit": 1, "waxing": True},
                "rain": 0, "snow": False, "wind": 0, "now": None, "place": "", "hours": [], "days": []}
    f = forecast(lat, lon) if f is None else f
    out = sky(lat, lon)
    now = f.get("now")
    soon = [h.get("code") for h in (f.get("hours") or [])[:2]]
    code = now.get("code") if now else None
    if code in RAIN or code in SNOW:
        rain, snow = 2, code in SNOW
    elif any(k in RAIN or k in SNOW for k in soon):
        rain, snow = 1, not any(k in RAIN for k in soon)
    else:
        rain, snow = 0, False
    if now:
        now = dict(now, **dict(zip(("kind", "icon"), kind(int(code)))))
    out.update(rain=rain, snow=snow, wind=f.get("wind", 0), now=now, place=c.get("place", "").split(",")[0],
               hours=f.get("hours") or [], days=f.get("days") or [], sunrise=f.get("sunrise", ""), sunset=f.get("sunset", ""), aqi=f.get("aqi"))
    return out


if __name__ == "__main__":
    if sys.argv[1:] == ["country"]:
        print(country())
        sys.exit(0)
    if sys.argv[1:] == ["sources"]:
        print(json.dumps(sources(), ensure_ascii=False))
        sys.exit(0)
    if sys.argv[1:] == ["models"]:                       # for the Settings: every service there is, which are chosen, and the links
        print(json.dumps({"models": [{"id": m, "name": n, "by": b} for m, n, b in MODELS], "chosen": chosen(), "most": MOST, "links": links()}, ensure_ascii=False))
        sys.exit(0)
    if sys.argv[1:2] == ["choose"] and len(sys.argv) == 4 and sys.argv[3] in ("on", "off"):
        choose(sys.argv[2], sys.argv[3] == "on")
        sys.exit(0)
    if len(sys.argv) > 1:
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(2)
    print(json.dumps(report(), ensure_ascii=False))
