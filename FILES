# Copied only when missing; from then on they are the user's settings and stay unless asked otherwise.
[seeds]
/var/lib/latteos/login/login.conf                       <- system/login.conf

# Made while LatteOS runs; they go with it.
[state]
/run/latteos/
/var/lib/latteos/
/var/lib/greetd/latte-last-user
/var/lib/greetd/latte-last-session
/boot/loader/entries/*-lattesafe.conf
/boot/loader/entries/*-lattesafe-nomodeset.conf
$XDG_RUNTIME_DIR/latteos/                               # per user: the reason for SAFE, labwc's menu, where to go next
~/.local/state/latteos/                                 # per user: session.log, safe.log, window-mode
~/.config/latteos/                                      # per user: locale, tier, coffee, wallpaper, hyprland.lua (the user's own choices)
~/.local/share/pleamar/goo/                             # per user: where the drops were left, the launcher's memory, settings.json, lock.json, clock.json, timers.json
/var/lib/latteos/login/user-*.json                      # per user, for the login screen: where the power drop is, the coffee
~/.cache/latteos/                                       # per user: the weather and the news last fetched

# Not in this repository's power to ship: Fedora packages, and programs built from someone else's source.
[needs]
package: greetd labwc tuigreet plymouth plymouth-plugin-two-step plymouth-theme-spinner egl-utils python3
package: rsms-inter-fonts jetbrains-mono-fonts policycoreutils-python-utils util-linux-core
package: foot less NetworkManager-tui                                # the SAFE session's terminal and rescue menu
package: hyprland wireplumber libnotify swaybg hypridle              # the GOO session; wpctl for the volume keys; notify-send when a timer rings; the wallpaper; the lock when idle
optional: mpvpaper                                                   # a film as the desktop's background
optional: cliphist wl-clipboard                                      # the clipboard in the shore's panel: what was copied lately
package: quickshell flatpak                                          # LatteOS's own apps are drawn by Quickshell; the App Manager's shop is Flathub
package: qt6-qtdeclarative xdg-desktop-portal-gtk                   # choosing a file in LatteOS's apps is the desktop's own window for it
package: nftables iproute                                            # latte-netd: cutting an app off the internet, closing its connections
package: pulseaudio-utils                                            # Settings › Sound (pactl)
package: fd-find xdg-utils xdg-user-dirs                             # the launcher: finding files, opening them, the home folders
optional: brightnessctl power-profiles-daemon                        # the brightness keys; the power profiles in PowerGoo's card
optional: steam gamescope gamescope-session gamescope-session-steam  # the Game session; without them it is not offered
/usr/bin/pleamar: pleamar v0.3.2 (github.com/k4ditano/pleamar) built with patches/pleamar-*.patch; see patches/README.md
optional /usr/lib64/latteos/hyprbars.so: hyprbars (github.com/hyprwm/hyprland-plugins) built for the installed Hyprland with patches/hyprbars-latte.patch
optional /usr/lib64/latteos/hyprglass.so: hyprglass (github.com/hyprnux/hyprglass) built for the installed Hyprland: the glass windows that go with drops of glass

# What `./install --go` runs once the files are in place, a command a line. USER stands for every user of the
# desktop (the line runs once for each), VERSION for every kernel installed.
[steps]
groupadd -f latte
usermod -aG latte USER
systemd-tmpfiles --create /usr/lib/tmpfiles.d/latteos.conf
semanage fcontext -a -t xdm_var_run_t '/run/latteos(/.*)?'          # the login screen runs as xdm_t and may read only its own labels
semanage fcontext -a -t xdm_var_lib_t '/var/lib/latteos/login(/.*)?'
restorecon -R /run/latteos /var/lib/latteos/login
fc-cache /usr/share/fonts/latteos
plymouth-set-default-theme latteos -R                               # rebuilds the initramfs
/etc/kernel/install.d/96-latteos-safe.install add VERSION
systemctl daemon-reload
systemctl enable latte-boot.service greetd.service latte-netd.service
systemctl disable NetworkManager-wait-online.service                # it held the login screen back for a minute
systemctl set-default graphical.target

# What `./install --remove` runs before the files go. Which login screen comes back is the system's own business.
[undo]
systemctl disable --now latte-netd.service
systemctl disable latte-boot.service greetd.service
systemctl enable NetworkManager-wait-online.service
/etc/kernel/install.d/96-latteos-safe.install remove VERSION
plymouth-set-default-theme spinner -R
semanage fcontext -d '/run/latteos(/.*)?'
semanage fcontext -d '/var/lib/latteos/login(/.*)?'
