# What `./install --go` runs once the files are in place, a command a line. USER stands for every user of the
# desktop (the line runs once for each), VERSION for every kernel installed.
[steps]
groupadd -f latte
usermod -aG latte USER
systemd-tmpfiles --create /usr/lib/tmpfiles.d/latteos.conf
semanage fcontext -a -t xdm_var_run_t '/run/latteos(/.*)?'          # the login screen runs as xdm_t and may read only its own labels
semanage fcontext -a -t xdm_var_lib_t '/var/lib/latteos/login(/.*)?'
restorecon -R /run/latteos /var/lib/latteos/login
fc-cache /usr/share/fonts/latteos
plymouth-set-default-theme latteos -R                               # rebuilds the initramfs
/etc/kernel/install.d/96-latteos-safe.install add VERSION
latte-guarddog manifest                                             # what LatteOS is made of, with hashes, for GuardDog
systemctl daemon-reload
systemctl enable latte-boot.service greetd.service latte-netd.service
systemctl enable --now latte-doghouse.timer                         # the root's watch over GuardDog
systemctl disable NetworkManager-wait-online.service                # it held the login screen back for a minute
systemctl set-default graphical.target
dnf versionlock add hyprland hyprland-devel hyprland-uwsm             # the plugins are built for this exact Hyprland; an update would break them

# What `./install --remove` runs before the files go. Which login screen comes back is the system's own business.
[undo]
dnf versionlock delete hyprland hyprland-devel hyprland-uwsm
systemctl disable --now latte-netd.service
systemctl disable --now latte-doghouse.timer
systemctl disable latte-boot.service greetd.service
systemctl enable NetworkManager-wait-online.service
/etc/kernel/install.d/96-latteos-safe.install remove VERSION
plymouth-set-default-theme spinner -R
semanage fcontext -d '/run/latteos(/.*)?'
semanage fcontext -d '/var/lib/latteos/login(/.*)?'
