+// LatteOS: the pointer kept on a button for 0.7 s runs on_button_hover ({index}: the button, counted from the edge as add_button does)
+void CHyprBar::updateButtonHoverTimer() {
+    const auto CMD = g_pGlobalState->config.onButtonHover->value();
+    int        idx = -1;
+    if (!CMD.empty() && validMapped(m_pWindow) && !m_bDraggingThis) {
+        const auto BARPADDING       = g_pGlobalState->config.barPadding->value();
+        const auto BARBUTTONPADDING = g_pGlobalState->config.barButtonPadding->value();
+        const auto HEIGHT           = g_pGlobalState->config.barHeight->value();
+        const bool BUTTONSRIGHT     = g_pGlobalState->config.barButtonsAlignment->value() != "left";
+        const auto COORDS           = cursorRelativeToBar();
+        float      offset           = BARPADDING;
+        int        i                = 0;
+        for (auto& b : g_pGlobalState->buttons) {
+            const auto BARBUF = Vector2D{(int)assignedBoxGlobal().w, HEIGHT};
+            const auto POS    = Vector2D{(BUTTONSRIGHT ? BARBUF.x - BARBUTTONPADDING - b.size - offset : offset), (BARBUF.y - b.size) / 2.0}.floor();
+            if (VECINRECT(COORDS, POS.x, POS.y, POS.x + b.size + BARBUTTONPADDING, POS.y + b.size)) {
+                idx = i;
+                break;
+            }
+            offset += BARBUTTONPADDING + b.size;
+            i++;
+        }
+    }
+    if (idx == m_hoverIdx)
+        return;
+    m_hoverIdx = idx;
+    if (!m_hoverTimer) {
+        m_hoverTimer = makeShared<CEventLoopTimer>(std::nullopt, [this](SP<CEventLoopTimer> self, void*) {
+            const auto PWINDOW = m_pWindow.lock();
+            if (m_hoverIdx < 0 || !PWINDOW)
+                return;
+            const auto  MOUSE = g_pInputManager->getMouseCoordsInternal();
+            std::string cmd   = g_pGlobalState->config.onButtonHover->value();
+            auto        repl  = [&cmd](const std::string& k, const std::string& v) {
+                for (size_t pos = cmd.find(k); pos != std::string::npos; pos = cmd.find(k, pos + v.size()))
+                    cmd.replace(pos, k.size(), v);
+            };
+            repl("{index}", std::to_string(m_hoverIdx));
+            repl("{x}", std::to_string((int)MOUSE.x));
+            repl("{y}", std::to_string((int)MOUSE.y));
+            repl("{address}", std::format("0x{:x}", (uintptr_t)PWINDOW.get()));
+            Config::Supplementary::executor()->spawn(cmd);
+        }, nullptr);
+        g_pEventLoopManager->addTimer(m_hoverTimer);
+    }
+    if (idx >= 0)
+        m_hoverTimer->updateTimeout(std::chrono::milliseconds(700));
+    else
+        m_hoverTimer->updateTimeout(std::nullopt);
+}
