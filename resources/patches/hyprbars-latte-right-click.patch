diff --git a/hyprbars/barDeco.cpp b/hyprbars/barDeco.cpp
index c27653d..a7c2807 100644
--- a/hyprbars/barDeco.cpp
+++ b/hyprbars/barDeco.cpp
@@ -1,3 +1,4 @@
+#include <linux/input-event-codes.h>
 #include "barDeco.hpp"
 
 #include <hyprland/src/Compositor.hpp>
@@ -126,6 +127,32 @@ void CHyprBar::onMouseButton(Event::SCallbackInfo& info, IPointer::SButtonEvent
     if (!inputIsValid())
         return;
 
+    // LatteOS: tlačidlá –□✕, ťahanie a dvojklik iba ľavým tlačidlom (ako Windows); pravý klik na titulok = ponuka okna
+    // (on_right_click), stredný nerobí nič. Kliky mimo titulku idú aplikácii bez zmeny.
+    if (e.button != BTN_LEFT) {
+        const auto COORDS = cursorRelativeToBar();
+        if (!VECINRECT(COORDS, 0, 0, assignedBoxGlobal().w, g_pGlobalState->config.barHeight->value() - 1))
+            return;
+        info.cancelled = true;
+        const auto PWINDOW = m_pWindow.lock();
+        const auto ON_RIGHT_CLICK = g_pGlobalState->config.onRightClick->value();
+        if (e.button == BTN_RIGHT && e.state == WL_POINTER_BUTTON_STATE_PRESSED && PWINDOW && !ON_RIGHT_CLICK.empty()) {
+            if (Desktop::focusState()->window() != PWINDOW)
+                Desktop::focusState()->fullWindowFocus(PWINDOW, Desktop::FOCUS_REASON_CLICK);
+            const auto  MOUSE = g_pInputManager->getMouseCoordsInternal();
+            std::string cmd   = ON_RIGHT_CLICK;
+            auto        repl  = [&cmd](const std::string& k, const std::string& v) {
+                for (size_t pos = cmd.find(k); pos != std::string::npos; pos = cmd.find(k, pos + v.size()))
+                    cmd.replace(pos, k.size(), v);
+            };
+            repl("{x}", std::to_string((int)MOUSE.x));
+            repl("{y}", std::to_string((int)MOUSE.y));
+            repl("{address}", std::format("0x{:x}", (uintptr_t)PWINDOW.get()));
+            Config::Supplementary::executor()->spawn(cmd);
+        }
+        return;
+    }
+
     if (e.state != WL_POINTER_BUTTON_STATE_PRESSED) {
         handleUpEvent(info);
         return;
