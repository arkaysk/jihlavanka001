# What happens when the session is left alone: the lock, the screens going dark, the lock before sleep
# (system/hypr/hypridle.conf, with the user's own times filled in by latte-idle). With its own file, so a
# ~/.config/hypr/hypridle.conf the user keeps for another desktop is neither read nor touched.
[Unit]
Description=LatteOS idle
PartOf=latte-session.target
After=latte-session.target latte-goo.service

# a stop or a crash brings it back at once, and it is never given up on (a deliberate stop of the unit still stops it)
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/libexec/latte-idle
Restart=always
RestartSec=1
