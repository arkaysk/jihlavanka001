# GuardDog: watches that what the desktop needs is running and starts again what is not (bin/latte-guarddog).
# It belongs to the session's target and goes when the session ends.
[Unit]
Description=LatteOS GuardDog
PartOf=latte-session.target
After=latte-session.target latte-goo.service

[Service]
ExecStart=/usr/bin/latte-guarddog watch
# what the guard started again is the session's, not the guard's: it stays when the guard is stopped or restarted
KillMode=process
Restart=on-failure
RestartSec=2
