# What the screen was used for, kept for the user alone (bin/latte-focus): ClockGoo's "Digital wellbeing".
[Unit]
Description=LatteOS screen time
PartOf=latte-session.target
After=latte-session.target

# a stop or a crash brings it back at once, and it is never given up on (a deliberate stop of the unit still stops it)
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/latte-focus watch
Restart=always
RestartSec=1
