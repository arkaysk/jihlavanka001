// Slovak for every scene in goo/: one table, so a text is translated once however many scenes show it.
// A scene imports this file; what it does not show is simply not used.
library Slovak {
    translations sk {
        "Name" = "Meno"
        "Password" = "Heslo"
        "Wrong password" = "Nesprávne heslo"
        "Checking…" = "Overujem…"
        "Log in" = "Prihlásiť"
        "Power" = "Napájanie"
        "Session" = "Relácia"
        "Last crash" = "Posledný pád"
        "News" = "Novinky"
        "Sleep" = "Uspať"
        "Restart" = "Reštartovať"
        "Shut down" = "Vypnúť"
        // the date under the clock, as date(1) formats it
        "%A, %-d %B" = "%A %-d. %B"
        "Log out" = "Odhlásiť"
        "Offline" = "Bez siete"
        "Terminal" = "Terminál"
        "Search mode" = "Režim hľadania"
        "Search apps…" = "Hľadať aplikácie…"
        "Run a Linux command…" = "Spustiť príkaz Linuxu…"
        "Run in console" = "Spustiť v konzole"
        "Dangerous command: press Enter again to run it" = "Nebezpečný príkaz: spustíš ho druhým Enterom"
        "SAFE" = "SAFE"
        "SAFE mode" = "Režim SAFE"
        "Rescue menu" = "Záchranná ponuka"
        "Try the full desktop again" = "Skúsiť plnú plochu znova"
        "Diagnostics: the last log of the session and of the desktop" = "Diagnostika: posledný záznam relácie a plochy"
        "Network" = "Sieť"
        "Undo the last update" = "Vrátiť poslednú aktualizáciu"
        "What was decided at boot" = "Čo sa rozhodlo pri štarte"
        "Close this menu" = "Zavrieť ponuku"
        "You chose SAFE at login" = "SAFE si zvolil pri prihlásení"
        "SAFE was asked for in the boot menu" = "SAFE bol zvolený v ponuke štartu"
        "SAFE was asked for this one start" = "SAFE bol vyžiadaný na tento jeden štart"
        "The desktop kept crashing" = "Plocha opakovane padala"
        "The desktop crashed right after it started" = "Plocha spadla hneď po štarte"
        "No working graphics driver" = "Nefunguje ovládač grafiky"
        "The full desktop is not installed" = "Plná plocha nie je nainštalovaná"
        "Clear{? · {place}}" = "Jasno{? · {place}}"
        "Partly cloudy{? · {place}}" = "Polojasno{? · {place}}"
        "Overcast{? · {place}}" = "Zamračené{? · {place}}"
        "Fog{? · {place}}" = "Hmla{? · {place}}"
        "Rain{? · {place}}" = "Dážď{? · {place}}"
        "Snow{? · {place}}" = "Sneh{? · {place}}"
        "Storm{? · {place}}" = "Búrka{? · {place}}"
        // the Goo desktop
        "Close" = "Zavrieť"
        "Back" = "Späť"
        "left: window mode · wheel: next window · right: show desktop" = "ľavý: režim okien · koliesko: ďalšie okno · pravý: ukázať plochu"
        "Tape" = "Páska"
        "Tiles" = "Dlaždice"
        "Floating windows" = "Plávajúce okná"
        "More windows" = "Ďalšie okná"
        "MORE WINDOWS" = "ĎALŠIE OKNÁ"
        "put away" = "schované"
        "Restore" = "Obnoviť"
        "Minimize" = "Minimalizovať"
        "Maximize" = "Maximalizovať"
        "Layout" = "Rozloženie"
        "Left half" = "Ľavá polovica"
        "Right half" = "Pravá polovica"
        "Top left" = "Vľavo hore"
        "Top right" = "Vpravo hore"
        "Bottom left" = "Vľavo dole"
        "Bottom right" = "Vpravo dole"
        "Center" = "Na stred"
        "Always on top (all desktops)" = "Vždy navrchu (všetky plochy)"
        "Move to desktop" = "Presunúť na plochu"
        "Desktop" = "Plocha"
        "New desktop" = "Nová plocha"
        "left: search and apps · right: recent apps" = "ľavý: hľadanie a aplikácie · pravý: naposledy spustené"
        "Applications" = "Aplikácie"
        "Command" = "Príkaz"
        "Run a command…" = "Spustiť príkaz…"
        "APPLICATIONS" = "APLIKÁCIE"
        "RECENTLY USED" = "NAPOSLEDY SPUSTENÉ"
        "App" = "Aplikácia"
        "Nothing found" = "Nič sa nenašlo"
        "Search…" = "Hľadať…"
        "Run in terminal" = "Spustiť v termináli"
        "Open terminal" = "Otvoriť terminál"
        "left: account and power · right: performance strip" = "ľavý: účet a napájanie · pravý: pás výkonu"
        "left: account and power · right: hide the strip" = "ľavý: účet a napájanie · pravý: skryť pás výkonu"
        "Processor" = "Procesor"
        "Memory" = "Pamäť"
        "Graphics" = "Grafika"
        "Video memory" = "Videopamäť"
        // a size in gibibytes with one decimal: the whole part, then the tenth
        "%d.%d G" = "%d,%d G"
        "since" = "od"
        "POWER" = "NAPÁJANIE"
        "Battery" = "Batéria"
        "charging" = "nabíja sa"
        "Saver" = "Úspora"
        "Balanced" = "Vyvážený"
        "Performance" = "Výkon"
        "Sure?" = "Naozaj?"
        "windows:" = "okná:"
    }
}
