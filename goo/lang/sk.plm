        "monitor resolution refresh scale screen rotate rotation hz main second arrange" = "monitor rozlíšenie obnovovacia mierka obrazovka otočiť otočenie hz hlavná druhá usporiadať"
        "tier gpu fps speed graphics card blur shadows animations effects" = "stupeň gpu fps rýchlosť grafická karta rozmazanie tiene animácie efekty"
