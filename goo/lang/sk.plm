        "Unlock" = "Odomknúť"
        "windows:" = "okná:"
        // ClockGoo
        "Sunday" = "Nedeľa"
        "Monday" = "Pondelok"
        "Tuesday" = "Utorok"
        "Wednesday" = "Streda"
        "Thursday" = "Štvrtok"
        "Friday" = "Piatok"
        "Saturday" = "Sobota"
        "Su" = "ne"
