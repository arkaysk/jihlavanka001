// What is in the card (its state and frame: parts/card.plm), and the tooltip.
// The card is a column: the tabs, the field, then the rows, which scroll when they are more than fit.
part Rows {
    // ── the zones under the rows, in the order they have to be declared: the last one takes the press ───────
    // A press anywhere else closes the card; one on the card's own ground does nothing.
    zone box card_away { at: W / 2, H / 2; size: W, H; active: card_open; label: "Close"; role: button }
    on press card_away { card_open = false; emit card_closed }
    on press right card_away { card_open = false; emit card_closed }
    zone box card_ground { from: card.x0, card.y0; size: card.w, card.h; active: card_open; agent: hidden }
    on scroll card_ground while list.content <= list.height + 1 { emit card_spin(if(wheel > 0, 0, 1)) }

    on key Escape while card_open { card_open = false; emit card_closed }
    on key Tab while card_open { emit card_next(1) }
    on key Shift+Tab while card_open { emit card_next(0) }
    on key Down while card_open { emit card_key(1) }
    on key Up while card_open { emit card_key(0) }
    on key Return while card_open and not card_field { emit card_enter }
    on submit card_q { emit card_enter }
    on submit card_pw { emit card_enter }

    let card.tw = card.w - 16                  // what the tabs and the field have: the card without its padding
    let card.iw = card.tw - card_w2            // …the rows of the first column
    let card.sw = max(card_w2 - 8, 0)          // …and those of the second
    let tab.wide = max(card.tw - (tab.count - 1) * 50, 44)

    group {
        opacity: clamp(card.p * 2 - 1, 0, 1)
        // A closed card is most of the time: nothing of it is worked out then.
        show: card.p > 0.01
        // what is written is not drawn past the frame, which is still narrow while it grows from the ear
        clip box { at: card.ax + card.sx * card.cw / 2, card.ay + card.sy * card.ch / 2; size: card.cw, card.ch; corner: 18 }
        column card_col {
            at: card.x0, card.y0
            padding: 8

            // the tabs: the chosen one is wide and says its name, the others are their icons
            row tabs ~nimble {
                gap: 6
                show: tab.count > 0
                for t in tab {
                    group {
                        size: if(t.on, tab.wide, 44), 44
                        box { from: 0, 3; size: if(t.on, tab.wide, 44), 38; corner: 19; color: if(t.on, gold, #4a372b); opacity: if(t.on, 24%, 45% + 55% * tab_hit.hover) }
                        text t.glyph { at: if(t.on, 24, 22), 22; anchor: center; size: 16; color: if(t.on, gold, cream); opacity: 90%; family: "tabler-icons" }
                        text t.label { at: 44, 22; anchor: left center; width: tab.wide - 56; lines: 1; size: 14; weight: 600; color: gold; show: t.on; family: "Inter" }
                        zone box tab_hit { from: 0, 2; size: if(t.on, tab.wide, 44), 40; cursor: pointer; role: tab; selected: t.on; label: "{t.label}" }
                        on press tab_hit { emit card_tab(t.index) }
                    }
                }
            }

            // the field
            group {
                size: card.tw, 46
                show: card_field
                box { from: 0, 2; size: card.tw, 40; corner: 14; color: #3d2c22 }
                text pick(card_secret, g_search, g_key) { at: 22, 22; anchor: center; size: 17; color: dim; family: "tabler-icons" }
                text card_hint { at: 44, 22; anchor: left center; width: card.tw - 60; lines: 1; size: 15; color: dim; show: not card_typed; family: "Inter" }
                input card_q { at: 44, 12; width: card.tw - 60; size: 15; color: cream; selection: #5a463a; show: not card_secret; family: "Inter" }
                // a password is typed into a field of its own, which shows dots
                input card_pw { at: 44, if(card_secret, 12, -4000); width: card.tw - 60; size: 15; color: cream; selection: #5a463a; secret: true; show: card_secret; family: "Inter"; agent: no }
                zone box field_hit { from: 0, 2; size: card.tw, 40; cursor: text }
                on press field_hit while not card_secret { focus card_q }
                on press field_hit while card_secret { focus card_pw }
            }

            row {
                column list {
                    view: card.iw, min(list.content, H - 40 - if(tab.count > 0, 44, 0) - if(card_field, 46, 0))
                    step: 44
                    for r in card { CardRow(r, 0, card.iw) }
                }
                space if(card_w2 > 0, 8, 0)
                column {
                    show: card_w2 > 0
                    // ── a month: its name between two arrows, the days of the week, six weeks of days ───────
                    group {
                        size: card.sw, 300
                        show: cal_on
                        let cell = (card.sw - 40) / 7
                        text cal_title { at: card.sw / 2, 20; anchor: center; size: 16; weight: 700; color: cream; family: "Inter" }
                        text g_back { at: 34, 20; anchor: center; size: 18; color: cream; opacity: 60% + 40% * cal_prev.hover; family: "tabler-icons" }
                        text g_more { at: card.sw - 34, 20; anchor: center; size: 18; color: cream; opacity: 60% + 40% * cal_next.hover; family: "tabler-icons" }
                        zone box cal_prev { at: 34, 20; size: 48, 36; cursor: pointer; label: "Previous month" }
                        zone box cal_next { at: card.sw - 34, 20; size: 48, 36; cursor: pointer; label: "Next month" }
                        on press cal_prev { emit cal_step(0) }
                        on press cal_next { emit cal_step(1) }
                        repeat w in 0..7 {
                            text weekday.$w.name { at: 20 + cell * (w + 0.5), 54; anchor: center; size: 12; color: dim; family: "Inter" }
                        }
                        repeat q in 0..42 {
                            let dx.$q = 20 + cell * (q - 7 * floor(q / 7) + 0.5)
                            let dy.$q = 88 + 35 * floor(q / 7)
                            // the weeks come in one after another
                            let da.$q = clamp(reveal * 2.4 - 0.2 * floor(q / 7), 0, 1)
                            ellipse { at: dx.$q, dy.$q; radius: 15.5; color: gold; opacity: if(day.$q.today, 100%, 22% * day_hit.$q.hover) * da.$q; show: q < day.count }
                            ellipse { at: dx.$q, dy.$q; radius: 15.5; stroke: 1.5; color: gold; opacity: if(day.$q.chosen, 90%, 0); show: q < day.count }
                            text day.$q.n { at: dx.$q, dy.$q; anchor: center; size: 14; weight: 600; color: if(day.$q.today, paper, cream); opacity: if(day.$q.dim, 35%, 100%) * da.$q; show: q < day.count; family: "Inter" }
                            ellipse { at: dx.$q, dy.$q + 12; radius: 2; color: if(day.$q.today, paper, gold); show: q < day.count and day.$q.dot }
                            zone box day_hit.$q { at: dx.$q, dy.$q; size: cell - 2, 33; cursor: pointer; active: card_open and cal_on and q < day.count; label: "{day.$q.n}"; selected: day.$q.chosen }
                            on press day_hit.$q { emit cal_pick(q) }
                        }
                        zone box cal_ground { from: 0, 40; size: card.sw, 40; active: card_open and cal_on; agent: hidden }
                        on scroll cal_ground { emit cal_step(if(wheel > 0, 0, 1)) }
                    }
                    for r in card2 { CardRow(r, 24, card.sw) }
                }
            }
        }
    }

    // ── one row of the card. A `let` only lives in a component, hence one for the row and one for its items.
    component CardRow(r: record, base: number, w: number) {
        size: w, parts.height
        // the rows come in one after another, each a little later, sliding in from the ear's side
        let come = clamp(reveal * 3.2 - 0.1 * r.index, 0, 1)
        let shown = come * come * (3 - 2 * come)
        let h = pick(r.kind, if(r.tall, 54, 44), 30, 64, 0, 0, 0, 84, 44)

        column parts {
            // a rule above the row
            group {
                size: w, 14
                show: r.line
                box { at: w / 2, 7; size: (w - 36) * shown, 1; color: #5a463a }
            }

            // ── a plain row, a heading, a large figure, a profile ───────────────────────────────────────────
            group {
                size: w, h
                show: r.kind != para and r.kind != pills and r.kind != tiles
                opacity: shown
                move: (1 - shown) * 18 * card.sx, 0

                // Of glass, a tile is a lighter pane in the card's glass: a veil of colour over it would be taken
                // for what is behind the card and come back through the glass a frame later.
                // A tile is drawn row by row: each lays its piece and, unless it is the last, reaches under the next
                // one, which covers that with its own; so the tile's corners are round only at its two ends.
                box { from: 2, if(r.tile == 1 or r.tile == 4, 1, 0); size: w - 4, h + if(r.tile == 1 or r.tile == 2, 14 - 17 * card.glass, -1 - 2 * card.glass) - if(r.tile == 1 or r.tile == 4, 1, 0); corner: 15; color: mix(paper, cream, 0.075); glass: card.glass * 100%; frost: 100%; smoke: 38% * card.glass; milk: 10% * card.glass; refraction: 40% * card.glass; show: r.tile > 0 }
                box { at: w / 2, h / 2; size: w - if(r.tile > 0, 12, 0), h - 4; corner: 12; color: if(r.danger, red, #4a372b); opacity: max(hit.hover, if(card_sel == (r.index + base) * 8, 1, 0)) * if(r.danger, 18%, 100%); show: r.kind == plain or r.kind == big }

                // plain
                image r.icon { at: 15, if(r.tall, 13, 9); size: 26, 26; show: r.kind == plain and r.has_icon }
                text r.glyph { at: 28, if(r.tall, 26, 22); anchor: center; size: 18; color: if(r.danger, red, cream); opacity: if(r.off, 40%, 90%); show: r.kind == plain and not r.has_icon and not r.on; family: "tabler-icons" }
                text g_check { at: 28, 22; anchor: center; size: 17; color: gold; show: r.kind == plain and r.on; family: "tabler-icons" }
                text r.label { at: 56, if(r.tall, 17, 22); anchor: left center; width: w - if(r.more, 96, 82); lines: 1; size: 15; weight: 500; color: if(r.danger, red, cream); opacity: if(r.off, 45%, 100%); show: r.kind == plain; family: "Inter" }
                text r.line2 { at: 56, 36; anchor: left center; width: w - 82; lines: 1; size: 12.5; color: dim; show: r.kind == plain and r.tall; family: "Inter" }
                text r.hint { at: w - 18, if(r.tall, 17, 22); anchor: right center; size: 13; color: dim; show: r.kind == plain and not r.more; family: "Inter" }
                text g_more { at: w - 22, h / 2; anchor: center; size: 16; color: dim; show: (r.kind == plain and r.more) or (r.kind == profile and not r.quiet); family: "tabler-icons" }

                // a heading
                text r.label { at: 22, 15; anchor: left center; width: w - 120; lines: 1; size: 11.5; weight: 700; color: dim; show: r.kind == head; family: "Inter" }
                text r.hint { at: w - 18, 15; anchor: right center; size: 13; color: dim; show: r.kind == head; family: "Inter" }

                // a large figure
                text r.label { at: 22, 28; anchor: left center; width: w - 44; lines: 1; size: 34; weight: 700; color: cream; show: r.kind == big; family: "Inter" }

                // a bar under a plain row or a large figure
                box { from: if(r.kind == big, 22, 56), if(r.kind == big, 54, 38); size: w - if(r.kind == big, 44, 74), 3; corner: 1.5; color: #5a463a; show: r.bar >= 0 and r.kind != slide }
                box { from: if(r.kind == big, 22, 56), if(r.kind == big, 54, 38); size: (w - if(r.kind == big, 44, 74)) * clamp(r.bar, 0, 1) * shown, 3; corner: 1.5; color: gold; show: r.bar > 0 and r.kind != slide }

                // a profile: the portrait cut round by a ring of the card's colour
                image r.icon { at: 18, 12; size: 60, 60; show: r.kind == profile and r.has_icon }
                ellipse { at: 48, 42; radius: 37; stroke: 14; color: paper; show: r.kind == profile and r.has_icon }
                ellipse { at: 48, 42; radius: 30; color: #4a372b; show: r.kind == profile and not r.has_icon }
                text r.glyph { at: 48, 42; anchor: center; size: 28; color: cream; opacity: 90%; show: r.kind == profile and not r.has_icon; family: "tabler-icons" }
                ellipse { at: 48, 42; radius: 30.5; stroke: 1.5; color: gold; opacity: 70%; show: r.kind == profile }
                text r.label { at: 94, 32; anchor: left center; width: w - 128; lines: 1; size: 18; weight: 700; color: cream; show: r.kind == profile; family: "Inter" }
                text r.line2 { at: 94, 55; anchor: left center; width: w - 128; lines: 1; size: 12.5; color: dim; show: r.kind == profile; family: "Inter" }

                // a slider: its icon, the track with what is filled, the knob, and the figure on the right
                text r.glyph { at: 28, 22; anchor: center; size: 18; color: cream; opacity: 60% + 40% * knob_hit.hover; show: r.kind == slide; family: "tabler-icons" }
                box { from: 56, 20.5; size: w - 130, 3; corner: 1.5; color: #5a463a; show: r.kind == slide }
                box { from: 56, 20.5; size: (w - 130) * clamp(r.bar, 0, 1), 3; corner: 1.5; color: gold; opacity: if(r.off, 40%, 100%); show: r.kind == slide }
                ellipse { at: 56 + (w - 130) * clamp(r.bar, 0, 1), 22; radius: 6 + 1.5 * hit.hover; color: if(r.off, dim, gold); show: r.kind == slide }
                text r.hint { at: w - 18, 22; anchor: right center; size: 13; color: dim; show: r.kind == slide; family: "Inter" }

                zone box hit { from: if(r.kind == slide, 46, 0), 1; size: w - if(r.kind == slide, 100, 0), h - 2; cursor: pointer; active: card_open and not r.off and not r.quiet and r.kind != head; label: "{r.label}"; selected: r.on }
                zone box knob_hit { from: 4, 1; size: 42, h - 2; cursor: pointer; active: card_open and r.kind == slide; label: "{r.label}" }
                on press knob_hit { emit card_pick((r.index + base) * 8) }
                on press hit while r.kind == slide { emit card_slide((r.index + base) * 1024 + round(clamp((local.x - 56) / (w - 130), 0, 1) * 1000)) }
                on drag hit while r.kind == slide { emit card_slide((r.index + base) * 1024 + round(clamp((local.x - 56) / (w - 130), 0, 1) * 1000)) }
                on press hit while r.kind != slide { emit card_pick((r.index + base) * 8) }
                on press right hit { emit card_right((r.index + base) * 8) }
                on scroll hit { emit card_wheel((r.index + base) * 2 + if(wheel > 0, 1, 0)) }
            }

            // ── a paragraph: as tall as its text ────────────────────────────────────────────────────────────
            row {
                show: r.kind == para
                padding: 14
                opacity: shown
                column {
                    fill: #3d2c22 85%
                    corner: 14
                    padding: 12
                    text r.label { width: w - 52; lines: 14; size: 14.5; line_height: 1.4; color: cream; family: "Inter"; selectable: true; selection: #5a463a }
                }
            }

            // ── buttons side by side, or apps as tiles ──────────────────────────────────────────────────────
            row {
                show: r.kind == pills or r.kind == tiles
                opacity: shown
                wrap: 6
                for it in r.items { CardItem(r, it, base, w) }
            }
        }
    }

    component CardItem(r: record, it: record, base: number, cw: number) {
        size: cw / if(r.kind == tiles, r.per, max(r.items.count, 1)), if(r.kind == tiles, 88, 46)
        let w = cw / if(r.kind == tiles, r.per, max(r.items.count, 1))
        let lit = max(hit.hover, if(card_sel == (r.index + base) * 8 + it.index + 1, 1, 0))

        // a button: the chosen one gold, one that does not undo red
        box { at: w / 2, 23; size: w - 10, 40; corner: 20; color: if(it.on, gold, if(it.danger, red, #4a372b)); opacity: if(it.on, 26%, if(it.danger, 16% + 12% * lit, 62% + 38% * lit)) * if(it.off, 0.5, 1); show: r.kind == pills }
        row {
            at: w / 2, 23
            anchor: center middle
            gap: 7
            align: center
            show: r.kind == pills
            opacity: if(it.off, 45%, 100%)
            text it.glyph { size: 17; color: if(it.on, gold, if(it.danger, red, cream)); family: "tabler-icons" }
            text it.label { size: 14; weight: 600; lines: 1; color: if(it.on, gold, if(it.danger, red, cream)); family: "Inter" }
        }
        // a tile: the app's icon over its name
        box { at: w / 2, 44; size: w - 6, 84; corner: 16; color: #4a372b; opacity: lit; show: r.kind == tiles }
        image it.icon { at: w / 2 - 20, 12; size: 40, 40; show: r.kind == tiles and it.has_icon }
        text it.glyph { at: w / 2, 32; anchor: center; size: 28; color: cream; opacity: 90%; show: r.kind == tiles and not it.has_icon; family: "tabler-icons" }
        text it.label { at: w / 2, 68; anchor: center; width: w - 14; lines: 1; size: 12.5; weight: 500; color: cream; align: center; show: r.kind == tiles; family: "Inter" }

        zone box hit { from: 3, 2; size: w - 6, if(r.kind == tiles, 84, 42); cursor: pointer; active: card_open and not it.off; label: "{it.label}"; selected: it.on }
        on press hit { emit card_pick((r.index + base) * 8 + it.index + 1) }
        on press right hit { emit card_right((r.index + base) * 8 + it.index + 1) }
    }

    // ── the tooltip: a drop's name and what it does. What the drop shows does not change under the pointer.
    text tip = ""
    fact tip_k = -1
    fact tip.x = 0
    fact tip.y = 0
    prop tip.p = 0 ~grow
    measure tip_size
    let tip.h = max(tip_size.height, 16) + 14
    // Chosen from the keyboard, a drop's tooltip stays beside it wherever it moves.
    let kb.nx = if(kb.edge == 1, 1, if(kb.edge == 3, -1, 0))
    let kb.ny = if(kb.edge == 0, -1, if(kb.edge == 2, 1, 0))
    let tip.cx = if(kb, kb.x + kb.nx * (kb.r + 130), tip.x)
    let tip.cy = if(kb, kb.y + kb.ny * (kb.r + 14) + if(kb.ny > 0, 30, 0), tip.y)
    let tip.a = max(tip.p, kb.p) * if(card_open, 0, 1)
    box { from: tip.cx - tip_size.width / 2 - 14, tip.cy + 15 - tip.h; size: tip_size.width + 28, tip.h; corner: min(15, tip.h / 2); color: coffee; opacity: tip.a * 0.94 }
    text tip { at: tip.cx, tip.cy + 15 - tip.h / 2; anchor: center; measure: tip_size; size: 12; color: ink; opacity: tip.a; width: 210; align: center; family: "Inter" }

    // ── a new notification, said once: a note in the corner where Windows puts its own, above the shore. It
    // takes no keyboard and no press but its own; it waits in ClockGoo after it has gone (drops/clockgoo.luau).
    text toast_title = ""
    text toast_body = ""
    fact toast_n = 0                           // the logic counts up for each one to be said
    event toast_press ->
    prop toast.p = 0 ~grow
    on change toast_n { toast.p: 1; toast.p: 0 ~500ms after 6500ms }
    let toast.w = 360
    let toast.x = W - toast.w - 14
    let toast.y = H - 46 - 104 + 26 * (1 - toast.p)
    box { from: toast.x, toast.y; size: toast.w, 86; corner: 18; color: coffee; opacity: toast.p * 0.96 }
    text toast_title { at: toast.x + 18, toast.y + 26; anchor: left center; width: toast.w - 36; lines: 1; size: 14; weight: 700; color: ink; opacity: toast.p; family: "Inter" }
    text toast_body { at: toast.x + 18, toast.y + 54; anchor: left center; width: toast.w - 36; lines: 2; size: 12.5; color: ink; opacity: toast.p * 0.8; family: "Inter" }
    zone box toast_hit { from: toast.x, toast.y; size: toast.w, 86; cursor: pointer; active: toast.p > 0.6 and not card_open; label: "{toast_title}" }
    on press toast_hit { toast.p: 0 ~200ms; emit toast_press }
    on press right toast_hit { toast.p: 0 ~200ms }
}
