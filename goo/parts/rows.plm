// What is in the card (its state and frame: parts/card.plm), and the tooltip.
// The card is a column: the tabs, the field, then the rows, which scroll when they are more than fit.
part Rows {
    // ── the zones under the rows, in the order they have to be declared: the last one takes the press ───────
    // A press anywhere else closes the card; one on the card's own ground does nothing.
    zone box card_away { at: W / 2, H / 2; size: W, H; active: card_open; label: "Close"; role: button }
    on press card_away { card_open = false; emit card_closed }
    on press right card_away { card_open = false; emit card_closed }
    zone box card_ground { from: card.x0, card.y0; size: card.w, card.h; active: card_open; agent: hidden }
    // the wheel over LensShore's panel turns its modes as a tape (the user, 29. 10.: "the scroll is to the right and
    // left"), down or to the right the next one; two fingers and a tilted wheel too (lib/lens.luau gathers the turns)
    on scroll card_ground while card_lens { emit lens_swipe(round(-wheel * 1000)) }

    // while a menu is open over the card (parts/ctx.plm) the keys are the menu's
    on key Escape while card_open and not ctx_open { card_open = false; emit card_closed }
    on key Tab while card_open and not ctx_open { emit card_next(1) }
    on key Shift+Tab while card_open and not ctx_open { emit card_next(0) }
    on key Ctrl+Tab while card_open and not ctx_open { emit card_next(1) }
    on key Ctrl+Shift+Tab while card_open and not ctx_open { emit card_next(0) }
    on key Down while card_open and not ctx_open { emit card_key(1) }
    on key Up while card_open and not ctx_open { emit card_key(0) }
    on key Return while card_open and not card_field and not ctx_open { emit card_enter }
    // Ctrl+K: the chosen row's actions (6B.24), at the card's foot on the right, as Raycast's Action Panel
    on key Ctrl+Return while card_open and not ctx_open { emit card_combo(1) }
    on key Ctrl+period while card_open and not ctx_open { emit card_combo(2) }
    on key Ctrl+e while card_open and not ctx_open { emit card_combo(3) }
    on key Ctrl+plus while card_open and not ctx_open { emit card_combo(4) }
    on key Ctrl+equal while card_open and not ctx_open { emit card_combo(4) }
    on key Ctrl+minus while card_open and not ctx_open { emit card_combo(5) }
    on key Next while card_open and not ctx_open { emit card_combo(7) }          // Page Down: the keyboard calls it Next
    on key Prior while card_open and not ctx_open { emit card_combo(8) }
    on key Ctrl+p while card_open and not ctx_open { emit card_combo(9) }
    on key Ctrl+x while card_open and not ctx_open { emit card_combo(10) }
    on key Ctrl+Shift+x while card_open and not ctx_open { emit card_combo(11) }
    on key Ctrl+k while card_open and card_more and not ctx_open { tap.x = card.x0 + card.w - ctx_w - 8; tap.y = card.y0 + card.h - 8; emit card_actions }
    on submit card_q { emit card_enter }
    on submit card_pw { emit card_enter }

    let card.tw = card.w - 16                  // what the tabs and the field have: the card without its padding
    let card.iw = card.tw - card_w2            // …the rows of the first column
    let card.sw = max(card_w2 - 8, 0)          // …and those of the second
    let tab.wide = max(card.tw - (tab.count - 1) * 50, 44)
    // where all of them fit with their names, they are all shown with them, side by side
    let tab.full = tab.count > 0 and tab.count * 118 + (tab.count - 1) * 6 <= card.tw
    let tab.eq = (card.tw - (tab.count - 1) * 6) / max(tab.count, 1)

    group {
        opacity: clamp(card.p * 2 - 1, 0, 1)
        // A closed card is most of the time: nothing of it is worked out then.
        show: card.p > 0.01
        // what is written is not drawn past the frame, which is still narrow while it grows from the ear
        // (LensShore's panel goes on into its plate: so does what is drawn in it, with no round corner there)
        clip box { at: card.ax + card.sx * card.cw / 2, card.ay + card.sy * (card.ch - if(card_lens, 40, 0)) / 2; size: card.cw, card.ch + if(card_lens, 40, 0); corner: if(card_menu, 12, min(if(ear > 14, 26, 18) + (card.round - 18), min(card.cw, card.ch) / 2)) }
        // Below a wave row the card is coffee to its very edge (above it, when the card hangs from the top edge: LensShore
        // up there): three velvet layers lit with gold (shaders/velvet.wgsl), each lapping its own way. It is drawn here,
        // over the whole card, because the rows have padding and cannot reach the edge; a hair is left at the edge for
        // the card's rim. card.sp is where the surface stands, from the card's top: card_split from the top
        // (lib/card.luau), or card_tail from the bottom when what is above is not known (LensShore's answers). At
        // LensShore's plate the coffee runs on into it, past the panel's foot.
        // A card that opens swings its coffee once: two springs lag behind the opening as the coffee's modes do.
        let card.sp = if(card_tail > 0, if(card_lens and lens_edge == 2, card_tail * card.z, card.h - card_tail * card.z), card_split * card.z)
        let card.bi = if(card_lens, -3, 1.5)      // LensShore: the coffee runs on past the panel's foot into the plate
        let card.up = card_lens and lens_edge == 2
        let card.swing = card.m1 - card.p
        shader velvet { at: card.x0 + 1.5, card.y0 + if(card.up, 1.5, card.sp - 40); size: card.w - 3, if(card.up, card.sp + 41.5, card.h - card.bi - card.sp + 40)
                        show: card_split > 0 or card_tail > 0
                        values: card.swing * 10 * card.sx, card.swing * 4, (card.m3 - card.p) * 8, 1, 52, 0.68, if(card.up, 1, 0)
                        colors: gold, coffee }
        // the card of ClockGoo is a scene of its own, drawn over the whole card (clock.plm)
        include "clock.plm"
        include "cam.plm"
        include "ai.plm"
        include "calendar.plm"
        column card_col {
            at: card.x0, card.y0
            padding: 8

            // the tabs: the chosen one is wide and says its name, the others are their icons
            row tabs ~nimble {
                gap: 6
                show: tab.count > 0
                for t in tab {
                    group {
                        size: if(tab.full, tab.eq, if(t.on, tab.wide, 44)), 44
                        box { from: 0, 3; size: if(tab.full, tab.eq, if(t.on, tab.wide, 44)), 38; corner: 19; color: if(t.on, gold, #4a372b); opacity: if(t.on, 24%, 45% + 55% * tab_hit.hover) }
                        text t.glyph { at: if(t.on or tab.full, 24, 22), 22; anchor: center; size: 16; color: if(t.on, gold, cream); opacity: 90%; family: "tabler-icons" }
                        text t.label { at: 44, 22; anchor: left center; width: if(tab.full, tab.eq, tab.wide) - 56; lines: 1; size: 14; weight: 600; color: if(t.on, gold, cream); show: t.on or tab.full; family: "Inter" }
                        zone box tab_hit { from: 0, 2; size: if(tab.full, tab.eq, if(t.on, tab.wide, 44)), 40; cursor: pointer; role: tab; selected: t.on; label: "{t.label}" }
                        on press tab_hit { emit card_tab(t.index) }
                        on scroll tab_hit { emit card_next(if(wheel > 0, 0, 1)) }   // the wheel over the tabs turns them, on every tab (AI too)
                    }
                }
            }

            // the field
            group {
                size: card.tw, 46
                show: card_field
                box { from: 0, 2; size: card.tw, 40; corner: 14; color: #3d2c22 }
                text pick(card_secret, g_search, g_key) { at: 22, 22; anchor: center; size: 17; color: dim; family: "tabler-icons" }
                text card_hint { at: 44, 22; anchor: left center; width: card.tw - 60; lines: 1; size: 15; color: dim; show: not card_typed; family: "Inter" }
                input card_q { at: 44, 12; width: card.tw - 60; size: 15; color: cream; selection: #5a463a; show: not card_secret; family: "Inter" }
                on press right card_q { tap.x = cursor.x; tap.y = cursor.y; emit card_field_menu }
                // a password is typed into a field of its own, which shows dots
                input card_pw { at: 44, if(card_secret, 12, -4000); width: card.tw - 60; size: 15; color: cream; selection: #5a463a; secret: true; show: card_secret; family: "Inter"; agent: no }
                zone box field_hit { from: 0, 2; size: card.tw, 40; cursor: text }
                on press field_hit while not card_secret { focus card_q }
                on press field_hit while card_secret { focus card_pw }
                on press right field_hit while not card_secret { tap.x = cursor.x; tap.y = cursor.y; emit card_field_menu }   // cut, copy, paste
            }

            row {
                column list {
                    view: card.iw, min(list.content, H - 40 - if(tab.count > 0, 44, 0) - if(card_field, 46, 0))
                    step: 44
                    for r in card { CardRow(r, 0, card.iw) }
                }
                space if(card_w2 > 0, 8, 0)
                column {
                    show: card_w2 > 0
                    // ── a month: its name between two arrows, the days of the week, six weeks of days ───────
                    group {
                        size: card.sw, 300
                        show: cal_on
                        let cell = (card.sw - 40) / 7
                        text cal_title { at: card.sw / 2, 20; anchor: center; size: 16; weight: 700; color: cream; family: "Inter" }
                        text g_back { at: 34, 20; anchor: center; size: 18; color: cream; opacity: 60% + 40% * cal_prev.hover; family: "tabler-icons" }
                        text g_more { at: card.sw - 34, 20; anchor: center; size: 18; color: cream; opacity: 60% + 40% * cal_next.hover; family: "tabler-icons" }
                        zone box cal_prev { at: 34, 20; size: 48, 36; cursor: pointer; label: "Previous month" }
                        zone box cal_next { at: card.sw - 34, 20; size: 48, 36; cursor: pointer; label: "Next month" }
                        on press cal_prev { emit cal_step(0) }
                        on press cal_next { emit cal_step(1) }
                        repeat w in 0..7 {
                            text weekday.$w.name { at: 20 + cell * (w + 0.5), 54; anchor: center; size: 12; color: dim; family: "Inter" }
                        }
                        repeat q in 0..42 {
                            let dx.$q = 20 + cell * (q - 7 * floor(q / 7) + 0.5)
                            let dy.$q = 88 + 35 * floor(q / 7)
                            // the weeks come in one after another
                            let da.$q = clamp(reveal * 2.4 - 0.2 * floor(q / 7), 0, 1)
                            ellipse { at: dx.$q, dy.$q; radius: 15.5; color: gold; opacity: if(day.$q.today, 100%, 22% * day_hit.$q.hover) * da.$q; show: q < day.count }
                            ellipse { at: dx.$q, dy.$q; radius: 15.5; stroke: 1.5; color: gold; opacity: if(day.$q.chosen, 90%, 0); show: q < day.count }
                            text day.$q.n { at: dx.$q, dy.$q; anchor: center; size: 14; weight: 600; color: if(day.$q.today, paper, cream); opacity: if(day.$q.dim, 35%, 100%) * da.$q; show: q < day.count; family: "Inter" }
                            ellipse { at: dx.$q, dy.$q + 12; radius: 2; color: if(day.$q.today, paper, gold); show: q < day.count and day.$q.dot }
                            zone box day_hit.$q { at: dx.$q, dy.$q; size: cell - 2, 33; cursor: pointer; active: card_open and cal_on and q < day.count; label: "{day.$q.n}"; selected: day.$q.chosen }
                            on press day_hit.$q { emit cal_pick(q) }
                        }
                        zone box cal_ground { from: 0, 40; size: card.sw, 40; active: card_open and cal_on; agent: hidden }
                        on scroll cal_ground { emit cal_step(if(wheel > 0, 0, 1)) }
                    }
                    for r in card2 { CardRow(r, 24, card.sw) }
                }
            }
        }
    }

    // ── the ear's words over the card: the drop the card grows from sits in its corner, and what the card holds
    // (its coffee, ClockGoo's month) is painted after the drops' faces; its time or name is painted once more on top
    // (6D.11). Only the words: the drop itself stays under the card as it was.
    repeat k in 0..32 {
        // as parts/faces.plm works them out
        let ef.$k = max(face.$k / 2.4, 0.01)
        let eo.$k = if(goo.$k.cap_dir < 0, 0, cap.$k * (goo.$k.cap_dir - 1))
        let ex.$k = if(goo.$k.edge == 1 or goo.$k.edge == 3, 0, eo.$k)
        let ey.$k = if(goo.$k.edge == 1 or goo.$k.edge == 3, eo.$k, 0)
        let et.$k = ef.$k * if(goo.$k.zoom < 0.8, 1.25, 1)
        group {
            show: card_owner == k and card.p > 0.01 and goo.$k.on
            group {
                pivot: x.$k, y.$k
                scale: ef.$k
                text goo.$k.glyph { at: x.$k + ex.$k / ef.$k, y.$k + (ey.$k - if(goo.$k.kind == 1 or goo.$k.cap > 0, 0, rr.$k * 0.08)) / ef.$k; anchor: center; size: 48; color: ink; opacity: if(goo.$k.kind != 2 and not goo.$k.has_icon, 0.92, 0) * (1 - 0.55 * goo.$k.dim); family: "tabler-icons" }
                text goo.$k.label { at: x.$k, y.$k + rr.$k * 0.42 / ef.$k; anchor: center; size: 21.6; weight: 700; color: ink; opacity: if(goo.$k.kind != 2 and goo.$k.cap == 0, 0.9, 0); family: "Inter" }
                text goo.$k.line2 { at: x.$k, y.$k + rr.$k * 0.36 / ef.$k; anchor: center; size: 19.2; color: ink; opacity: if(goo.$k.kind == 2 and goo.$k.zoom >= 0.8, 0.75, 0); family: "Inter" }
            }
            group {
                pivot: x.$k, y.$k
                scale: et.$k
                text goo.$k.label { at: x.$k, y.$k - rr.$k * if(goo.$k.zoom < 0.8, 0, 0.12) / et.$k; anchor: center; size: 33.6; weight: 700; color: ink; opacity: if(goo.$k.kind == 2, 1, 0); family: "Inter" }
            }
        }
    }

    // ── one row of the card. A `let` only lives in a component, hence one for the row and one for its items.
    component CardRow(r: record, base: number, w: number) {
        size: w, parts.height
        // the rows come in one after another, each a little later, sliding in from the ear's side
        let come = clamp(reveal * 3.2 - 0.1 * r.index, 0, 1)
        let shown = come * come * (3 - 2 * come)
        let h = if(r.prev, 78, if(r.kind == gap, max(r.bar, 0), pick(r.kind, if(r.tall, 54, 44), 30, 64, 0, 0, 0, 84, 44, 26)))

        column parts {
            // a rule above the row
            group {
                size: w, 14
                show: r.line
                box { at: w / 2, 7; size: (w - 36) * shown, 1; color: #5a463a }
            }

            // ── a plain row, a heading, a large figure, a profile ───────────────────────────────────────────
            group {
                size: w, h
                show: r.kind != para and r.kind != pills and r.kind != tiles and r.kind != cells and r.kind != wave
                opacity: shown
                move: (1 - shown) * if(card_dir != 0, card.w * 0.5 * card_dir, 18 * card.sx), 0

                // Of glass, a tile is a lighter pane in the card's glass: a veil of colour over it would be taken
                // for what is behind the card and come back through the glass a frame later.
                // A tile is drawn row by row: each lays its piece and, unless it is the last, reaches under the next
                // one, which covers that with its own; so the tile's corners are round only at its two ends.
                box { from: 2, if(r.tile == 1 or r.tile == 4, 1, 0); size: w - 4, h + if(r.tile == 1 or r.tile == 2, 14 - 17 * card.glass, -1 - 2 * card.glass) - if(r.tile == 1 or r.tile == 4, 1, 0); corner: 15; color: mix(paper, cream, 0.075); glass: card.glass * 100%; frost: 100%; smoke: 38% * card.glass; milk: 10% * card.glass; refraction: 40% * card.glass; show: r.tile > 0 }
                box { at: w / 2, h / 2; size: w - if(r.tile > 0, 12, 0), h - 4; corner: 12; color: if(r.danger, red, #4a372b); opacity: max(hit.hover, if(card_sel == (r.index + base) * 16, 1, 0)) * if(r.danger, 18%, 100%); show: r.kind == plain or r.kind == big }

                // room for a widget, with none in it yet: the pegboard (LATTEOS-GOO, rule 26)
                shader pegboard { at: 8, 0; size: w - 16, h; colors: cream, #000000; show: r.peg }

                // plain
                image r.icon { at: 15, if(r.tall, 13, 9); size: 26, 26; show: r.kind == plain and r.has_icon and not r.prev }
                // a preview (the clipboard's): a picture beside its name, or what a text says, three lines of it
                image r.icon { at: 12, 7; size: 100, 64; fit: cover; show: r.prev and r.has_icon }
                text r.label { at: 124, 28; anchor: left center; width: w - 150; lines: 1; size: 15; weight: 500; color: cream; show: r.prev and r.has_icon; family: "Inter" }
                text r.line2 { at: 124, 50; anchor: left center; width: w - 150; lines: 1; size: 12.5; color: dim; show: r.prev and r.has_icon; family: "Inter" }
                text r.label { at: 56, 7; width: w - 82; lines: 3; size: 13.5; line_height: 1.2; color: cream; show: r.prev and not r.has_icon; family: "Inter" }
                text r.line2 { at: 56, 66; anchor: left center; width: w - 82; lines: 1; size: 12; color: dim; show: r.prev and not r.has_icon; family: "Inter" }
                text r.glyph { at: 28, if(r.tall, 26, 22); anchor: center; size: 18; color: if(r.danger, red, cream); opacity: if(r.off, 40%, 90%); show: r.kind == plain and not r.has_icon and not r.on; family: "tabler-icons" }
                text g_check { at: 28, 22; anchor: center; size: 17; color: gold; show: r.kind == plain and r.on; family: "tabler-icons" }
                text r.label { at: 56, if(r.tall, 17, 22); anchor: left center; width: w - if(r.more, 96, 82) - if(r.copy, 34, 0); lines: 1; size: 15; weight: 500; color: if(r.danger, red, cream); opacity: if(r.off, 45%, 100%); show: r.kind == plain and not r.prev; family: "Inter" }
                text r.line2 { at: 56, 36; anchor: left center; width: w - 82; lines: 1; size: 12.5; color: dim; show: r.kind == plain and r.tall and not r.prev; family: "Inter" }
                text r.hint { at: w - if(r.copy, 52, 18), if(r.tall, 17, 22); anchor: right center; size: 13; color: dim; show: r.kind == plain and not r.more; family: "Inter" }
                text g_more { at: w - 22, h / 2; anchor: center; size: 16; color: dim; show: (r.kind == plain and r.more) or (r.kind == profile and not r.quiet); family: "tabler-icons" }

                // a heading
                text r.label { at: 22, 15; anchor: left center; width: w - 120; lines: 1; size: 11.5; weight: 700; color: dim; show: r.kind == head; family: "Inter" }
                text r.hint { at: w - 18, 15; anchor: right center; size: 13; color: dim; show: r.kind == head; family: "Inter" }

                // a large figure
                text r.label { at: 22, 28; anchor: left center; width: w - 44 - if(r.copy, 34, 0); lines: 1; size: 34; weight: 700; color: cream; show: r.kind == big; family: "Inter" }

                // a bar under a plain row or a large figure
                box { from: if(r.kind == big, 22, 56), if(r.kind == big, 54, 38); size: w - if(r.kind == big, 44, 74), 3; corner: 1.5; color: #5a463a; show: r.bar >= 0 and r.kind != slide and r.kind != gap }
                box { from: if(r.kind == big, 22, 56), if(r.kind == big, 54, 38); size: (w - if(r.kind == big, 44, 74)) * clamp(r.bar, 0, 1) * shown, 3; corner: 1.5; color: gold; show: r.bar > 0 and r.kind != slide and r.kind != gap }

                // a profile: the portrait cut round by a ring of the card's colour
                image r.icon { at: 18, 12; size: 60, 60; show: r.kind == profile and r.has_icon }
                ellipse { at: 48, 42; radius: 37; stroke: 14; color: paper; show: r.kind == profile and r.has_icon }
                ellipse { at: 48, 42; radius: 30; color: #4a372b; show: r.kind == profile and not r.has_icon }
                text r.glyph { at: 48, 42; anchor: center; size: 28; color: cream; opacity: 90%; show: r.kind == profile and not r.has_icon; family: "tabler-icons" }
                ellipse { at: 48, 42; radius: 30.5; stroke: 1.5; color: gold; opacity: 70%; show: r.kind == profile }
                text r.label { at: 94, 32; anchor: left center; width: w - 128 - if(r.on, 62, 0); lines: 1; size: 18; weight: 700; color: cream; show: r.kind == profile; family: "Inter" }
                // the badge (the role): shown when the row says `on`; its words are the row's hint
                box { at: w - 50, 32; size: 56, 22; corner: 7; color: gold; opacity: 20%; show: r.kind == profile and r.on }
                text r.hint { at: w - 50, 32; anchor: center; size: 11; weight: 700; color: gold; show: r.kind == profile; family: "Inter" }
                text r.line2 { at: 94, 55; anchor: left center; width: w - 128; lines: 1; size: 12.5; color: dim; show: r.kind == profile; family: "Inter" }

                // a slider: its icon, the track with what is filled, the knob, and the figure on the right
                text r.glyph { at: 28, 22; anchor: center; size: 18; color: cream; opacity: 60% + 40% * knob_hit.hover; show: r.kind == slide; family: "tabler-icons" }
                box { from: 56, 20.5; size: w - 130, 3; corner: 1.5; color: #5a463a; show: r.kind == slide }
                box { from: 56, 20.5; size: (w - 130) * clamp(r.bar, 0, 1), 3; corner: 1.5; color: gold; opacity: if(r.off, 40%, 100%); show: r.kind == slide }
                ellipse { at: 56 + (w - 130) * clamp(r.bar, 0, 1), 22; radius: 6 + 1.5 * hit.hover; color: if(r.off, dim, gold); show: r.kind == slide }
                text r.hint { at: w - 18, 22; anchor: right center; size: 13; color: dim; show: r.kind == slide; family: "Inter" }

                zone box hit { from: if(r.kind == slide, 46, 0), 1; size: w - if(r.kind == slide, 100, 0), h - 2; cursor: pointer; active: card_open and not r.off and not r.quiet and r.kind != head; label: "{r.label}"; selected: r.on }
                zone box knob_hit { from: 4, 1; size: 42, h - 2; cursor: pointer; active: card_open and r.kind == slide; label: "{r.label}" }
                on press knob_hit { emit card_pick((r.index + base) * 16) }
                on press hit while r.kind == slide { emit card_slide((r.index + base) * 1024 + round(clamp((local.x - 56) / (w - 130), 0, 1) * 1000)) }
                on drag hit while r.kind == slide { emit card_slide((r.index + base) * 1024 + round(clamp((local.x - 56) / (w - 130), 0, 1) * 1000)) }
                on press hit while r.kind != slide { emit card_pick((r.index + base) * 16) }
                on press right hit { tap.x = cursor.x; tap.y = cursor.y; emit card_right((r.index + base) * 16) }
                on scroll hit { emit card_wheel((r.index + base) * 2 + if(wheel > 0, 1, 0)) }

                // copy, as beside the AI's messages: quiet at the row's end, lit under the pointer, a tick once done
                text g_copy { at: w - 26, if(r.kind == big, 28, h / 2); anchor: center; size: 16; color: cream; opacity: 45% + 55% * copy_hit.hover; show: r.copy and card_copied != r.index + base; family: "tabler-icons" }
                text g_check { at: w - 26, if(r.kind == big, 28, h / 2); anchor: center; size: 16; color: gold; show: r.copy and card_copied == r.index + base; family: "tabler-icons" }
                zone box copy_hit { from: w - 44, if(r.kind == big, 10, h / 2 - 18); size: 36, 36; cursor: pointer; active: card_open and r.copy; label: "Copy"; role: button }
                on press copy_hit { emit card_copy(r.index + base) }
            }

            // ── a divider of coffee: only room here, the coffee itself is drawn across the whole card (above) ──
            group {
                size: w, 26
                show: r.kind == wave
            }

            // ── a paragraph: as tall as its text ────────────────────────────────────────────────────────────
            row {
                show: r.kind == para
                padding: 14
                opacity: shown
                column {
                    fill: #3d2c22 85%
                    corner: 14
                    padding: 12
                    text r.label { width: w - 52; lines: 14; size: 14.5; line_height: 1.4; color: cream; family: "Inter"; selectable: true; selection: #5a463a }
                }
            }

            // ── buttons side by side, or apps as tiles ──────────────────────────────────────────────────────
            row {
                show: r.kind == pills or r.kind == tiles or r.kind == cells
                opacity: shown
                wrap: 10
                for it in r.items { CardItem(r, it, base, w) }
            }
        }

        // a message: its copy button only while the pointer is over it; the right button is the row's menu, and on a
        // pegboard too. No cursor of its own here: a press on the letters still selects them.
        zone box msg_hit { from: 0, 0; size: w, parts.height; active: card_open and (r.hc or r.peg); agent: hidden }
        on press right msg_hit { tap.x = cursor.x; tap.y = cursor.y; emit card_right((r.index + base) * 16) }
        text g_copy { at: w - 30, 20; anchor: center; size: 15; color: cream; opacity: 60% + 40% * hc_hit.hover; show: r.hc and (msg_hit.hover or hc_hit.hover) and card_copied != r.index + base; family: "tabler-icons" }
        text g_check { at: w - 30, 20; anchor: center; size: 15; color: gold; show: r.hc and card_copied == r.index + base; family: "tabler-icons" }
        zone box hc_hit { from: w - 46, 4; size: 32, 32; cursor: pointer; active: card_open and r.hc and (msg_hit.hover or hc_hit.hover); label: "Copy"; role: button }
        on press hc_hit { emit card_copy(r.index + base) }
    }

    // ClockGoo's (clock.plm): the weather itself, behind a panel: the sky of the hour (by day or by night), the sun or the moon, clouds that
    // drift, rain, snow, fog, a storm's flashes; in the box at x, y of w × h, its corners round.
    component Sky(x: number, y: number, w: number, h: number) {
        size: w, h
        group {
            show: clk_weather > 0
            clip box { from: x, y; size: w, h; corner: 14 }
            body {
                gradient: x, y to x, y + h, clk.top, clk.bottom
                box { from: x, y; size: w, h }
            }
            ellipse { at: x + w * 0.66, y + 51; radius: 40 + 3 * sin(time * 40); color: #ffd27a; opacity: 22%; show: clk_night < 1 and clk_kind <= 2 }
            ellipse { at: x + w * 0.66, y + 51; radius: 16; color: #ffe2a0; opacity: 85%; show: clk_night < 1 and clk_kind <= 2 }
            ellipse { at: x + w * 0.66, y + 47; radius: 12; color: #efe9da; opacity: 90%; show: clk_night > 0 and clk_kind <= 3 }
            ellipse { at: x + w * 0.66 + 5, y + 43; radius: 10; color: clk.top; opacity: 95%; show: clk_night > 0 and clk_kind <= 3 }
            ellipse { at: x + w * 0.14, y + 25; radius: 1.2; color: #ffffff; opacity: 60% + 30% * sin(time * 90); show: clk_night > 0 and clk_kind <= 2 }
            ellipse { at: x + w * 0.36, y + 13; radius: 1; color: #ffffff; opacity: 70%; show: clk_night > 0 and clk_kind <= 2 }
            ellipse { at: x + w * 0.53, y + 47; radius: 1.3; color: #ffffff; opacity: 50% + 40% * sin(time * 70 + 40); show: clk_night > 0 and clk_kind <= 2 }
            ellipse { at: x + w * 0.85, y + 17; radius: 0.9; color: #ffffff; opacity: 70%; show: clk_night > 0 and clk_kind <= 2 }
            ellipse { at: x + w * 0.24, y + 75; radius: 1; color: #ffffff; opacity: 55%; show: clk_night > 0 and clk_kind <= 2 }
            body {
                color: rgb(pick(clk_kind - 1, 255, 242, 201, 185, 122, 215, 75) / 255, pick(clk_kind - 1, 255, 242, 204, 188, 130, 221, 81) / 255, pick(clk_kind - 1, 255, 242, 210, 192, 142, 228, 96) / 255)
                opacity: if(clk_kind >= 2, if(clk_night > 0, 28%, if(clk_kind == 2, 42%, 58%)), 0)
                // three clouds, each of four puffs melted together, drifting at their own pace
                ellipse { at: x + mod(time * 6, w + 95) - 50, y + 29; radius: 13; blend: 10 }
                ellipse { at: x + mod(time * 6, w + 95) - 36, y + 19; radius: 17; blend: 10 }
                ellipse { at: x + mod(time * 6, w + 95) - 18, y + 23; radius: 14; blend: 10 }
                ellipse { at: x + mod(time * 6, w + 95) - 34, y + 33; radius: 12; scale: 2.2, 0.8; blend: 10 }
                ellipse { at: x + mod(time * 4 + 230, w + 115) - 60, y + 67; radius: 15; blend: 12 }
                ellipse { at: x + mod(time * 4 + 230, w + 115) - 40, y + 55; radius: 21; blend: 12 }
                ellipse { at: x + mod(time * 4 + 230, w + 115) - 16, y + 61; radius: 16; blend: 12 }
                ellipse { at: x + mod(time * 4 + 230, w + 115) - 38, y + 73; radius: 13; scale: 2.6, 0.8; blend: 12 }
                ellipse { at: x + mod(time * 5 + 120, w + 105) - 40, y + 105; radius: 18; blend: 12; show: clk_kind >= 3 }
                ellipse { at: x + mod(time * 5 + 120, w + 105) - 14, y + 97; radius: 23; blend: 12; show: clk_kind >= 3 }
                ellipse { at: x + mod(time * 5 + 120, w + 105) - 26, y + 113; radius: 14; scale: 3, 0.8; blend: 12; show: clk_kind >= 3 }
            }
            ellipse { at: x + mod(time * 8, w + 125) - 60, y + 105; radius: 60; scale: 3, 0.25; color: #e8e8e8; opacity: 22%; show: clk_kind == 4 }
            ellipse { at: x + mod(time * 5 + 200, w + 125) - 60, y + 140; radius: 60; scale: 3.4, 0.22; color: #e8e8e8; opacity: 20%; show: clk_kind == 4 }
            particles { at: x + w / 2, y - 5; area: w + 15, 4; count: 160; life: 0.5s .. 0.8s; speed: 360 .. 460; direction: 100deg; spread: 3deg; size: 1, 1
                        colors: #a9c8f5, #a9c8f5; opacity: 70%, 20%; shape: spark; emit: card_open and card_custom == 1 and (clk_kind == 5 or clk_kind == 7) }
            particles { at: x + w / 2, y - 5; area: w + 15, 4; count: 120; life: 4s .. 6s; speed: 25 .. 45; direction: 95deg; spread: 30deg; size: 3, 2.2
                        colors: #ffffff, #ffffff; opacity: 90%, 30%; shape: dot; emit: card_open and card_custom == 1 and clk_kind == 6 }
            box { from: x, y; size: w, h; color: #e8ecff; opacity: 60% * pow(max(0, sin(time * 37)), 40); show: clk_kind == 7 }
        }
    }

    component CardItem(r: record, it: record, base: number, cw: number) {
        size: cw / if(r.kind == tiles or r.kind == cells, r.per, max(r.items.count, 1)), if(r.kind == cells, if(r.tall, 120, 50), if(r.kind == tiles, if(r.per <= 2, 66, 88), if(r.per <= 2, 60, 46)))
        let wide = r.per <= 2 and r.kind != cells
        let w = cw / if(r.kind == tiles or r.kind == cells, r.per, max(r.items.count, 1))
        let lit = max(hit.hover, if(card_sel == (r.index + base) * 16 + it.index + 1, 1, 0))

        // a button: the chosen one gold, one that does not undo red
        box { at: w / 2, 23; size: w - 10, 40; corner: 20; color: if(it.on, gold, if(it.danger, red, #4a372b)); opacity: if(it.on, 26%, if(it.danger, 16% + 12% * lit, 62% + 38% * lit)) * if(it.off, 0.5, 1); show: r.kind == pills and not wide }
        row {
            at: w / 2, 23
            anchor: center middle
            gap: 7
            align: center
            show: r.kind == pills and not wide
            opacity: if(it.off, 45%, 100%)
            text it.glyph { size: 17; color: if(it.on, gold, if(it.danger, red, cream)); family: "tabler-icons" }
            text it.label { size: 14; weight: 600; lines: 1; color: if(it.on, gold, if(it.danger, red, cream)); family: "Inter" }
        }
        // a cell: a picture alone (an emoji), lit under the pointer or when chosen; one that is pinned has a gold dot
        box { at: w / 2, if(r.tall, 60, 25); size: w - 4, if(r.tall, 116, 46); corner: 12; color: #4a372b; opacity: if(r.tall, max(lit, 0.35), lit); show: r.kind == cells }
        image it.icon { at: w / 2 - 17, 8; size: 34, 34; show: r.kind == cells and it.has_icon and not r.tall }
        image it.icon { at: 6, 6; size: w - 12, 108; fit: cover; show: r.kind == cells and it.has_icon and r.tall and r.per > 1 }
        // one picture across the card has more to show than a cell's 96 px
        for c in card_wide { image c.pic { at: 6, 6; size: w - 12, 108; fit: cover; show: r.kind == cells and r.tall and r.per == 1 } }
        text it.label { at: w / 2, 25; anchor: center; width: w - 6; lines: 1; size: 18; color: cream; align: center; show: r.kind == cells and not it.has_icon; family: "Inter" }
        ellipse { at: w - 8, 7; radius: 2.5; color: gold; show: r.kind == cells and it.on }
        // a tile: the app's icon over its name
        box { at: w / 2, 44; size: w - 6, 84; corner: 16; color: #4a372b; opacity: lit; show: r.kind == tiles and not wide }
        image it.icon { at: w / 2 - 20, 12; size: 40, 40; show: r.kind == tiles and it.has_icon and not wide }
        text it.glyph { at: w / 2, 32; anchor: center; size: 28; color: cream; opacity: 90%; show: r.kind == tiles and not it.has_icon and not wide; family: "tabler-icons" }
        text it.label { at: w / 2, 68; anchor: center; width: w - 14; lines: 1; size: 12.5; weight: 500; color: cream; align: center; show: r.kind == tiles and not wide; family: "Inter" }

        // wide, two to a line: a rounded square with the icon, and the name beside it; the one that does not undo in red
        box { at: w / 2, 31; size: w - 10, 54; corner: 17; color: if(it.danger, red, #4a372b); opacity: if(it.on, 100%, if(it.danger, 14% + 12% * lit, 62% + 38% * lit)) * if(it.off, 0.5, 1); show: wide }
        box { at: w / 2, 31; size: w - 10, 54; corner: 17; stroke: 1; color: cream; opacity: if(it.danger, 0%, 13% + 14% * lit); show: wide }
        box { at: 33, 31; size: 36, 36; corner: 11; color: if(it.danger, red, if(it.on, gold, paper)); opacity: if(it.danger, 22%, if(it.on, 30%, 70%)); show: wide }
        text it.glyph { at: 33, 31; anchor: center; size: 19; color: if(it.danger, red, if(it.on, gold, cream)); opacity: if(it.off, 45%, 100%); show: wide and not it.has_icon; family: "tabler-icons" }
        image it.icon { at: 33, 31; size: 26, 26; show: wide and it.has_icon }
        text it.label { at: 60, 31; anchor: left center; width: w - 72; lines: 1; size: 14.5; weight: 600; color: if(it.danger, red, if(it.on, gold, cream)); opacity: if(it.off, 45%, 100%); show: wide; family: "Inter" }

        zone box hit { from: if(r.kind == cells, 2, 3), 2; size: w - if(r.kind == cells, 4, 6), if(r.kind == cells, if(r.tall, 116, 46), if(wide, if(r.kind == tiles, 60, 54), if(r.kind == tiles, 84, 42))); cursor: pointer; active: card_open and not it.off; label: "{it.label}"; selected: it.on }
        on press hit { tap.x = cursor.x; tap.y = cursor.y; emit card_pick((r.index + base) * 16 + it.index + 1) }      // a button may open a menu: it opens there
        on press right hit { tap.x = cursor.x; tap.y = cursor.y; emit card_right((r.index + base) * 16 + it.index + 1) }
        on scroll hit { emit card_wheel((r.index + base) * 2 + if(wheel > 0, 1, 0)) }
    }

    // ── the tooltip: a drop's name and what it does. What the drop shows does not change under the pointer.
    text tip = ""
    fact tip_k = -1
    fact tip.x = 0
    fact tip.y = 0
    prop tip.p = 0 ~grow
    measure tip_size
    let tip.h = max(tip_size.height, 16) + 14
    // Chosen from the keyboard, a drop's tooltip stays beside it wherever it moves.
    let kb.nx = if(kb.edge == 1, 1, if(kb.edge == 3, -1, 0))
    let kb.ny = if(kb.edge == 0, -1, if(kb.edge == 2, 1, 0))
    let tip.cx = if(kb, kb.x + kb.nx * (kb.r + 130), tip.x)
    let tip.cy = if(kb, kb.y + kb.ny * (kb.r + 14) + if(kb.ny > 0, 30, 0), tip.y)
    let tip.a = max(tip.p, kb.p) * if(card_open, 0, 1)
    box { from: tip.cx - tip_size.width / 2 - 14, tip.cy + 15 - tip.h; size: tip_size.width + 28, tip.h; corner: min(15, tip.h / 2); color: coffee; opacity: tip.a * 0.94 }
    text tip { at: tip.cx, tip.cy + 15 - tip.h / 2; anchor: center; measure: tip_size; size: 12; color: ink; opacity: tip.a; width: 210; align: center; family: "Inter" }

    // ── a new notification, said once: a note in the corner where Windows puts its own, above the shore. It
    // takes no keyboard and no press but its own; it waits in ClockGoo after it has gone (drops/clockgoo.luau).
    text toast_title = ""
    text toast_body = ""
    fact toast_n = 0                           // the logic counts up for each one to be said
    event toast_press ->
    prop toast.p = 0 ~grow
    on change toast_n { toast.p: 1; toast.p: 0 ~500ms after 6500ms }
    let toast.w = 360
    let toast.x = W - toast.w - 14
    let toast.y = H - 46 - 104 + 26 * (1 - toast.p)
    box { from: toast.x, toast.y; size: toast.w, 86; corner: 18; color: coffee; opacity: toast.p * 0.96 }
    text toast_title { at: toast.x + 18, toast.y + 26; anchor: left center; width: toast.w - 36; lines: 1; size: 14; weight: 700; color: ink; opacity: toast.p; family: "Inter" }
    text toast_body { at: toast.x + 18, toast.y + 54; anchor: left center; width: toast.w - 36; lines: 2; size: 12.5; color: ink; opacity: toast.p * 0.8; family: "Inter" }
    zone box toast_hit { from: toast.x, toast.y; size: toast.w, 86; cursor: pointer; active: toast.p > 0.6 and not card_open; label: "{toast_title}" }
    on press toast_hit { toast.p: 0 ~200ms; emit toast_press }
    on press right toast_hit { toast.p: 0 ~200ms }
}
