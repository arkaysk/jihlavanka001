// LensShore's plate and line (goo/lib/lens.luau): a plate of the cards' own glass at the top or the bottom edge, with the
// conversations on the left, the line to type into, and on the right who answers (this computer or a service), the
// microphone and send. Its panel slides out of the plate (parts/card.plm, `card_lens`) and, while it is out, the plate
// is part of the panel's body: one shape. Not a drop: the drops keep off its stretch of the edge (lib/engine.luau).
part LensLine {
    fact lens_typed = false
    fact lens_busy = false                     // the AI is still answering: the conversations pulse
    fact lens_fresh = false                    // an answer came while the card was shut: a dot
    fact lens_listening = false                // the microphone is on
    text lens_q = ""
    text lens_hint = ""
    text g_ln_talk = ""                        // glyphs, from the logic
    text g_ln_who = ""
    text g_ln_mic = ""
    text g_send = ""
    event lens_press ->                        // the line was pressed: the card grows
    event lens_enter ->                        // Enter in the line: what is chosen in the card (at first: ask the AI)
    event lens_send ->                         // the send button: to the AI
    event lens_right ->                        // the right button on the line
    event lens_talk ->                         // the conversations
    event lens_who ->                          // who answers
    event lens_mic ->                          // the microphone, on or off
    // the plate: lens_a…lens_b along the top (lens_edge 2) or the bottom edge (0), 46 px deep, as TrayShore's
    let ln.left = lens_a
    let ln.right = lens_b
    let ln.cy = if(lens_edge == 2, 23, H - 23)
    let ln.fx = ln.left + 46                   // the field, between the conversations and the three on the right
    let ln.fw = ln.right - ln.left - 46 - 118

    // at rest the plate is a body of its own, of the panel's glass; with the panel out the panel's body holds it
    body {
        gradient: ln.left, if(lens_edge == 2, 0, H) to ln.left, if(lens_edge == 2, 46, H - 46), coffee, mix(paper, coffee, 0.55)
        rim: 16%
        shadow: 0, 6, 18, 30%
        opacity: if(lens_shore and lens_b > lens_a and not (card_lens and card.p > 0.02), 1, 0)
        glass: if(true_glass, 1, panes) * 100%
        lens: material > 0.02
        frost: if(true_glass, 45%, 100%)
        smoke: 62% * if(true_glass, 1, panes)
        refraction: if(true_glass, 200%, 120%) * if(true_glass, 1, panes)
        box { from: ln.left, if(lens_edge == 2, -40, H - 46); size: ln.right - ln.left, 86; corner: 18 }
    }
    group {
        show: lens_shore and lens_b > lens_a
        // the conversations: a pulse while the AI answers, a dot when an answer came meanwhile
        ellipse { at: ln.left + 24, ln.cy; radius: 16; color: ink; opacity: 10% * ln_talk.hover }
        text g_ln_talk { at: ln.left + 24, ln.cy; anchor: center; size: 18; color: ink; opacity: if(lens_busy, 55% + 40% * sin(time * 300), 85%); family: "tabler-icons" }
        ellipse { at: ln.left + 33, ln.cy - 9; radius: 4; color: gold; show: lens_fresh }
        zone box ln_talk { at: ln.left + 24, ln.cy; size: 36, 46; cursor: pointer; label: "Conversations"; role: button }
        on press ln_talk { emit lens_talk }

        // the field
        box { from: ln.fx, ln.cy - 16; size: ln.fw, 32; corner: 16; color: ink; opacity: 7% + 5% * lens_field.hover }
        text g_search { at: ln.fx + 16, ln.cy; anchor: center; size: 15; color: ink; opacity: 60%; family: "tabler-icons" }
        text lens_hint { at: ln.fx + 32, ln.cy; anchor: left center; width: ln.fw - 44; lines: 1; size: 15; color: ink; opacity: 55%; show: not lens_typed; family: "Inter" }
        input lens_q { at: ln.fx + 32, ln.cy - 10; width: ln.fw - 44; size: 15; color: ink; selection: #5a463a; family: "Inter"; label: "{lens_hint}" }
        zone box lens_field { from: ln.fx, ln.cy - 16; size: ln.fw, 32; cursor: text; label: "LensShore" }
        on press lens_field { focus lens_q; emit lens_press }
        on press right lens_field { tap.x = cursor.x; tap.y = cursor.y; emit lens_right }
        on submit lens_q { emit lens_enter }

        // who answers: a house for this computer, a cloud for a service
        ellipse { at: ln.right - 96, ln.cy; radius: 15; color: ink; opacity: 10% * ln_who.hover }
        text g_ln_who { at: ln.right - 96, ln.cy; anchor: center; size: 16; color: ink; opacity: 60%; family: "tabler-icons" }
        zone box ln_who { at: ln.right - 96, ln.cy; size: 32, 46; cursor: pointer; label: "Who answers"; role: button }
        on press ln_who { tap.x = cursor.x; tap.y = cursor.y; emit lens_who }
        // the microphone: red while it listens
        ellipse { at: ln.right - 60, ln.cy; radius: 15; color: if(lens_listening, #e5484d, ink); opacity: if(lens_listening, 100%, 10% * ln_mic.hover) }
        text g_ln_mic { at: ln.right - 60, ln.cy; anchor: center; size: 16; color: if(lens_listening, #ffffff, ink); opacity: if(lens_listening, 100%, 60%); family: "tabler-icons" }
        zone box ln_mic { at: ln.right - 60, ln.cy; size: 32, 46; cursor: pointer; label: "Microphone"; role: button }
        on press ln_mic { emit lens_mic }
        // send: lit when there is something to send
        ellipse { at: ln.right - 24, ln.cy; radius: 15; color: if(lens_typed, gold, ink); opacity: if(lens_typed, 100%, 10% * ln_go.hover) }
        text g_send { at: ln.right - 24, ln.cy; anchor: center; size: 16; color: if(lens_typed, #2a170c, ink); opacity: if(lens_typed, 100%, 60%); family: "tabler-icons" }
        zone box ln_go { at: ln.right - 24, ln.cy; size: 32, 46; cursor: pointer; label: "Send"; role: button }
        on press ln_go { emit lens_send }
    }
}
