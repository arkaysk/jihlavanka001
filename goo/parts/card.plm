// The card: the one window of the shell. A menu, a launcher, a panel: whatever a drop opens grows out of it.
//
// The drop it belongs to steps away from the edge and sits in the card's corner as its ear, so one can tell
// whose it is; a card without an owner grows from where the pointer pressed. The logic says what is in it
// (lib/card.luau): tabs, a field to type into, and rows of a few kinds. How big it comes out is the layout's
// business (parts/rows.plm), not the logic's.
//
// This part is the card's state and its frame, which lies under the drops' faces: the ear is a drop.
part Card {
    //   kind     plain: an icon, a label, and on the right a hint or the arrow of a submenu
    //            head: the heading of a section · big: a large figure · para: a paragraph in a bubble
    //            pills: its `items` as buttons side by side · tiles: its `items` as apps, an icon over a name
    //            profile: a portrait, a name and a line under it
    //            slide: a slider, set by pressing or dragging along it; its icon is pressed on its own
    //   tall     a plain row with a second line under its label (`line2`)
    //   on       ticked, or the chosen one · off: not available · quiet: to be read, not pressed
    //   danger   it does not undo: red · more: opens a submenu · line: a rule above it
    //   bar      a bar filled this far (0…1), none below 0 · per: how many tiles or buttons make a line; two or fewer
    //            are laid wide, the icon beside the name · wave: two layers of coffee as a divider
    model card max 24 {
        kind: plain | head | big | para | pills | tiles | profile | slide | wave = plain
        label: text; hint: text; line2: text; glyph: text; icon: image 64, 64; has_icon: bool; tall: bool
        on: bool; off: bool; quiet: bool; danger: bool; more: bool; line: bool; bar: number = -1; per: number = 4
        tile: number = 0                       // part of a tile, a card within the card: 1 its first row, 2 inside, 3 its last, 4 alone
        list items max 6 { label: text; glyph: text; icon: image 44, 44; has_icon: bool; on: bool; off: bool; danger: bool }
    }
    // the rows of a second column, beside the first: a card with two things to show at once
    model card2 max 12 {
        kind: plain | head | big | para | pills | tiles | profile | slide | wave = plain
        label: text; hint: text; line2: text; glyph: text; icon: image 64, 64; has_icon: bool; tall: bool
        on: bool; off: bool; quiet: bool; danger: bool; more: bool; line: bool; bar: number = -1; per: number = 4
        tile: number = 0                       // part of a tile, a card within the card: 1 its first row, 2 inside, 3 its last, 4 alone
        list items max 6 { label: text; glyph: text; icon: image 44, 44; has_icon: bool; on: bool; off: bool; danger: bool }
    }
    model tab max 6 { label: text; glyph: text; on: bool }
    // a month at the top of the second column: six weeks from Monday. `dim`: a day of another month,
    // `chosen`: the day whose events are shown, `dot`: something is written down for it
    model day max 42 { n: text; dim: bool; today: bool; chosen: bool; dot: bool }
    model weekday max 7 { name: text }
    fact cal_on = false
    text cal_title = ""
    event cal_pick ->                          // a day was pressed, by its place among the 42
    event cal_step ->                          // the arrows and the wheel: 1 the next month, 0 the one before
    fact card_open = false
    fact card_owner = -1                       // the place of the drop it grows from; −1: from the last press
    fact card_dock_w = 0                       // …and how long that plate is, to join the two without a seam
    fact card_dock = false                     // it is the shore's panel: no goo, a plate that stands on the shore's own, one piece with it
    fact card_strip = false                    // that drop is stretched into a strip: grow out of the whole capsule
    fact card_w = 300
    fact card_w2 = 0                           // how wide the second column is; 0: there is none
    fact card_pane = 0                         // 0…1: this card is glass above its wave divider, whatever the goo's material (a drop asks for it)
    fact card_split = 0                        // where a `wave` row's coffee begins, from the card's top: below it the card is solid, 0 for none
    fact card_min = 0                          // a card with tabs is at least this tall: its top edge stays put
    fact card_peak = 0                         // …and any card only grows while it is open
    fact card_field = false                    // it has a field to type into, under the tabs
    fact card_typed = false                    // …and something is typed in it
    fact card_secret = false                   // …that must not be read over the shoulder: a password
    fact card_sel = -1                         // the row chosen with the arrow keys: row × 8, + 1 + item
    fact card_gen = 0                          // the logic counts up for new content: the rows come in again
    text card_q = ""
    text card_pw = ""
    text card_hint = ""
    text g_check = ""                          // glyphs of the icon font the card draws itself; the logic fills them
    text g_more = ""
    text g_search = ""
    text g_key = ""
    text g_back = ""
    event card_pick ->                         // a row was pressed: row × 8, + 1 + item for a pill or a tile;
                                               // the rows of the second column count on from 24
    event card_right ->
    event card_slide ->                        // a slider was moved: row × 1024 + where to, in thousandths
    event card_wheel ->                        // the wheel over a row: row × 2, + 1 upwards
    event card_spin ->                         // the wheel over the card, where no list scrolls: 0 up, 1 down
    event card_tab ->                          // a tab was pressed
    event card_next ->                         // Tab and Shift+Tab: 1 the next tab, 0 the one before
    event card_key ->                          // the arrow keys: 1 down, 0 up
    event card_enter ->                        // Enter: the chosen row, or what is typed
    event card_closed ->

    let paper = #2c2019
    let dim = #b8a491
    let red = #e5484d
    spring nimble = 520, 34
    spring land = 630, 14                      // a quarter of a second to the target, two bounces that can be seen

    prop card.p = 0 ~land
    follow card.p = if(card_open, 1, 0)
    // The rows come in one after another when the content is new.
    prop reveal = 1 ~0ms
    on change card_gen { reveal: 0 ~0ms; reveal: 1 ~460ms after 16ms }

    // Where it stands: its corner at the ear, opening towards the middle of the screen and kept inside it.
    let card.w = min(card_w + card_w2, W - 24)
    let card.h = min(max(card_col.height, max(card_min, card_peak)), H - 24)
    on change card_col.height { card_peak = max(card_peak, card_col.height) }
    let from_strip = if(card_strip and strip_on and card_owner < 0, 1, 0)
    let ear = if(card_owner >= 0, own.r, if(from_strip > 0, strip.r, 10))
    // A drop stretched into a strip is one thing with it: the card grows out of the whole capsule, along the
    // way the capsule lies, not out of the drop at its end.
    let cap.len = from_strip * strip.cap * 2
    let cap.tx = if(strip.edge == 1 or strip.edge == 3, 0, 1)    // along the edge the strip is on
    let cap.h = if(cap.len > 0, cap.tx, 0)                       // the capsule lies along x
    let cap.v = if(cap.len > 0, 1 - cap.tx, 0)                   // or along y
    let card.bx = if(card_owner >= 0, own.x, if(from_strip > 0, strip.x, tap.x))
    let card.by = if(card_owner >= 0, own.y, if(from_strip > 0, strip.y, tap.y))
    let card.sx = if(cap.h > 0, if(strip.dir > 0, if(card.bx + card.w + 12 <= W, 1, -1), if(card.bx - card.w - 12 >= 0, -1, 1)), if(card.bx + card.w + 12 <= W, 1, -1))
    let card.sy = if(cap.v > 0, if(strip.dir > 0, if(card.by + card.h + 12 <= H, 1, -1), if(card.by - card.h - 12 >= 0, -1, 1)), if(card.by > H / 2, if(card.by - card.h - 12 >= 0, -1, 1), if(card.by + card.h + 12 <= H, 1, -1)))
    let card.x = card.bx - cap.h * card.sx * ear                 // from the drop's far side, so the card holds all of it
    let card.y = card.by - cap.v * card.sy * ear
    // docked, it stands on the shore's plate (46 px high, parts/shore.plm), flush with the screen's right edge
    let card.x0 = if(card_dock, W - card.w, clamp(if(card.sx > 0, card.x, card.x - card.w), 12, W - 12 - card.w))
    let card.y0 = if(card_dock, H - 46 - card.h, clamp(if(card.sy > 0, card.y, card.y - card.h), 12, H - 12 - card.h))
    let card.ax = if(card.sx > 0, card.x0, card.x0 + card.w)
    let card.ay = if(card.sy > 0, card.y0, card.y0 + card.h)
    let card.glass = if(card_dock, 0, max(material, card_pane * panes))                  // the shore is hard: its panel is never glass
    let card.q = clamp(card.p, 0, 1.08)
    prop card.ws = 290 ~grow
    prop card.hs = 60 ~grow
    follow card.ws = card.w
    follow card.hs = card.h

    // The frame: coffee at the ear, turning into the colour of windows further away.
    // It grows out of the ear as a drop does that is let go of: first round and narrower than the drop was,
    // then it straightens into the card; the neck that ties it to the ear is a bell, thickest halfway
    // (4·t·(1−t)). On the overshoot of the spring it swells wider too, not only taller.
    let card.t = clamp(card.p, 0, 1)
    let card.over = max(0, card.p - 1)
    let card.cw = if(card_dock, card.ws, 0) + if(card_dock, 0, 1) * max((ear * 1.8 + cap.h * cap.len) * (1 - card.t) + card.ws * (card.t * card.t * card.t + card.over * 0.6), 14)
    let card.ch = max(cap.v * (cap.len + ear * 2) * (1 - card.t) + card.hs * card.q, 14)
    let card.round = 18 + 40 * (1 - card.t) * (1 - card.t)
    body {
        gradient: card.ax, card.ay to card.ax + card.sx * card.w, card.ay + card.sy * card.h, coffee, mix(paper, coffee, 0.4), paper, paper
        rim: 16%
        shadow: 0, 8, 22, 36% * clamp(card.p, 0, 1)
        opacity: if(card.p > 0.02 and not card_dock, 1, 0)
        // With the goo of glass the card is frosted glass too: what is behind shows through it, blurred and
        // smoked so that the light writing on it reads over anything.
        glass: card.glass * 100%
        lens: material > 0.02
        shine: pointer
        frost: 100%
        smoke: 62% * card.glass
        refraction: 120% * card.glass
        box { at: card.ax + card.sx * card.cw / 2, card.ay + card.sy * card.ch / 2; size: card.cw * if(card.p > 0.02, 1, 0), card.ch; corner: min(if(ear > 14, 26, 18) + (card.round - 18), min(card.cw, card.ch) / 2) }
        ellipse { at: card.ax, card.ay; radius: (ear * clamp(card.p * 3, 0, 1) + 1) * if(card.p > 0.02, 1, 0); blend: 4 + 30 * 4 * card.t * (1 - card.t) }
        line { from: card.bx, card.by; to: card.bx + cap.tx * cap.len * strip.dir, card.by + (1 - cap.tx) * cap.len * strip.dir; width: ear * 2 * clamp(card.p * 3, 0, 1) * if(cap.len > 0 and card.p > 0.02, 1, 0); blend: 4 + 30 * 4 * card.t * (1 - card.t) }
    }
    // Below a `wave` row (card_split) the card is solid coffee to its edge: a second body under the rows, inset a hair
    // so the first one's rim stays the card's outline. Its top corners are square, its bottom ones the card's.
    let dk.ct = if(card.sy > 0, card.ay, card.ay - card.ch)
    let dk.top = max(dk.ct, card.y0 + card_split)
    let dk.bot = dk.ct + card.ch - 1.5
    let dk.h = max(dk.bot - dk.top, 0)
    let dk.cx = card.ax + card.sx * card.cw / 2
    let dk.on = card.p > 0.02 and not card_dock and card_split > 0
    // the ear sits in a bottom corner: the coffee keeps clear of it, and the glass wraps round it
    let dk.e = if(card.sy < 0 and card_owner >= 0, ear * 1.15, 0)
    let dk.lip = max(40, dk.e * 1.5)
    body {
        color: paper
        opacity: if(dk.on, 1, 0)
        box { at: dk.cx, dk.top + max(dk.h - dk.lip, 0) / 2; size: max(card.cw - 3, 0), max(dk.h - dk.lip, 0); corner: 3 }
        box { at: dk.cx + card.sx * dk.e / 2, dk.bot - min(dk.h, dk.lip + 30) / 2; size: max(card.cw - 3 - dk.e, 0), min(dk.h, dk.lip + 30); corner: min(if(ear > 14, 26, 18) + (card.round - 18), min(card.cw, card.ch) / 2) - 1.5 }
    }
    // The shore's panel: a plate like the shore's, rising out of it and reaching past the screen's edge, so
    // the two are one piece.
    group {
        show: card_dock and card.p > 0.02
        box { from: card.x0 - 1, card.ay - card.ch - 1; size: card.w + 41, card.ch + 2; corner: 19; color: #6b5444 }
        box { from: card.x0, card.ay - card.ch; size: card.w + 40, card.ch; corner: 18; color: #261d17 }
        // over the shore the panel's foot is square and covers the plate's upper rim: no line between the two
        box { from: W - card_dock_w + 17, card.ay - min(20, card.ch); size: card_dock_w + 23, min(20, card.ch) + 2; color: #261d17 }
        box { from: card.x0 + 16, card.ay - card.ch + 1; size: card.w, 1; color: cream; opacity: 7% }
    }
}
