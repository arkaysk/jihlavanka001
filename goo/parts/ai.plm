// LensGoo's AI: a conversation in the card, under the tabs of LensGoo. On the glass the messages, which scroll
// and stay until a new session; under them the field to write in, in the look of the service that answers
// (Claude, Gemini, Grok, ChatGPT; LatteOS's own for a server of one's own or a model on this computer), with the
// model chosen in it: a press opens the models to choose from. On the coffee the ways on — LensAI,
// the Settings, a new session — and on the right what the conversation has used. The logic (lib/lens.luau) tells
// the texts and the numbers; latte-ai keeps the conversations.
part Ai {
    model aimsg max 40 { who: text; body: text; mine: bool; failed: bool; w: number = 300 }     // w: how wide its bubble is (the logic guesses it from the text)
    model aiagent max 4 { name: text; glyph: text }       // the micro-agents, offered while the conversation is empty
    // the menu that is out (the services, the service's + or its chip) and the one beside it, rows as the logic says:
    // desc under the name, hint after it, key at the right; web: it opens the service's page (one colour for all);
    // more: it opens beside; off: dim, not pressed; note: a small text; h: how tall, with the line before it (sep)
    model aipop max 14 { name: text; desc: text; hint: text; key: text; glyph: text; g: bool; d: bool; on: bool; sep: bool; web: bool; more: bool; off: bool; note: bool; h: number = 32 }
    model aisub max 8 { name: text; desc: text; hint: text; key: text; glyph: text; g: bool; d: bool; on: bool; sep: bool; web: bool; more: bool; off: bool; note: bool; h: number = 32 }
    text ai_q = ""
    text ai_hint = ""                          // what the empty field says, in the service's words
    text ai_who = ""                           // who answers, at the foot of the field
    text ai_model = ""                         // who answers and with which model, on the switch at the foot
    text ai_effort_word = ""                   // how hard it may think, on the field's own chip ("" where it cannot be said)
    text ai_empty = ""                         // what an empty conversation says
    text ai_greet = ""                         // …in the service's own words, over its field, as on its own page
    image logo_claude = file "../ai/claude.svg", 96, 96
    image logo_gemini = file "../ai/gemini.svg", 96, 96
    image logo_openai = file "../ai/openai.svg", 96, 96
    image logo_grok = file "../ai/grok.svg", 96, 96
    image logo_mistral = file "../ai/mistral.svg", 96, 96
    image logo_copilot = file "../ai/githubcopilot.svg", 96, 96
    image logo_deepseek = file "../ai/deepseek.svg", 96, 96
    text ai_empty2 = ""
    text ai_lim1 = ""                          // what is used, two lines: a name and a share each
    text ai_lim1p = ""
    text ai_lim2 = ""
    text ai_lim2p = ""
    text ai_btn_center = ""
    text ai_btn_settings = ""
    text ai_btn_new = ""
    text ai_btn_do = ""
    text ic_ai_do = ""
    text ic_ai_center = ""
    text ic_ai_settings = ""
    text ic_ai_new = ""
    text ic_ai_send = ""
    text ic_ai_chev = ""
    text ic_ai_spark = ""
    text ic_ai_check = ""
    text ic_ai_plus = ""
    text ic_ai_wave = ""
    text ic_ai_plane = ""
    text ic_ai_stop = ""
    text ic_ai_chipicon = ""                   // the icon before the service's chip (ChatGPT's bulb, Mistral's cube…)
    text ic_ai_clip = ""
    text ic_ai_shot = ""
    text ic_ai_x = ""
    text ai_files = ""                         // what is attached to the next question, by name
    text ai_add_file = ""
    text ai_send_word = ""
    text ic_ai_mic = ""
    text ai_mic_word = ""                      // what the microphone does now: listen, or stop and write it down
    fact ai_listening = 0                      // 0 quiet · 1 listening · 2 writing down what was said                     // what the button that sends says: send, or stop while an answer comes
    text ai_add_shot = ""
    fact ai_nfiles = 0
    fact ai_style: claude | gemini | grok | chatgpt | own | copilot | mistral | deepseek = own
    fact ai_l1 = -1                            // 0…1, how full each line's bar is; below 0 it has none
    fact ai_l2 = -1
    fact ai_wait = false                       // an answer is on its way
    fact ai_typed = false
    fact ai_menu = false                       // a menu is out
    fact ai_sub = false                        // …and one beside it, from its row with more
    fact ai_pop_w = 300
    fact ai_pop_h = 0
    fact ai_pop_hx = 0                         // where the rows' hints start (ChatGPT's +), 0: none
    fact ai_sub_w = 220
    fact ai_sub_h = 0
    fact ai_sub_y = 0                          // where its row stands in the menu
    fact ai_think = false                      // DeepSeek's deep thinking is on
    fact ai_glass = 1                          // how much of the page is glass, as much as LatteOS is (lib/engine.luau): 0 white … 3
    text ai_search_word = ""
    text ic_ai_world = ""
    text ic_ai_more = ""
    text ic_ai_web = ""
    fact ai_gen = 0                            // the logic counts up when the messages change: the list goes to the end
    event ai_send ->
    event ai_stop ->
    event ai_pop ->                            // a row of the menu pressed: its place in aipop
    event ai_subpick ->                        // …of the one beside it
    event ai_open ->                           // a menu asked for: 0 the services (the switch), 1 the chip, 2 the +, 3 a chip of the service's page
    fact ai_menu_at = 0                        // where the menu stands: 0 over the switch, 1 over the chip, 2 over the +
    event ai_center ->
    event ai_settings ->
    event ai_new ->
    event ai_do ->                             // "Do it for me": the field's words to an agent in a terminal (none: LensAI's agents)
    event ai_mic ->                            // the microphone: start listening, or stop and write it into the field
    event ai_agent ->                          // a micro-agent was chosen: its place in aiagent
    event ai_attach ->                         // 0 a file, 1 a picture of the screen
    event ai_unattach ->

    // the services' own colours are chosen where each is used: a colour if() is not a `let`
    let ai.k = pick(ai_style, 0, 1, 2, 3, 4, 5, 6, 7)       // the style as a number: a name after it would be read as one of its values
    let ai.on = card_open and card_custom == 3
    let ai.w = card.w - 32                     // what the conversation and the field have
    let ai.fy = 398                            // where the field stands, from the card's top
    let ai.fh = 98
    // the field as each service draws its own: ground, rim, ink, how round, and the button that sends
    let f.round = pick(ai_style, 18, 32, 24, 30, 14, 12, 14, 24)
    // Gemini and ChatGPT write in one line, a pill with everything in it; the others in a box
    // of two rows, the words above and what goes with them under (as each of them looks: the user's pictures, 21. 10.)
    let ai.row = pick(ai_style, 0, 1, 0, 1, 0, 0, 0, 0)
    let f.top = ai.fy + ai.row * 34
    let f.h = ai.fh - ai.row * 34
    let f.cy = if(ai.row > 0, ai.fy + 34 + 32, ai.fy + ai.fh - 22)
    // the menu: LatteOS's own over the switch, the service's own over its field
    let pm.k = if(ai_menu_at == 0, 4, ai.k)
    let pm.rh = pick(pm.k, 32, 36, 32, 30, 32, 32, 36, 32)
    let pm.cl = if(ai.k == 1 and ai_menu_at == 1, 1, 0)        // Gemini ticks at the left
    let pm.radio = if(ai.k == 6 and ai_menu_at == 1, 1, 0)     // Mistral's models are radio buttons
    let m.w = ai_pop_w
    let m.h = ai_pop_h + 12

    group {
        show: card_custom == 3
        move: card.x0, card.y0

        // ── the service's own page under the conversation and the field: one knows at a glance whose it is ────
        box { from: 8, 56; size: card.w - 16, ai.fy + ai.fh + 8 - 56; corner: 16; color: if(ai.k == 0, #faf9f5, if(ai.k == 1, #f8fafd, if(ai.k == 2, #fafaf9, if(ai.k == 3, #ffffff, if(ai.k == 5, #ffffff, if(ai.k == 6, #fafaf7, if(ai.k == 7, #ffffff, #000000))))))); opacity: if(ai.k == 4, 0, 100%); glass: if(ai_glass == 0, 0, 100%); frost: 100%; milk: pick(ai_glass, 0%, 95%, 85%, 72%) }
        // ── the conversation: on the glass, it scrolls; the newest at the bottom ─────────────────────────────
        column talk {
            at: 16, 58
            view: ai.w, ai.fy - 70
            step: 60
            gap: 12
            // as in a messenger: what the user asked on the right, in gold; what the AI said on the left, in coffee, under its name
            for m in aimsg {
                row {
                    group { size: if(m.mine, ai.w - min(m.w, ai.w * 0.8), 0), 1 }
                    column {
                        gap: 5
                        text m.who { size: 11.5; weight: 700; lines: 1; color: if(ai.k == 0, #8b8778, if(ai.k == 1, #5f6368, if(ai.k == 2, #8a8a8a, if(ai.k == 3, #8f8f8f, if(ai.k == 5, #656d76, if(ai.k == 6, #9a9a9a, if(ai.k == 7, #a3a3a3, #b8a491))))))); show: not m.mine; family: "Inter" }
                        column {
                            show: m.mine
                            fill: if(ai.k == 0, #f0eee6, if(ai.k == 1, #e9eef6, if(ai.k == 2, #f1f1f1, if(ai.k == 3, #f4f4f4, if(ai.k == 5, #f6f8fa, if(ai.k == 6, #f2f2f2, if(ai.k == 7, #eff6ff, #f7c873))))))) if(ai.k == 4, 26%, 100%)
                            corner: 16
                            padding: 11
                            text m.body { width: min(m.w, ai.w * 0.8) - 22; lines: 80; size: 14.5; line_height: 1.4; color: if(ai.k == 0, #1f1e1d, if(ai.k == 1, #1f1f1f, if(ai.k == 2, #0d0d0d, if(ai.k == 3, #0d0d0d, if(ai.k == 5, #1f2328, if(ai.k == 6, #1a1a1a, if(ai.k == 7, #262626, #fff4e0))))))); family: "Inter"; selectable: true; selection: #5a463a }
                        }
                        column {
                            show: not m.mine
                            fill: #1b120d if(ai.k == 4, 60%, 0%)
                            corner: 16
                            padding: 11
                            text m.body { width: min(m.w, ai.w * 0.8) - 22; lines: 80; size: 14.5; line_height: 1.4; color: if(m.failed, #e5484d, if(ai.k == 0, #1f1e1d, if(ai.k == 1, #1f1f1f, if(ai.k == 2, #0d0d0d, if(ai.k == 3, #0d0d0d, if(ai.k == 5, #1f2328, if(ai.k == 6, #1a1a1a, if(ai.k == 7, #262626, #f5e8d8)))))))); family: "Inter"; selectable: true; selection: #5a463a }
                        }
                    }
                }
            }
        }
        on change ai_gen { talk.scroll: max(talk.content - talk.height, 0) ~280ms after 60ms }
        // a hair of a bar beside it, when there is more than shows
        box { from: card.w - 12, 58 + talk.scroll / max(talk.content, 1) * (ai.fy - 70); size: 3, (ai.fy - 70) * min(talk.height / max(talk.content, 1), 1); corner: 2; color: #f5e8d8; opacity: if(talk.content > talk.height + 1, 25%, 0) }
        // an empty conversation: who answers, and that it stays
        text ic_ai_spark { at: card.w / 2, 168; anchor: center; size: 34; color: #f7c873; opacity: 85%; show: aimsg.count == 0 and ai.k == 4; family: "tabler-icons" }
        text ai_empty { at: card.w / 2, 214; anchor: center; size: 22; weight: 700; color: #f5e8d8; width: ai.w - 40; lines: 1; align: center; show: aimsg.count == 0 and ai.k == 4; family: "Inter" }
        text ai_empty2 { at: card.w / 2, 246; anchor: center; size: 13.5; color: #b8a491; width: ai.w - 80; lines: 2; align: center; show: aimsg.count == 0 and ai.k == 4; family: "Inter" }
        measure greet_m
        // Claude: its mark beside a serif line
        image logo_claude { at: card.w / 2 - (greet_m.width + 52) / 2, 184; size: 40, 40; show: aimsg.count == 0 and ai.k == 0 }
        text ai_greet { at: card.w / 2 - (greet_m.width + 52) / 2 + 52, 204; anchor: left center; measure: greet_m; size: 36; color: if(ai.k == 0, #1f1e1d, if(ai.k == 1, #1f1f1f, if(ai.k == 2, #0d0d0d, if(ai.k == 3, #0d0d0d, if(ai.k == 5, #59636e, if(ai.k == 6, #1a1a1a, if(ai.k == 7, #262626, #f5e8d8))))))); show: aimsg.count == 0 and ai.k == 0; family: "Lora" }
        // Gemini and ChatGPT: a line in the middle
        text ai_greet { at: card.w / 2, 210; anchor: center; size: 32; color: if(ai.k == 0, #1f1e1d, if(ai.k == 1, #1f1f1f, if(ai.k == 2, #0d0d0d, if(ai.k == 3, #0d0d0d, if(ai.k == 5, #59636e, if(ai.k == 6, #1a1a1a, if(ai.k == 7, #262626, #f5e8d8))))))); show: aimsg.count == 0 and ai.k == 1; family: "Google Sans Flex" }
        text ai_greet { at: card.w / 2, 210; anchor: center; size: 24; weight: 500; color: if(ai.k == 0, #1f1e1d, if(ai.k == 1, #1f1f1f, if(ai.k == 2, #0d0d0d, if(ai.k == 3, #0d0d0d, if(ai.k == 5, #59636e, if(ai.k == 6, #1a1a1a, if(ai.k == 7, #262626, #f5e8d8))))))); show: aimsg.count == 0 and ai.k == 3; family: "Inter" }
        // Grok: its mark alone
        image logo_grok { at: card.w / 2 - 32, 170; size: 64, 64; show: aimsg.count == 0 and ai.k == 2 }
        // Mistral: its mark above a bold line, at the left
        image logo_mistral { at: 40, 120; size: 44, 44; show: aimsg.count == 0 and ai.k == 6 }
        text ai_greet { at: 40, 210; anchor: left center; size: 30; weight: 600; color: if(ai.k == 0, #1f1e1d, if(ai.k == 1, #1f1f1f, if(ai.k == 2, #0d0d0d, if(ai.k == 3, #0d0d0d, if(ai.k == 5, #59636e, if(ai.k == 6, #1a1a1a, if(ai.k == 7, #262626, #f5e8d8))))))); width: ai.w - 60; lines: 1; show: aimsg.count == 0 and ai.k == 6; family: "Inter" }
        // DeepSeek: its whale beside a bold line
        measure greet_d
        image logo_deepseek { at: card.w / 2 - (greet_d.width + 44) / 2, 192; size: 34, 34; show: aimsg.count == 0 and ai.k == 7 }
        text ai_greet { at: card.w / 2 - (greet_d.width + 44) / 2 + 44, 209; anchor: left center; measure: greet_d; size: 24; weight: 700; color: if(ai.k == 0, #1f1e1d, if(ai.k == 1, #1f1f1f, if(ai.k == 2, #0d0d0d, if(ai.k == 3, #0d0d0d, if(ai.k == 5, #59636e, if(ai.k == 6, #1a1a1a, if(ai.k == 7, #262626, #f5e8d8))))))); show: aimsg.count == 0 and ai.k == 7; family: "Inter" }
        // Copilot: its mark and a quiet note
        image logo_copilot { at: card.w / 2 - 26, 150; size: 52, 52; show: aimsg.count == 0 and ai.k == 5 }
        text ai_greet { at: card.w / 2, 226; anchor: center; size: 13; color: if(ai.k == 0, #1f1e1d, if(ai.k == 1, #1f1f1f, if(ai.k == 2, #0d0d0d, if(ai.k == 3, #0d0d0d, if(ai.k == 5, #59636e, if(ai.k == 6, #1a1a1a, if(ai.k == 7, #262626, #f5e8d8))))))); show: aimsg.count == 0 and ai.k == 5; family: "Inter" }
        // quick tasks for the AI on this computer, on what is written in the field or else on the clipboard
        row {
            at: card.w / 2 - (aiagent.count * 150 - 10) / 2, 290
            gap: 10
            show: aimsg.count == 0 and ai.k == 4          // LatteOS's own: the services' pages stay as they are
            for g in aiagent {
                group {
                    size: 140, 64
                    box { from: 0, 0; size: 140, 64; corner: 16; color: #1b120d; opacity: 45% + 25% * agent_hit.hover }
                    box { from: 0, 0; size: 140, 64; corner: 16; stroke: 1; color: #f7c873; opacity: 15% + 40% * agent_hit.hover }
                    text g.glyph { at: 70, 22; anchor: center; size: 18; color: #f7c873; family: "tabler-icons" }
                    text g.name { at: 70, 46; anchor: center; size: 12.5; weight: 600; color: #f5e8d8; width: 128; lines: 1; align: center; family: "Inter" }
                    zone box agent_hit { from: 0, 0; size: 140, 64; cursor: pointer; active: ai.on and not ai_wait; label: "{g.name}"; role: button }
                    on press agent_hit { emit ai_agent(g.index) }
                }
            }
        }

        // ── the field, a copy of the service's own: its colours, its shape, and what sits in it where it sits ──
        // what each has: + at the left (not Copilot, not DeepSeek: its paperclip is at the right); its chip — a model
        // or a way of thinking — at the right, or at the left for Copilot and DeepSeek (Claude's model and effort, which
        // it shows under its field, go in it); the microphone (Mistral's is its black button); and the button
        let fx.plus = pick(ai_style, 1, 1, 1, 1, 1, 0, 1, 0)
        let fx.chip = pick(ai_style, 1, 1, 1, 1, 1, 1, 1, 1)
        let fx.left = pick(ai_style, 0, 0, 0, 0, 0, 1, 0, 1)
        let fx.chipbg = pick(ai_style, 0, 0, 1, 0, 1, 0, 0, 1)
        let fx.chev = pick(ai_style, 0, 1, 1, 0, 1, 1, 0, 0)
        let fx.icon = pick(ai_style, 0, 0, 0, 1, 0, 1, 1, 1)
        let fx.mic = pick(ai_style, 1, 1, 1, 1, 1, 0, 0, 0)
        let fx.clip = pick(ai_style, 0, 0, 0, 0, 0, 0, 0, 1)
        let fx.sendbg = if(ai_typed or ai_wait, pick(ai_style, 1, 0, 1, 1, 1, 0, 1, 1), pick(ai_style, 0, 0, 1, 1, 1, 0, 1, 1))
        let fx.sendr = pick(ai_style, 9, 17, 17, 17, 17, 17, 9, 17)
        // the button's icon: the arrow; empty, Claude and ChatGPT show the voice wave, Mistral its microphone; Copilot a plane
        let fx.glyph = if(ai_wait, 4, if(ai.k == 5, 3, if(ai_typed, 0, pick(ai_style, 1, 0, 0, 1, 0, 3, 2, 0))))
        let fx.cw = pick(ai_style, 170, 150, 150, 150, 150, 150, 190, 150)
        let fx.cx = if(fx.left > 0, 30, card.w - 16 - 72 - 22 - fx.cw + if(fx.mic > 0, 0, 40))
        box { from: 16, f.top; size: ai.w, f.h; corner: f.round; color: if(ai.k == 0, #ffffff, if(ai.k == 1, #ffffff, if(ai.k == 2, #ffffff, if(ai.k == 3, #ffffff, if(ai.k == 5, #ffffff, if(ai.k == 6, #ffffff, if(ai.k == 7, #ffffff, #3d2c22))))))) }
        box { from: 16, f.top; size: ai.w, f.h; corner: f.round; stroke: if(ai.k == 5, 2, 1); color: if(ai.k == 0, #d9d6cf, if(ai.k == 1, #e8eaed, if(ai.k == 2, #e5e5e5, if(ai.k == 3, #e6e6e6, if(ai.k == 5, #0969da, if(ai.k == 6, #ececec, if(ai.k == 7, #e5e7eb, #5a463a))))))) }
        text ai_hint { at: if(ai.row > 0, 62, 36), if(ai.row > 0, f.cy, ai.fy + 26); anchor: left center; width: if(ai.row > 0, ai.w - 360, ai.w - 40); lines: 1; size: 15.5; color: if(ai.k == 0, #8b8778, if(ai.k == 1, #5f6368, if(ai.k == 2, #8a8a8a, if(ai.k == 3, #8f8f8f, if(ai.k == 5, #8c959f, if(ai.k == 6, #9a9a9a, if(ai.k == 7, #a3a3a3, #b8a491))))))); show: not ai_typed; family: "Inter" }
        // the press that puts the cursor in the field goes under the field itself, so the field is what is on top
        zone box ai_field_hit { from: if(ai.row > 0, 56, 16), f.top; size: if(ai.row > 0, ai.w - 340, ai.w), if(ai.row > 0, f.h, f.h - 40); cursor: text; active: ai.on; label: "{ai_hint}" }
        on press ai_field_hit { focus ai_q }
        input ai_q { at: if(ai.row > 0, 62, 36), if(ai.row > 0, f.cy - 10, ai.fy + 16); width: if(ai.row > 0, ai.w - 360, ai.w - 40); size: 15.5; color: if(ai.k == 0, #3d3929, if(ai.k == 1, #1f1f1f, if(ai.k == 2, #0d0d0d, if(ai.k == 3, #0d0d0d, if(ai.k == 5, #1f2328, if(ai.k == 6, #1a1a1a, if(ai.k == 7, #262626, #f5e8d8))))))); selection: if(ai.k == 4, #5a463a, #c9d7f0); family: "Inter"; label: "{ai_hint}" }
        // + : something to attach
        ellipse { at: 38, f.cy; radius: 15; color: if(ai.k == 0, #3d3929, if(ai.k == 1, #1f1f1f, if(ai.k == 2, #0d0d0d, if(ai.k == 3, #0d0d0d, if(ai.k == 5, #1f2328, if(ai.k == 6, #1a1a1a, if(ai.k == 7, #262626, #f5e8d8))))))); opacity: 8% * plus_hit.hover * fx.plus }
        text ic_ai_plus { at: 38, f.cy; anchor: center; size: 19; color: if(ai.k == 0, #3d3929, if(ai.k == 1, #1f1f1f, if(ai.k == 2, #0d0d0d, if(ai.k == 3, #0d0d0d, if(ai.k == 5, #59636e, if(ai.k == 6, #1a1a1a, if(ai.k == 7, #262626, #f5e8d8))))))); show: fx.plus > 0; family: "tabler-icons" }
        zone box plus_hit { at: if(fx.plus > 0, 38, card.w - 16 - 72), f.cy; size: 32, 32; cursor: pointer; active: ai.on and not ai_wait; label: "{ai_add_file}"; role: button }
        on press plus_hit { emit ai_open(2) }
        // DeepSeek's paperclip, where the others have the microphone
        text ic_ai_clip { at: card.w - 16 - 72, f.cy; anchor: center; size: 18; color: if(ai.k == 0, #3d3929, if(ai.k == 1, #1f1f1f, if(ai.k == 2, #0d0d0d, if(ai.k == 3, #0d0d0d, if(ai.k == 5, #59636e, if(ai.k == 6, #1a1a1a, if(ai.k == 7, #262626, #f5e8d8))))))); show: fx.clip > 0; family: "tabler-icons" }
        // what is attached, one chip with a cross: in the box's lower row, or above a one-line field
        box { from: if(ai.row > 0, 16, 60 + fx.left * 160), if(ai.row > 0, ai.fy + 2, f.cy - 13); size: 250, 26; corner: 13; color: #f7c873; opacity: if(ai_nfiles > 0, 30%, 0) }
        text ai_files { at: if(ai.row > 0, 30, 74 + fx.left * 160), if(ai.row > 0, ai.fy + 15, f.cy); anchor: left center; size: 12.5; weight: 600; color: if(ai.k == 4 or ai.row > 0, #f5e8d8, #3d3929); width: 200; lines: 1; show: ai_nfiles > 0; family: "Inter" }
        text ic_ai_x { at: if(ai.row > 0, 252, 296 + fx.left * 160), if(ai.row > 0, ai.fy + 15, f.cy); anchor: center; size: 14; color: if(ai.k == 4 or ai.row > 0, #f5e8d8, #3d3929); opacity: 60% + 40% * unattach_hit.hover; show: ai_nfiles > 0; family: "tabler-icons" }
        zone box unattach_hit { at: if(ai.row > 0, 252, 296 + fx.left * 160), if(ai.row > 0, ai.fy + 15, f.cy); size: 26, 26; cursor: pointer; active: ai.on and ai_nfiles > 0 and not ai_wait; label: "Remove"; role: button }
        on press unattach_hit { emit ai_unattach }
        // the service's own chip
        box { from: fx.cx, f.cy - 16; size: fx.cw, 32; corner: 16; color: if(ai.k == 0, #ffffff, if(ai.k == 1, #ffffff, if(ai.k == 2, #ececec, if(ai.k == 3, #ffffff, if(ai.k == 5, #ffffff, if(ai.k == 6, #ffffff, if(ai.k == 7, if(ai_think, #edf3fe, #ffffff), #4a372b))))))); opacity: if(fx.chip > 0, fx.chipbg * (85% + 15% * effort_chip.hover) + (1 - fx.chipbg) * 6% * effort_chip.hover, 0) }
        box { from: fx.cx, f.cy - 16; size: fx.cw, 32; corner: 16; stroke: 1; color: if(ai.k == 0, #ffffff, if(ai.k == 1, #ffffff, if(ai.k == 2, #ececec, if(ai.k == 3, #ffffff, if(ai.k == 5, #ffffff, if(ai.k == 6, #ffffff, if(ai.k == 7, if(ai_think, #c9dbfb, #e5e7eb), #4a372b))))))); opacity: if(ai.k == 7, 100%, 0) }
        text ic_ai_chipicon { at: fx.cx + 18, f.cy; anchor: center; size: 15; color: if(ai.k == 0, #3d3929, if(ai.k == 1, #1f1f1f, if(ai.k == 2, #0d0d0d, if(ai.k == 3, #5d5d5d, if(ai.k == 5, #1f2328, if(ai.k == 6, #1a1a1a, if(ai.k == 7, if(ai_think, #4d6bfe, #262626), #f5e8d8))))))); show: fx.chip > 0 and fx.icon > 0; family: "tabler-icons" }
        text ai_effort_word { at: fx.cx + if(fx.icon > 0, 32, 14), f.cy; anchor: left center; size: 13.5; weight: 600; color: if(ai.k == 0, #3d3929, if(ai.k == 1, #1f1f1f, if(ai.k == 2, #0d0d0d, if(ai.k == 3, #5d5d5d, if(ai.k == 5, #1f2328, if(ai.k == 6, #1a1a1a, if(ai.k == 7, if(ai_think, #4d6bfe, #262626), #f5e8d8))))))); width: fx.cw - 46; lines: 1; show: fx.chip > 0; family: "Inter" }
        text ic_ai_chev { at: fx.cx + fx.cw - 16, f.cy; anchor: center; size: 14; color: if(ai.k == 0, #3d3929, if(ai.k == 1, #1f1f1f, if(ai.k == 2, #0d0d0d, if(ai.k == 3, #5d5d5d, if(ai.k == 5, #1f2328, if(ai.k == 6, #1a1a1a, if(ai.k == 7, #4d6bfe, #f5e8d8))))))); show: fx.chip > 0 and fx.chev > 0; family: "tabler-icons" }
        zone box effort_chip { from: fx.cx, f.cy - 16; size: fx.cw, 32; cursor: pointer; active: ai.on and fx.chip > 0; label: "{ai_effort_word}"; role: button }
        on press effort_chip { emit ai_open(1) }
        // DeepSeek's second chip, smart search: its page's, so in the colour of what opens a page
        group {
            show: ai.k == 7
            box { from: fx.cx + fx.cw + 10, f.cy - 16; size: 200, 32; corner: 16; color: #f4f1ff; opacity: 60% * search_chip.hover }
            box { from: fx.cx + fx.cw + 10, f.cy - 16; size: 200, 32; corner: 16; stroke: 1; color: #e5e7eb }
            text ic_ai_world { at: fx.cx + fx.cw + 28, f.cy; anchor: center; size: 15; color: #6b4fd8; family: "tabler-icons" }
            text ai_search_word { at: fx.cx + fx.cw + 42, f.cy; anchor: left center; size: 13.5; weight: 600; color: #6b4fd8; width: 160; lines: 1; family: "Inter" }
            zone box search_chip { from: fx.cx + fx.cw + 10, f.cy - 16; size: 200, 32; cursor: pointer; active: ai.on and ai.k == 7; label: "{ai_search_word}"; role: button }
            on press search_chip { emit ai_open(3) }
        }
        // the microphone: red while it listens, blinking while it writes (Mistral's is its black button, at the right)
        ellipse { at: if(ai.k == 6, card.w - 16 - 30, card.w - 16 - 72), f.cy; radius: 16; color: if(ai_listening == 1, #e5484d, if(ai.k == 0, #3d3929, if(ai.k == 1, #1f1f1f, if(ai.k == 2, #0d0d0d, if(ai.k == 3, #0d0d0d, if(ai.k == 5, #1f2328, if(ai.k == 6, #1a1a1a, if(ai.k == 7, #262626, #f5e8d8)))))))); opacity: if(ai_listening == 1, 70% + 30% * sin(time * 300), 8% * mic_hit.hover) * if(fx.mic > 0 or ai.k == 6, 1, 0) }
        text ic_ai_mic { at: card.w - 16 - 72, f.cy; anchor: center; size: 18; color: if(ai_listening == 1, #ffffff, if(ai.k == 0, #3d3929, if(ai.k == 1, #1f1f1f, if(ai.k == 2, #0d0d0d, if(ai.k == 3, #0d0d0d, if(ai.k == 5, #59636e, if(ai.k == 6, #1a1a1a, if(ai.k == 7, #262626, #f5e8d8)))))))); opacity: if(ai_listening == 2, 50% + 50% * sin(time * 360), 100%); show: fx.mic > 0; family: "tabler-icons" }
        zone box mic_hit { at: card.w - 16 - 72, f.cy; size: 32, 32; cursor: pointer; active: ai.on and ai_listening < 2 and not ai_wait and fx.mic > 0; label: "{ai_mic_word}"; role: button }
        on press mic_hit { emit ai_mic }
        // send, as each of them draws it; while an answer comes, the same button stops it
        box { from: card.w - 16 - 30 - 17, f.cy - 17; size: 34, 34; corner: fx.sendr; color: if(ai_typed or ai_wait, if(ai.k == 0, #c96442, if(ai.k == 1, #ffffff, if(ai.k == 2, #1d9bf0, if(ai.k == 3, #0d0d0d, if(ai.k == 5, #ffffff, if(ai.k == 6, #1a1a1a, if(ai.k == 7, #4d6bfe, #f7c873))))))), if(ai.k == 0, #ffffff, if(ai.k == 1, #ffffff, if(ai.k == 2, #1d9bf0, if(ai.k == 3, #3b82f6, if(ai.k == 5, #ffffff, if(ai.k == 6, #1a1a1a, if(ai.k == 7, #b5c8fb, #f7c873)))))))); opacity: fx.sendbg * if(ai_wait, 55% + 45% * sin(time * 360), 100%) }
        text pick(fx.glyph, ic_ai_send, ic_ai_wave, ic_ai_mic, ic_ai_plane, ic_ai_stop) { at: card.w - 16 - 30, f.cy; anchor: center; size: 17; color: if(ai_typed or ai_wait, if(ai.k == 0, #ffffff, if(ai.k == 1, #1f1f1f, if(ai.k == 2, #ffffff, if(ai.k == 3, #ffffff, if(ai.k == 5, #59636e, if(ai.k == 6, #ffffff, if(ai.k == 7, #ffffff, #2a1e17))))))), if(ai.k == 0, #3d3929, if(ai.k == 1, #1f1f1f, if(ai.k == 2, #ffffff, if(ai.k == 3, #ffffff, if(ai.k == 5, #59636e, if(ai.k == 6, #ffffff, if(ai.k == 7, #ffffff, #2a1e17)))))))); opacity: if(ai.k == 1 and not ai_typed and not ai_wait, 0, 100%); family: "tabler-icons" }
        zone box send_hit { at: card.w - 16 - 30, f.cy; size: 36, 36; cursor: pointer; active: ai.on and (ai_typed or ai_wait or ai.k == 6); label: "{ai_send_word}"; role: button }
        on press send_hit while ai_wait { emit ai_stop }
        on press send_hit while not ai_wait and (ai_typed or ai.k != 6) { emit ai_send }
        on press send_hit while not ai_wait and not ai_typed and ai.k == 6 { emit ai_mic }
        on submit ai_q { emit ai_send }

        // ── on the coffee: the ways on, as icons that say their name under the pointer; and what is used ─────
        repeat k in 0..4 {
            let b.x = 34 + k * 44
            let b.hov = pick(k, center_hit.hover, settings_hit.hover, new_hit.hover, do_hit.hover)
            ellipse { at: b.x, 548; radius: 17; color: #f5e8d8; opacity: 8% + 12% * b.hov }
            text pick(k, ic_ai_center, ic_ai_settings, ic_ai_new, ic_ai_do) { at: b.x, 548; anchor: center; size: 17; color: #f7c873; family: "tabler-icons" }
            // its name, above it while the pointer is on it
            measure ai_tip.$k
            box { from: b.x - ai_tip.$k.width / 2 - 10, 506; size: ai_tip.$k.width + 20, 24; corner: 12; color: #f7c873; opacity: b.hov * 95% }
            text pick(k, ai_btn_center, ai_btn_settings, ai_btn_new, ai_btn_do) { at: b.x, 518; anchor: center; measure: ai_tip.$k; size: 12; weight: 600; color: #2a1e17; opacity: b.hov; family: "Inter" }
        }
        // who answers, and the model: the one part of the foot that stays when the AI is switched
        box { from: 192, 532; size: 170, 32; corner: 16; color: #f7c873; opacity: 16% + 14% * switch_hit.hover + 20% * if(ai_menu, 1, 0) }
        text ai_model { at: 206, 548; anchor: left center; size: 13; weight: 700; color: #f7c873; width: 126; lines: 1; family: "Inter" }
        text ic_ai_chev { at: 348, 548; anchor: center; size: 14; color: #f7c873; family: "tabler-icons" }
        zone box switch_hit { from: 192, 532; size: 170, 32; cursor: pointer; active: ai.on; label: "{ai_model}"; role: button }
        on press switch_hit { emit ai_open(0) }
        zone box center_hit { at: 34, 548; size: 38, 38; cursor: pointer; active: ai.on; label: "{ai_btn_center}"; role: button }
        zone box settings_hit { at: 78, 548; size: 38, 38; cursor: pointer; active: ai.on; label: "{ai_btn_settings}"; role: button }
        zone box new_hit { at: 122, 548; size: 38, 38; cursor: pointer; active: ai.on and not ai_wait; label: "{ai_btn_new}"; role: button }
        on press center_hit { emit ai_center }
        on press settings_hit { emit ai_settings }
        on press new_hit { emit ai_new }
        zone box do_hit { at: 166, 548; size: 38, 38; cursor: pointer; active: ai.on; label: "{ai_btn_do}"; role: button }
        on press do_hit { emit ai_do }

        // what is used: the service's own limits where it tells them (Claude: the five hours and the week), else the
        // window. Each a row of small squares lit from the left, green to yellow to red (inspo/grafy.png)
        let seg.x = 478
        let seg.n = 16
        let seg.step = (card.w - 16 - 92 - seg.x) / seg.n
        repeat u in 0..2 {
            let lim.y = 536 + u * 24
            let lim.v = pick(u, ai_l1, ai_l2)
            let lim.lit = round(clamp(lim.v, 0, 1) * seg.n)
            text pick(u, ai_lim1, ai_lim2) { at: 378, lim.y; anchor: left center; size: 11.5; weight: 700; color: if(lim.v > 0.85, #e5484d, #f7c873); width: seg.x - 384 + if(lim.v < 0, 400, 0); lines: 1; family: "Inter" }
            repeat q in 0..16 {
                box { from: seg.x + q * seg.step, lim.y - 4; size: seg.step - 2, 9; corner: 1.5
                      color: if((q + 0.5) / seg.n < 0.55, mix(#7bd88f, #f7c873, (q + 0.5) / seg.n / 0.55), mix(#f7c873, #e5484d, ((q + 0.5) / seg.n - 0.55) / 0.45))
                      opacity: if(lim.v < 0, 0, if(q < lim.lit, 100%, 12%)) }
            }
            text pick(u, ai_lim1p, ai_lim2p) { at: card.w - 16, lim.y; anchor: right center; size: 12; weight: 600; color: #f5e8d8; width: 88; lines: 1; align: right; family: "Inter" }
        }

        // ── the menu that is out: over the switch the services; over the field the service's own + or chip, as
        // the service draws it (its ground, ink, ticks; what opens its page in one colour for all); a row with more
        // opens another beside it. A press beside them puts them away
        group {
            show: ai_menu
            let m.x = if(ai_menu_at == 0, 192, if(ai_menu_at == 2, 16, clamp(fx.cx + fx.cw - m.w, 16, card.w - 16 - m.w)))
            let m.bot = if(ai_menu_at == 0, 524, f.top - 6)
            let m.top = m.bot - m.h
            zone box ai_menu_away { from: 0, 0; size: card.w, card.h; active: ai.on and ai_menu; label: "Close" }
            on press ai_menu_away { ai_menu = false; ai_sub = false }
            box { from: m.x, m.top; size: m.w, m.h; corner: pick(pm.k, 12, 20, 16, 16, 14, 12, 12, 12); color: if(pm.k == 4, #2a1e17, #ffffff) }
            box { from: m.x, m.top; size: m.w, m.h; corner: pick(pm.k, 12, 20, 16, 16, 14, 12, 12, 12); stroke: 1; color: if(pm.k == 0, #3d3929, if(pm.k == 1, #1f1f1f, if(pm.k == 2, #0d0d0d, if(pm.k == 3, #0d0d0d, if(pm.k == 5, #1f2328, if(pm.k == 6, #4a4a4a, if(pm.k == 7, #262626, #f5e8d8))))))); opacity: 10% }
            column {
                at: m.x + 6, m.top + 6
                for o in aipop {
                    group {
                        size: (m.w - 12), o.h
                        box { from: 8, 4; size: (m.w - 12) - 16, 1; color: if(pm.k == 0, #3d3929, if(pm.k == 1, #1f1f1f, if(pm.k == 2, #0d0d0d, if(pm.k == 3, #0d0d0d, if(pm.k == 5, #1f2328, if(pm.k == 6, #4a4a4a, if(pm.k == 7, #262626, #f5e8d8))))))); opacity: if(o.sep, 10%, 0) }
                        box { from: 0, if(o.sep, 9, 0) + 1; size: (m.w - 12), o.h - if(o.sep, 9, 0) - 2; corner: 8; color: if(pm.k == 0, #3d3929, if(pm.k == 1, #1f1f1f, if(pm.k == 2, #0d0d0d, if(pm.k == 3, #0d0d0d, if(pm.k == 5, #1f2328, if(pm.k == 6, #4a4a4a, if(pm.k == 7, #262626, #f5e8d8))))))); opacity: if(o.off, 0, 6% * pop_hit.hover) }
                        text o.glyph { at: 22, (if(o.sep, 9, 0) + if(o.d, 17, pm.rh / 2)); anchor: center; size: 16; color: if(o.web, if(pm.k == 4, #c3b1ff, #6b4fd8), if(pm.k == 0, #3d3929, if(pm.k == 1, #1f1f1f, if(pm.k == 2, #0d0d0d, if(pm.k == 3, #0d0d0d, if(pm.k == 5, #1f2328, if(pm.k == 6, #4a4a4a, if(pm.k == 7, #262626, #f5e8d8)))))))); show: o.g; family: "tabler-icons" }
                        text ic_ai_check { at: 22, (if(o.sep, 9, 0) + if(o.d, 17, pm.rh / 2)); anchor: center; size: 15; color: if(pm.k == 0, #2c84db, if(pm.k == 1, #1f1f1f, if(pm.k == 2, #0d0d0d, if(pm.k == 3, #0d0d0d, if(pm.k == 5, #1f2328, if(pm.k == 6, #fa500f, if(pm.k == 7, #4d6bfe, #f7c873))))))); show: o.on and pm.cl > 0; family: "tabler-icons" }
                        text o.name { at: if(o.g or pm.cl > 0, 44, 14), if(o.note, if(o.sep, 9, 0) + 20, (if(o.sep, 9, 0) + if(o.d, 17, pm.rh / 2))); anchor: left center; size: 13.5; weight: 500; color: if(o.off, if(pm.k == 0, #8b8778, if(pm.k == 1, #5f6368, if(pm.k == 2, #8a8a8a, if(pm.k == 3, #8f8f8f, if(pm.k == 5, #59636e, if(pm.k == 6, #9a9a9a, if(pm.k == 7, #a3a3a3, #b8a491))))))), if(o.web, if(pm.k == 4, #c3b1ff, #6b4fd8), if(o.on and pm.k == 4, #f7c873, if(pm.k == 0, #3d3929, if(pm.k == 1, #1f1f1f, if(pm.k == 2, #0d0d0d, if(pm.k == 3, #0d0d0d, if(pm.k == 5, #1f2328, if(pm.k == 6, #4a4a4a, if(pm.k == 7, #262626, #f5e8d8)))))))))); width: if(ai_pop_hx > 0, ai_pop_hx - if(o.g or pm.cl > 0, 44, 14) - 8, (m.w - 12) - if(o.g or pm.cl > 0, 44, 14) - 34); lines: 1; show: not o.note; family: "Inter" }
                        text o.name { at: 14, if(o.sep, 9, 0) + 20; anchor: left center; size: 11.5; color: if(pm.k == 0, #8b8778, if(pm.k == 1, #5f6368, if(pm.k == 2, #8a8a8a, if(pm.k == 3, #8f8f8f, if(pm.k == 5, #59636e, if(pm.k == 6, #9a9a9a, if(pm.k == 7, #a3a3a3, #b8a491))))))); width: (m.w - 12) - 28; lines: 2; show: o.note; family: "Inter" }
                        text o.hint { at: ai_pop_hx, (if(o.sep, 9, 0) + if(o.d, 17, pm.rh / 2)); anchor: left center; size: 12; color: if(pm.k == 0, #8b8778, if(pm.k == 1, #5f6368, if(pm.k == 2, #8a8a8a, if(pm.k == 3, #8f8f8f, if(pm.k == 5, #59636e, if(pm.k == 6, #9a9a9a, if(pm.k == 7, #a3a3a3, #b8a491))))))); width: (m.w - 12) - ai_pop_hx - 30; lines: 1; show: ai_pop_hx > 0; family: "Inter" }
                        text o.desc { at: if(o.g or pm.cl > 0, 44, 14), if(o.sep, 9, 0) + 35; anchor: left center; size: 12; color: if(pm.k == 0, #8b8778, if(pm.k == 1, #5f6368, if(pm.k == 2, #8a8a8a, if(pm.k == 3, #8f8f8f, if(pm.k == 5, #59636e, if(pm.k == 6, #9a9a9a, if(pm.k == 7, #a3a3a3, #b8a491))))))); width: (m.w - 12) - if(o.g or pm.cl > 0, 44, 14) - 40; lines: 1; show: o.d; family: "Inter" }
                        text o.key { at: (m.w - 12) - if(o.more or o.on or o.web, 34, 14), (if(o.sep, 9, 0) + if(o.d, 17, pm.rh / 2)); anchor: right center; size: 12; color: if(o.web, if(pm.k == 4, #c3b1ff, #6b4fd8), if(pm.k == 0, #8b8778, if(pm.k == 1, #5f6368, if(pm.k == 2, #8a8a8a, if(pm.k == 3, #8f8f8f, if(pm.k == 5, #59636e, if(pm.k == 6, #9a9a9a, if(pm.k == 7, #a3a3a3, #b8a491)))))))); width: 120; lines: 1; align: right; family: "Inter" }
                        text ic_ai_more { at: (m.w - 12) - 18, (if(o.sep, 9, 0) + if(o.d, 17, pm.rh / 2)); anchor: center; size: 14; color: if(o.web, if(pm.k == 4, #c3b1ff, #6b4fd8), if(pm.k == 0, #8b8778, if(pm.k == 1, #5f6368, if(pm.k == 2, #8a8a8a, if(pm.k == 3, #8f8f8f, if(pm.k == 5, #59636e, if(pm.k == 6, #9a9a9a, if(pm.k == 7, #a3a3a3, #b8a491)))))))); show: o.more; family: "tabler-icons" }
                        text ic_ai_web { at: (m.w - 12) - 18, (if(o.sep, 9, 0) + if(o.d, 17, pm.rh / 2)); anchor: center; size: 12; color: if(pm.k == 4, #c3b1ff, #6b4fd8); show: o.web and not o.more; family: "tabler-icons" }
                        text ic_ai_check { at: (m.w - 12) - 18, (if(o.sep, 9, 0) + if(o.d, 17, pm.rh / 2)); anchor: center; size: 15; color: if(pm.k == 0, #2c84db, if(pm.k == 1, #1f1f1f, if(pm.k == 2, #0d0d0d, if(pm.k == 3, #0d0d0d, if(pm.k == 5, #1f2328, if(pm.k == 6, #fa500f, if(pm.k == 7, #4d6bfe, #f7c873))))))); show: o.on and pm.cl == 0 and pm.radio == 0; family: "tabler-icons" }
                        ellipse { at: (m.w - 12) - 18, (if(o.sep, 9, 0) + if(o.d, 17, pm.rh / 2)); radius: 7; stroke: if(o.on, 4, 1); color: if(o.on, #fa500f, #c8c8c8); opacity: if(pm.radio > 0 and not o.note and not o.web or pm.radio > 0 and o.web, 100%, 0) }
                        zone box pop_hit { from: 0, if(o.sep, 9, 0); size: (m.w - 12), o.h - if(o.sep, 9, 0); cursor: pointer; active: ai.on and ai_menu and not o.off; label: "{o.name}"; selected: o.on; role: item }
                        on press pop_hit { emit ai_pop(o.index) }
                    }
                }
            }
            group {
                show: ai_sub
                let s.x = if(m.x + m.w + 4 + ai_sub_w <= card.w - 8, m.x + m.w + 4, max(8, m.x - ai_sub_w - 4))
                let s.top = min(m.top + ai_sub_y, m.bot - ai_sub_h - 12)
                box { from: s.x, s.top; size: ai_sub_w, ai_sub_h + 12; corner: pick(pm.k, 12, 20, 16, 16, 14, 12, 12, 12); color: if(pm.k == 4, #2a1e17, #ffffff) }
                box { from: s.x, s.top; size: ai_sub_w, ai_sub_h + 12; corner: pick(pm.k, 12, 20, 16, 16, 14, 12, 12, 12); stroke: 1; color: if(pm.k == 0, #3d3929, if(pm.k == 1, #1f1f1f, if(pm.k == 2, #0d0d0d, if(pm.k == 3, #0d0d0d, if(pm.k == 5, #1f2328, if(pm.k == 6, #4a4a4a, if(pm.k == 7, #262626, #f5e8d8))))))); opacity: 10% }
                column {
                    at: s.x + 6, s.top + 6
                for x in aisub {
                    group {
                        size: (ai_sub_w - 12), x.h
                        box { from: 8, 4; size: (ai_sub_w - 12) - 16, 1; color: if(pm.k == 0, #3d3929, if(pm.k == 1, #1f1f1f, if(pm.k == 2, #0d0d0d, if(pm.k == 3, #0d0d0d, if(pm.k == 5, #1f2328, if(pm.k == 6, #4a4a4a, if(pm.k == 7, #262626, #f5e8d8))))))); opacity: if(x.sep, 10%, 0) }
                        box { from: 0, if(x.sep, 9, 0) + 1; size: (ai_sub_w - 12), x.h - if(x.sep, 9, 0) - 2; corner: 8; color: if(pm.k == 0, #3d3929, if(pm.k == 1, #1f1f1f, if(pm.k == 2, #0d0d0d, if(pm.k == 3, #0d0d0d, if(pm.k == 5, #1f2328, if(pm.k == 6, #4a4a4a, if(pm.k == 7, #262626, #f5e8d8))))))); opacity: if(x.off, 0, 6% * sub_hit.hover) }
                        text x.glyph { at: 22, (if(x.sep, 9, 0) + if(x.d, 17, pm.rh / 2)); anchor: center; size: 16; color: if(x.web, if(pm.k == 4, #c3b1ff, #6b4fd8), if(pm.k == 0, #3d3929, if(pm.k == 1, #1f1f1f, if(pm.k == 2, #0d0d0d, if(pm.k == 3, #0d0d0d, if(pm.k == 5, #1f2328, if(pm.k == 6, #4a4a4a, if(pm.k == 7, #262626, #f5e8d8)))))))); show: x.g; family: "tabler-icons" }
                        text ic_ai_check { at: 22, (if(x.sep, 9, 0) + if(x.d, 17, pm.rh / 2)); anchor: center; size: 15; color: if(pm.k == 0, #2c84db, if(pm.k == 1, #1f1f1f, if(pm.k == 2, #0d0d0d, if(pm.k == 3, #0d0d0d, if(pm.k == 5, #1f2328, if(pm.k == 6, #fa500f, if(pm.k == 7, #4d6bfe, #f7c873))))))); show: x.on and pm.cl > 0; family: "tabler-icons" }
                        text x.name { at: if(x.g or pm.cl > 0, 44, 14), if(x.note, if(x.sep, 9, 0) + 20, (if(x.sep, 9, 0) + if(x.d, 17, pm.rh / 2))); anchor: left center; size: 13.5; weight: 500; color: if(x.off, if(pm.k == 0, #8b8778, if(pm.k == 1, #5f6368, if(pm.k == 2, #8a8a8a, if(pm.k == 3, #8f8f8f, if(pm.k == 5, #59636e, if(pm.k == 6, #9a9a9a, if(pm.k == 7, #a3a3a3, #b8a491))))))), if(x.web, if(pm.k == 4, #c3b1ff, #6b4fd8), if(x.on and pm.k == 4, #f7c873, if(pm.k == 0, #3d3929, if(pm.k == 1, #1f1f1f, if(pm.k == 2, #0d0d0d, if(pm.k == 3, #0d0d0d, if(pm.k == 5, #1f2328, if(pm.k == 6, #4a4a4a, if(pm.k == 7, #262626, #f5e8d8)))))))))); width: if(ai_pop_hx > 0, ai_pop_hx - if(x.g or pm.cl > 0, 44, 14) - 8, (ai_sub_w - 12) - if(x.g or pm.cl > 0, 44, 14) - 34); lines: 1; show: not x.note; family: "Inter" }
                        text x.name { at: 14, if(x.sep, 9, 0) + 20; anchor: left center; size: 11.5; color: if(pm.k == 0, #8b8778, if(pm.k == 1, #5f6368, if(pm.k == 2, #8a8a8a, if(pm.k == 3, #8f8f8f, if(pm.k == 5, #59636e, if(pm.k == 6, #9a9a9a, if(pm.k == 7, #a3a3a3, #b8a491))))))); width: (ai_sub_w - 12) - 28; lines: 2; show: x.note; family: "Inter" }
                        text x.hint { at: ai_pop_hx, (if(x.sep, 9, 0) + if(x.d, 17, pm.rh / 2)); anchor: left center; size: 12; color: if(pm.k == 0, #8b8778, if(pm.k == 1, #5f6368, if(pm.k == 2, #8a8a8a, if(pm.k == 3, #8f8f8f, if(pm.k == 5, #59636e, if(pm.k == 6, #9a9a9a, if(pm.k == 7, #a3a3a3, #b8a491))))))); width: (ai_sub_w - 12) - ai_pop_hx - 30; lines: 1; show: ai_pop_hx > 0; family: "Inter" }
                        text x.desc { at: if(x.g or pm.cl > 0, 44, 14), if(x.sep, 9, 0) + 35; anchor: left center; size: 12; color: if(pm.k == 0, #8b8778, if(pm.k == 1, #5f6368, if(pm.k == 2, #8a8a8a, if(pm.k == 3, #8f8f8f, if(pm.k == 5, #59636e, if(pm.k == 6, #9a9a9a, if(pm.k == 7, #a3a3a3, #b8a491))))))); width: (ai_sub_w - 12) - if(x.g or pm.cl > 0, 44, 14) - 40; lines: 1; show: x.d; family: "Inter" }
                        text x.key { at: (ai_sub_w - 12) - if(x.more or x.on or x.web, 34, 14), (if(x.sep, 9, 0) + if(x.d, 17, pm.rh / 2)); anchor: right center; size: 12; color: if(x.web, if(pm.k == 4, #c3b1ff, #6b4fd8), if(pm.k == 0, #8b8778, if(pm.k == 1, #5f6368, if(pm.k == 2, #8a8a8a, if(pm.k == 3, #8f8f8f, if(pm.k == 5, #59636e, if(pm.k == 6, #9a9a9a, if(pm.k == 7, #a3a3a3, #b8a491)))))))); width: 120; lines: 1; align: right; family: "Inter" }
                        text ic_ai_more { at: (ai_sub_w - 12) - 18, (if(x.sep, 9, 0) + if(x.d, 17, pm.rh / 2)); anchor: center; size: 14; color: if(x.web, if(pm.k == 4, #c3b1ff, #6b4fd8), if(pm.k == 0, #8b8778, if(pm.k == 1, #5f6368, if(pm.k == 2, #8a8a8a, if(pm.k == 3, #8f8f8f, if(pm.k == 5, #59636e, if(pm.k == 6, #9a9a9a, if(pm.k == 7, #a3a3a3, #b8a491)))))))); show: x.more; family: "tabler-icons" }
                        text ic_ai_web { at: (ai_sub_w - 12) - 18, (if(x.sep, 9, 0) + if(x.d, 17, pm.rh / 2)); anchor: center; size: 12; color: if(pm.k == 4, #c3b1ff, #6b4fd8); show: x.web and not x.more; family: "tabler-icons" }
                        text ic_ai_check { at: (ai_sub_w - 12) - 18, (if(x.sep, 9, 0) + if(x.d, 17, pm.rh / 2)); anchor: center; size: 15; color: if(pm.k == 0, #2c84db, if(pm.k == 1, #1f1f1f, if(pm.k == 2, #0d0d0d, if(pm.k == 3, #0d0d0d, if(pm.k == 5, #1f2328, if(pm.k == 6, #fa500f, if(pm.k == 7, #4d6bfe, #f7c873))))))); show: x.on and pm.cl == 0 and pm.radio == 0; family: "tabler-icons" }
                        ellipse { at: (ai_sub_w - 12) - 18, (if(x.sep, 9, 0) + if(x.d, 17, pm.rh / 2)); radius: 7; stroke: if(x.on, 4, 1); color: if(x.on, #fa500f, #c8c8c8); opacity: if(pm.radio > 0 and not x.note and not x.web or pm.radio > 0 and x.web, 100%, 0) }
                        zone box sub_hit { from: 0, if(x.sep, 9, 0); size: (ai_sub_w - 12), x.h - if(x.sep, 9, 0); cursor: pointer; active: ai.on and ai_menu and not x.off; label: "{x.name}"; selected: x.on; role: item }
                        on press sub_hit { emit ai_subpick(x.index) }
                    }
                }
                }
            }
        }
    }
    on key Escape while ai_menu { ai_menu = false; ai_sub = false }
}
