// LatteOS GOO: the shell of the desktop. Where a taskbar, a Start button and a clock would be there are drops
// of coffee on the edges of the screen, all of one goo.
//
// The scene is one rule for every drop: a drop is a record the logic fills (lib/engine.luau), and what makes
// two drops differ is the numbers in it. The scene moves and paints them; the logic decides what a press
// does. It covers the whole screen, because a drop may be anywhere; only the zones take the mouse.
//
// Its parts, in the order they are painted:
//   drops    what a drop is: its record, how it moves, what the mouse does to it
//   picks    (written by gen.py) the one drop a card grows from
//   body     the goo: every drop and the edge as one body; shapes.plm in it is written by gen.py
//   card     the card's state and its frame
//   faces    what each drop shows on itself
//   strip    the performance strip in PowerGoo's capsule
//   keys     Goo from the keyboard: the keys, and the mark on the drop chosen
//   rows     what is in the card, and the tooltip
//   lock     the lock screen, a surface of its own
language 0.4
import "lang/sk.plm"

scene Goo {
    surface {
        size: full, full
        anchor: bottom
        margin: 0
        level: top
        reserve: -1
        rate: 60
        // An open card is a menu: it has the keyboard until a press elsewhere, so Escape closes it at once
        // and its field is typed into without a press. So has Goo while it is walked with the arrow keys.
        keyboard: exclusive while card_open or kb
    }
    permissions {
        run: "latte-sky", "latte-login", "latte-stats", "hyprctl", "foot", "hostname", "powerprofilesctl", "date", "notify-send", "nmcli", "xdg-open", "xdg-user-dir", "fd", "latte-say"
        services: "files", "files.write", "env", "clock", "battery", "window", "apps", "apps.launch", "session.*", "auth", "notifications", "notifications.*", "sound", "audio", "audio.*", "brightness", "brightness.*", "network", "network.*", "bluetooth", "bluetooth.*", "tray", "tray.*", "polkit", "polkit.*", "clipboard.set"
    }

    // ── what the desktop around the scene tells it (`pleamar --say goo "emit …"`) ───────────────────────────
    event window_mode ->                       // Hyprland: how windows are arranged now: 0 tape, 1 tiles, 2 floating
    event win_menu ->                          // the right button on a window's title: the menu of the window `win_asked`
    text win_asked = ""
    event lens_toggle ->                       // the Windows key: the launcher, open or shut
    event lens_mode ->                         // …or open in one of its modes: 0 apps, 1 files, 2 the web, 3 a command
    event clock_notes ->                       // Win+N: notifications and the calendar
    event clock_time ->                        // Win+Alt+D: the time card
    event quick_toggle ->                      // Win+A: the quick settings

    include "parts/drops.plm"
    include "parts/picks.plm"
    include "parts/body.plm"
    include "parts/card.plm"
    include "parts/faces.plm"
    include "parts/strip.plm"
    include "parts/keys.plm"
    include "parts/rows.plm"
    include "parts/lock.plm"
}
