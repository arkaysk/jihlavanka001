// The login screen.
//
// It starts as the boot splash ends: the same cup in the same place on the same background. A drop of coffee
// leaps out of the cup, bounces twice, rolls aside and leaves the login row behind it. Then the whole plane
// sinks to the surface of the coffee that fills the lower third of the screen. Under the surface is the last
// crash, or the news; left alone for a minute, small goo come up with what else is worth knowing.
//
// Only the power drop and the row can be pressed. Everything that moves is moved here, by the renderer: the
// logic (login.luau) says when the intro may start, fills in the facts and checks the password.
language 0.3
import "lang/sk.plm"

scene Login {
    surface {
        size: full, full
        anchor: top
        margin: 0
        level: overlay
        reserve: -1
        rate: 60
        keyboard: exclusive
        // A copy per monitor, each laid out for its own size; facts and texts are shared, so what is typed
        // shows on all of them. One of the monitors may be a virtual one nobody is looking at.
        screens: each max 3
    }
    permissions {
        run: "latte-login", "date", "systemctl"
        services: "env", "clock"
    }

    shader water = file "shaders/water.wgsl"
    shader crest = file "shaders/crest.wgsl"
    shader sea = file "shaders/sea.wgsl"

    let GREET_W = screen.width
    let GREET_H = screen.height
    include "parts/greet.plm"
}
