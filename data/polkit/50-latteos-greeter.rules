// Napájacie voľby prihlasovacej obrazovky LatteOS (src/latte_greeter/power.py).
// Greeter beží ako používateľ greetd a smie len toto:
//   - vypnúť a reštartovať počítač (aj keď je prihlásený niekto iný; greeter si
//     pred tým vypýta potvrdenie),
//   - reštartovať greetd (voľba "Reštartovať LatteOS"),
//   - prepnúť do multi-user.target (voľba "Ukončiť do konzoly").
// Inštaluje tools/install-greeter.sh do /etc/polkit-1/rules.d/.
polkit.addRule(function(action, subject) {
    if (subject.user !== "greetd")
        return polkit.Result.NOT_HANDLED;

    var power = [
        "org.freedesktop.login1.power-off",
        "org.freedesktop.login1.power-off-multiple-sessions",
        "org.freedesktop.login1.reboot",
        "org.freedesktop.login1.reboot-multiple-sessions"
    ];
    if (power.indexOf(action.id) >= 0)
        return polkit.Result.YES;

    if (action.id === "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        var verb = action.lookup("verb");
        if (unit === "greetd.service" && verb === "restart")
            return polkit.Result.YES;
        // `systemctl isolate` sa pre polkit hlási ako "start" jednotky (pre istotu aj "isolate")
        if (unit === "multi-user.target" && (verb === "start" || verb === "isolate"))
            return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
