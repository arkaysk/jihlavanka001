// Iba DEV build. Voľba "Vypnúť" v systémovom manažéri LatteOS (session/latteos-logout --console)
// prepne počítač do textového režimu (systemctl isolate multi-user.target) bez hesla.
// Používateľ zo skupiny wheel to smie aj so sudo; toto len vynecháva heslo pri tejto jedinej
// akcii. Pomocník beží ako user služba mimo relácie, preto sa nedá spoliehať na "aktívny lokálny".
// Pre vydanie tento súbor nenainštalovať (tools/install-greeter.sh ho dáva len v dev buildu).
// Bez neho lišta "Vypnúť" odmietne (ukáže, že chýba pravidlo), aby sa omylom neukázalo prihlasovanie.
// Pri neúspechu v poslednom kroku pomocníka to zapíše journalctl -t latteos-logout.
polkit.addRule(function(action, subject) {
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        subject.isInGroup("wheel") &&
        action.lookup("unit") === "multi-user.target")
        return polkit.Result.YES;
    return polkit.Result.NOT_HANDLED;
});
