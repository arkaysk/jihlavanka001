#!/bin/sh
# Diagnostika poslednej relácie LatteOS (bod 2b.5; neskôr latte-diagd, bod 8.8).
#   latteos-diag          stav poslednej relácie, posledné riadky z journalu, pád jadra
#   latteos-diag notice   jednoriadkový oznam, len ak posledná relácia nedopadla dobre
# Záznam píše session/latteos-session.
USER_NAME=$(id -un)
USER_FILE=${XDG_STATE_HOME:-$HOME/.local/state}/latteos/last-exit
SHARED_FILE=${LATTEOS_STATE_DIR:-/var/lib/latteos/last-exit}/$USER_NAME

TIME= KIND= STATUS= SIGNAL= UPTIME=
for file in "$USER_FILE" "$SHARED_FILE"; do
    [ -r "$file" ] || continue
    # záznam sa nečíta cez `.`, aby sa z neho nespustilo nič
    while IFS== read -r key value; do
        case $key in
            TIME) TIME=$value ;;
            KIND) KIND=$value ;;
            STATUS) STATUS=$value ;;
            SIGNAL) SIGNAL=$value ;;
            UPTIME) UPTIME=$value ;;
        esac
    done <"$file"
    break
done

when=
[ -n "$TIME" ] && when=$(date -d "@$TIME" '+%-d. %-m. %H:%M' 2>/dev/null)

case $KIND in
    crash) what="spadla" ;;
    killed) what="bola zabitá" ;;
    missing) what="sa nespustila" ;;
    error) what="skončila chybou" ;;
    normal) what="skončila v poriadku" ;;
    *) what="" ;;
esac
detail="labwc"
[ "$KIND" = missing ] && detail="labwc sa nenašiel alebo sa nedá spustiť"
[ -n "$SIGNAL" ] && detail="$detail, signál $SIGNAL"
[ -n "$STATUS" ] && [ -z "$SIGNAL" ] && detail="$detail, kód $STATUS"
[ -n "$UPTIME" ] && detail="$detail, bežal $UPTIME s"

case $1 in
    notice)
        case $KIND in
            ""|normal) exit 0 ;;
        esac
        echo "LatteOS: posledná relácia $what ($detail, $when). Diagnostika: latteos-diag"
        ;;
    "")
        if [ -z "$what" ]; then
            echo "Zatiaľ nie je záznam o žiadnej relácii."
        else
            echo "Posledná relácia $what ($detail, $when)."
        fi
        echo
        echo "--- journal (latteos-session, labwc), tento štart systému"
        journalctl -b --no-pager -n 40 -t latteos-session -t labwc 2>&1 || true
        if [ "$KIND" = crash ] && command -v coredumpctl >/dev/null 2>&1; then
            echo
            echo "--- pád jadra (coredumpctl)"
            coredumpctl list --no-pager labwc 2>&1 | tail -n 3
            echo "Podrobnosti: coredumpctl info labwc"
        fi
        echo
        echo "Všetky chyby od štartu: journalctl -b -p err"
        ;;
    *)
        echo "použitie: latteos-diag [notice]" >&2
        exit 2
        ;;
esac
