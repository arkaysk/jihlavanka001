<?xml version="1.0"?>
<labwc_config>
  <keyboard>
    <default />
    <!-- Vývoj: Ctrl+Alt+Backspace ukončí labwc a vráti prihlasovaciu obrazovku
         (z nej sa dá vstúpiť do konzoly, viď session/latteos-console). -->
    <keybind key="C-A-BackSpace">
      <action name="Exit" />
    </keybind>
  </keyboard>
  <!-- Téma s ikonami tlačidiel okien generuje latte-appearance (~/.local/share/themes/LatteOS/labwc),
       farby sú v themerc-override. -->
  <theme>
    <name>LatteOS</name>
  </theme>
</labwc_config>
