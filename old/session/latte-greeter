#!/bin/sh
# Spúšťa prihlasovaciu obrazovku pod greetd (labwc -S latte-greeter). Ak latte-greeter
# spadne, nastúpi gtkgreet, aby sa dalo prihlásiť a chybu opraviť.
# Nainštaluje ho tools/install-greeter.sh do /usr/local/bin.
LIB=${LATTEOS_LIB:-/usr/local/lib/latteos}

# Kompozitor bez EDID (virtuálna grafika) začína na 640 × 480. Pred greeterom nastavíme najvyššie
# bezpečné rozlíšenie; používateľovo rozlíšenie sa použije až v jeho relácii (labwc/autostart).
# Zlyhanie prihlásenie nikdy nezdrží.
if [ -f "$LIB/latte_devices/app.py" ]; then
    python3 "$LIB/latte_devices/app.py" display safe 2>&1 | logger -t latte-greeter -p user.warning
fi

python3 "$LIB/latte_greeter/app.py" "$@"
status=$?
[ "$status" -eq 0 ] && exit 0
logger -t latte-greeter -p user.err "latte-greeter skončil s kódom $status, spúšťam gtkgreet"
exec gtkgreet -l
