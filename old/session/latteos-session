#!/bin/sh
# Vstup do relácie LatteOS. Spúšťa ho prihlasovací manažér (latteos.desktop)
# alebo ručne z konzoly. Nastaví premenné relácie a spustí labwc; komponenty
# potom spustí systemd (labwc/autostart -> latte-session.target).
#
# Ako labwc skončil, sa zapíše (bod 2b.5):
#   - do journalu: `journalctl LATTEOS_KIND=crash`, alebo latteos-diag;
#   - do záznamu pre latteos-diag (~/.local/state/latteos/last-exit);
#   - pri probléme aj do /var/lib/latteos/last-exit/<používateľ>, odkiaľ ho vezme
#     prihlasovacia obrazovka a ukáže pri páde. Riadne ukončenie nezobrazuje nič.
#
# LD_PRELOAD pre layer-shell tu zámerne nie je: patrí len lište
# (tools/run-shell.sh), inak by sa nahrával do každej aplikácie.
# GSK_RENDERER a nastavenia kurzora sú v labwc/environment.
export XDG_CURRENT_DESKTOP=LatteOS
export XDG_SESSION_DESKTOP=LatteOS
export XDG_SESSION_TYPE=wayland

USER_NAME=$(id -un)
SHARED_FILE=${LATTEOS_STATE_DIR:-/var/lib/latteos/last-exit}/$USER_NAME
USER_FILE=${XDG_STATE_HOME:-$HOME/.local/state}/latteos/last-exit

# Zapíše záznam (dočasný súbor + premenovanie, aby ho greeter nikdy nečítal napoly).
write_record() {
    dir=$(dirname "$1")
    [ -d "$dir" ] || mkdir -p "$dir" 2>/dev/null || return 1
    tmp="$1.$$"
    if printf 'TIME=%s\nKIND=%s\nSTATUS=%s\nSIGNAL=%s\nUPTIME=%s\nCOMPONENT=labwc\n' \
        "$ended" "$kind" "$status" "$signal" "$uptime" >"$tmp" 2>/dev/null \
        && chmod 644 "$tmp" && mv -f "$tmp" "$1" 2>/dev/null; then
        return 0
    fi
    rm -f "$tmp"
    return 1
}

# Predchádzajúci pád už greeter ukázal; nová relácia ho zrušila.
rm -f "$SHARED_FILE"

started=$(date +%s)
if command -v systemd-cat >/dev/null 2>&1; then
    # log labwc ide do journalu (systemd-cat spustí príkaz a vráti jeho kód)
    systemd-cat -t labwc labwc "$@"
else
    labwc "$@"
fi
status=$?
ended=$(date +%s)
uptime=$((ended - started))

# Druh skončenia: normal (0 a signály, ktorými sa relácia končí zvonku),
# error (chybový kód), crash (SEGV, ABRT, ...), killed (KILL, často OOM),
# missing (labwc sa nedá spustiť).
signal=""
case $status in
    0) kind=normal ;;
    126|127) kind=missing ;;
    *)
        if [ "$status" -gt 128 ]; then
            signal=$(kill -l "$status" 2>/dev/null)
            case $signal in
                TERM|HUP|INT|PIPE) kind=normal ;;
                KILL) kind=killed ;;
                *) kind=crash ;;
            esac
        else
            kind=error
        fi
        ;;
esac

if [ "$kind" = normal ]; then priority=6; else priority=3; fi
message="labwc skončil: $kind, kód $status${signal:+, signál $signal}, bežal ${uptime} s"
printf 'MESSAGE=%s\nPRIORITY=%s\nSYSLOG_IDENTIFIER=latteos-session\nLATTEOS_KIND=%s\nLATTEOS_EXIT=%s\nLATTEOS_SIGNAL=%s\nLATTEOS_UPTIME=%s\n' \
    "$message" "$priority" "$kind" "$status" "$signal" "$uptime" | logger --journald 2>/dev/null \
    || logger -t latteos-session -p "user.$([ "$priority" = 3 ] && echo err || echo info)" "$message"

write_record "$USER_FILE"
if [ "$kind" != normal ]; then
    write_record "$SHARED_FILE"
    # Pri ručnom spustení z konzoly je to prvé, čo používateľ uvidí.
    command -v latteos-diag >/dev/null 2>&1 && latteos-diag notice >&2
fi

# Po skončení kompozitora zastaviť komponenty, inak by ich systemd
# reštartoval do prázdna, a zabudnúť premenné tejto relácie.
# Zoznam premenných musí sedieť s labwc/autostart.
systemctl --user stop latte-session.target
systemctl --user unset-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP \
    XDG_SESSION_DESKTOP XDG_SESSION_TYPE XDG_SESSION_ID LABWC_PID GSK_RENDERER XCURSOR_THEME XCURSOR_SIZE
exit $status
